{
  "framework": "astro",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<vhost>.+)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "motytools-web.vercel.app"
        }
      ],
      "destination": "https://motytools.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.motytools.com"
        }
      ],
      "destination": "https://motytools.com/$1",
      "permanent": true
    },
    {
      "source": "/memomail/lp",
      "destination": "/memomail/",
      "permanent": false
    },
    {
      "source": "/memomail/lp/",
      "destination": "/memomail/",
      "permanent": false
    },
    {
      "source": "/uchino-hachu",
      "destination": "/reptile-sns/",
      "permanent": false
    },
    {
      "source": "/uchino-hachu/",
      "destination": "/reptile-sns/",
      "permanent": false
    },
    {
      "source": "/uchino-hachu/privacy",
      "destination": "/reptile-sns/privacy/",
      "permanent": false
    },
    {
      "source": "/uchino-hachu/privacy/",
      "destination": "/reptile-sns/privacy/",
      "permanent": false
    },
    {
      "source": "/uchino-hachu/terms",
      "destination": "https://www.apple.com/legal/internet-services/itunes/dev/stdeula/",
      "permanent": false
    },
    {
      "source": "/uchino-hachu/terms/",
      "destination": "https://www.apple.com/legal/internet-services/itunes/dev/stdeula/",
      "permanent": false
    },
    {
      "source": "/uchino-hachu/a/:id",
      "destination": "/reptile-sns/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy/pitto-kigen",
      "destination": "/privacy/pitto-kigen.html"
    },
    {
      "source": "/support/pitto-kigen",
      "destination": "/support/pitto-kigen.html"
    },
    {
      "source": "/support/pitto-hosho",
      "destination": "/support/pitto-hosho.html"
    },
    {
      "source": "/reptile-sns/p/:id",
      "destination": "/api/reptile-post?id=:id"
    },
    {
      "source": "/uchino-hachu/guidelines",
      "destination": "/reptile-sns/guidelines/index.html"
    },
    {
      "source": "/uchino-hachu/guidelines/",
      "destination": "/reptile-sns/guidelines/index.html"
    }
  ]
}
