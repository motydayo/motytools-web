---
import BaseLayout from '../../layouts/BaseLayout.astro';
import UgCard from '../../components/ugoki/UgCard.astro';
import CopyButton from '../../components/ugoki/CopyButton.astro';
import { SITE } from '../../config';
import { UGOKI, CATEGORIES } from '../../data/ugoki';

const total = UGOKI.length;
const title = `Webサイトの動き・演出の名前一覧${total}種｜動く見本とAIへの頼み方`;
const description = `追従ヘッダー・ピン留め・パララックス・マーキーなど、LPやWebサイトでよく使う動きの演出${total}種を、動く見本つきで名前から引ける図鑑です。どんなときに使うか、CSSとJavaScriptの作り方、ClaudeやChatGPTに頼むときの指示文までまとめています。`;
const path = '/ugoki/';

const combo = `トップページを作ってください。動きは次の4つだけにしてください。
1. ヘッダーは「追従ヘッダー」にして、スクロールしたら薄い影を付ける
2. 各セクションの見出しと本文は「スクロールでフェードイン」させる（下から16px、0.5秒、1回だけ）
3. 料金カードは「ホバーで浮き上がる」（上に6px、0.2秒）
4. 実績ロゴは「マーキー」で左へ流し続け、マウスを乗せたら止める
端末で「視差効果を減らす」設定がオンの人には、どの動きも出さずに最初から表示してください。`;

const faq = [
  {
    q: 'Webサイトの動きの演出は、何と呼べばAIに伝わりますか？',
    a: 'この図鑑の各ページにある日本語名と英語名をそのまま使ってください。たとえば「追従ヘッダー（sticky header）」「マーキー（marquee）」のように両方を書くと、ClaudeやChatGPTでも取り違えが起きにくくなります。動く速さ（0.3秒など）や距離（16pxなど）まで書くと、さらに狙いどおりになります。',
  },
  {
    q: '演出はたくさん入れた方がいいですか？',
    a: 'いいえ。1ページで目立つ演出は2〜3種類までにするのがおすすめです。動きが多いと、読む人の目がどこに行けばいいか分からなくなり、表示も重くなります。「操作したことが伝わる」「次に読む場所が分かる」など、意味のある動きだけを残してください。',
  },
  {
    q: 'CSSだけで作れる演出はどれですか？',
    a: '追従ヘッダー・ピン留め・スクロールスナップ・ホバーで浮き上がる・ホバーで画像ズーム・下線アニメーション・マーキー・グラデーションアニメーション・ふわふわアニメーション・スムーススクロール・アコーディオンなどは、CSS（とHTML）だけで作れます。各ページの「作り方」に、そのまま使えるコードを載せています。',
  },
  {
    q: '動きが苦手な人への配慮は必要ですか？',
    a: '必要です。スマホやパソコンには「視差効果を減らす（動きを減らす）」設定があり、乗り物酔いのような症状が出る人が使っています。CSSの @media (prefers-reduced-motion: reduce) で、その設定の人には動きを止めるか弱めてください。この図鑑のコードはすべてこの配慮を前提にしています。',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description,
    url: `${SITE.url}${path}`,
    inLanguage: 'ja',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: total,
      itemListElement: UGOKI.map((u, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: `${u.name}（${u.en}）`,
        url: `${SITE.url}/ugoki/${u.slug}/`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: '動きの図鑑', item: `${SITE.url}${path}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout title={title} absoluteTitle={false} description={description} path={path} ogImage="/og/ugoki/index.png" jsonLd={jsonLd}>
  <div class="container ugi">
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <ol>
        <li><a href="/">ホーム</a></li>
        <li aria-current="page">動きの図鑑</li>
      </ol>
    </nav>

    <header class="ugi-head">
      <h1>Webの動きの図鑑</h1>
      <p>LP・Webサイト・アプリでよく見る動きの演出{total}種を、動く見本と名前で引けます。どんなときに使うか、作り方のコード、AIに頼むときの指示文つきです。</p>
    </header>

    <div class="ugi-tools" role="search">
      <label class="ugi-search">
        <span class="sr-only">演出の名前で探す</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M16.5 16.5L21 21" /></svg>
        <input type="search" id="ugi-q" placeholder="例: ヘッダー、ホバー、sticky" autocomplete="off" />
      </label>
      <div class="ugi-chips" role="group" aria-label="種類で絞り込む">
        <button type="button" class="ugi-chip" data-cat="" aria-pressed="true">すべて<span>{total}</span></button>
        {CATEGORIES.map((c) => (
          <button type="button" class="ugi-chip" data-cat={c.id} aria-pressed="false">
            {c.short}<span>{UGOKI.filter((u) => u.category === c.id).length}</span>
          </button>
        ))}
      </div>
    </div>

    {CATEGORIES.map((c) => {
      const list = UGOKI.filter((u) => u.category === c.id);
      if (list.length === 0) return null;
      return (
        <section class="ugi-sec" id={c.id} data-sec={c.id} aria-labelledby={`h-${c.id}`}>
          <div class="ugi-sec-head">
            <h2 id={`h-${c.id}`}>{c.name}</h2>
            <p>{c.desc}</p>
          </div>
          <div class="ug-cards">
            {list.map((u) => <UgCard u={u} />)}
          </div>
        </section>
      );
    })}

    <p class="ugi-empty" id="ugi-empty" hidden>
      見つかりませんでした。「ヘッダー」「スクロール」「ボタン」のように短い言葉で探すか、
      <button type="button" id="ugi-clear">絞り込みを解除</button>してください。
    </p>

    <section class="ugi-guide" aria-labelledby="guide">
      <h2 id="guide">名前で頼むと、狙った動きになる</h2>
      <p>AIにサイトを作ってもらうとき、「おしゃれに動かして」と頼むと、動きは毎回ばらばらで、多すぎたり場違いだったりします。演出には名前があります。名前と、どこに・どれくらいの速さでを添えて頼むと、思ったとおりの動きが返ってきます。</p>
      <ol class="ugi-steps">
        <li><b>名前を日本語と英語の両方で書く</b><span>「追従ヘッダー（sticky header）」のように。片方だけより取り違えが減ります。</span></li>
        <li><b>どこに付けるかを書く</b><span>「料金カードに」「各セクションの見出しに」。全部に付けると騒がしくなります。</span></li>
        <li><b>速さと距離を数字で書く</b><span>「0.3秒」「下から16px」。小さな変化は0.2秒前後、場面の切り替えは0.3秒前後が目安です。</span></li>
        <li><b>動きを減らす設定への配慮を書く</b><span>「視差効果を減らす設定の人には動かさない」と一言添えます。</span></li>
      </ol>
      <p>たとえば次のように頼みます。</p>
      <div class="ugi-combo">
        <pre>{combo}</pre>
        <CopyButton text={combo} label="この頼み方をコピー" />
      </div>
    </section>

    <section class="ugi-faq" aria-labelledby="faq-heading">
      <h2 id="faq-heading">よくある質問</h2>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p class="faq-a">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const q = document.getElementById('ugi-q') as HTMLInputElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.ugi-chip')];
  const cards = [...document.querySelectorAll<HTMLElement>('.ug-card-link')];
  const secs = [...document.querySelectorAll<HTMLElement>('[data-sec]')];
  const empty = document.getElementById('ugi-empty')!;
  let cat = '';

  const norm = (s: string) => s.toLowerCase().normalize('NFKC').replace(/\s+/g, '');
  const apply = () => {
    const words = q.value.toLowerCase().normalize('NFKC').split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const c of cards) {
      const hay = norm(c.dataset.search ?? '');
      const ok = (!cat || c.dataset.cat === cat) && words.every((w) => hay.includes(norm(w)));
      c.hidden = !ok;
      if (ok) shown++;
    }
    for (const s of secs) s.hidden = !s.querySelector('.ug-card-link:not([hidden])');
    empty.hidden = shown > 0;
  };

  q.addEventListener('input', apply);
  chips.forEach((b) =>
    b.addEventListener('click', () => {
      cat = b.dataset.cat ?? '';
      chips.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      apply();
    })
  );
  document.getElementById('ugi-clear')!.addEventListener('click', () => {
    q.value = '';
    cat = '';
    chips.forEach((x, i) => x.setAttribute('aria-pressed', String(i === 0)));
    apply();
    q.focus();
  });
</script>

<style>
  .ugi { padding-bottom: var(--sp-8); }
  .ugi-head { margin: var(--sp-4) 0 var(--sp-5); max-width: var(--article); }
  .ugi-head h1 { font-size: clamp(28px, 5vw, 36px); font-weight: 800; line-height: 1.25; }
  .ugi-head p { margin-top: var(--sp-3); color: var(--text-2); font-size: var(--fs-md); line-height: 1.8; }

  .ugi-tools {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
    margin: 0 calc(var(--sp-4) * -1);
    padding: var(--sp-3) var(--sp-4);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .ugi-search {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex: 1 1 240px;
    max-width: 360px;
    min-height: 44px;
    padding: 0 var(--sp-3);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-full);
    background: var(--surface);
    color: var(--text-3);
  }
  .ugi-search:focus-within { border-color: var(--accent); }
  .ugi-search input { flex: 1; min-width: 0; border: 0; background: transparent; font: inherit; font-size: 16px; color: var(--text); outline: none; }
  .ugi-chips { display: flex; gap: var(--sp-2); overflow-x: auto; scrollbar-width: none; }
  .ugi-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    padding: 0 14px;
    white-space: nowrap;
    font: inherit;
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--text-2);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    cursor: pointer;
  }
  .ugi-chip span { font-size: var(--fs-xs); color: var(--text-3); font-variant-numeric: tabular-nums; }
  .ugi-chip:hover { border-color: var(--border-strong); }
  .ugi-chip:active { transform: scale(0.97); }
  .ugi-chip[aria-pressed='true'] { background: var(--text); border-color: var(--text); color: var(--bg); }
  .ugi-chip[aria-pressed='true'] span { color: inherit; opacity: 0.7; }

  .ugi-sec { margin-top: var(--sp-7); scroll-margin-top: 80px; }
  .ugi-sec-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: var(--sp-1) var(--sp-3); margin-bottom: var(--sp-4); }
  .ugi-sec-head h2 { font-size: var(--fs-xl); font-weight: 800; }
  .ugi-sec-head p { color: var(--text-3); font-size: var(--fs-sm); }

  .ugi-empty { margin-top: var(--sp-7); color: var(--text-2); }
  .ugi-empty button { font: inherit; color: var(--accent); background: none; border: 0; text-decoration: underline; cursor: pointer; padding: 0; min-height: 44px; }

  .ugi-guide, .ugi-faq { max-width: var(--article); margin-top: var(--sp-8); }
  .ugi-guide h2, .ugi-faq h2 { font-size: var(--fs-xl); font-weight: 800; margin-bottom: var(--sp-3); }
  .ugi-guide p { line-height: 1.85; margin-top: var(--sp-3); }
  .ugi-steps { list-style: none; counter-reset: s; display: grid; gap: var(--sp-3); margin-top: var(--sp-4); }
  .ugi-steps li { counter-increment: s; display: grid; grid-template-columns: 32px 1fr; column-gap: var(--sp-3); }
  .ugi-steps li::before {
    content: counter(s);
    grid-row: span 2;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-weight: 800;
  }
  .ugi-steps b { font-weight: 800; }
  .ugi-steps span { color: var(--text-2); font-size: var(--fs-sm); line-height: 1.75; }
  .ugi-combo { margin-top: var(--sp-3); padding: var(--sp-4); border-radius: var(--r-md); background: var(--accent-soft); border: 1px solid var(--accent-border); }
  .ugi-combo pre { margin: 0 0 var(--sp-3); white-space: pre-wrap; font: inherit; font-size: var(--fs-sm); line-height: 1.85; }
</style>
