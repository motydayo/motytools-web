---
import { Code } from 'astro:components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Demo from '../../components/ugoki/Demo.astro';
import UgCard from '../../components/ugoki/UgCard.astro';
import CopyButton from '../../components/ugoki/CopyButton.astro';
import { SITE } from '../../config';
import { UGOKI, CATEGORIES, getUgoki, type Ugoki } from '../../data/ugoki';

export function getStaticPaths() {
  return UGOKI.map((u) => ({ params: { slug: u.slug }, props: { u } }));
}

const { u } = Astro.props as { u: Ugoki };
const path = `/ugoki/${u.slug}/`;
const url = `${SITE.url}${path}`;
const cat = CATEGORIES.find((c) => c.id === u.category)!;
const idx = UGOKI.findIndex((x) => x.slug === u.slug);
const prev = UGOKI[idx - 1];
const next = UGOKI[idx + 1];
const sameCat = UGOKI.filter((x) => x.category === u.category && x.slug !== u.slug).slice(0, 6);
const similar = u.similar
  .map((s) => ({ ...s, u: UGOKI.find((x) => x.slug === s.slug) }))
  .filter((s): s is typeof s & { u: Ugoki } => Boolean(s.u));
const no = String(u.no).padStart(2, '0');
const updated = u.updatedAt ?? u.publishedAt;
const jaDate = (d: string) => {
  const [y, m, dd] = d.split('-').map(Number);
  return `${y}年${m}月${dd}日`;
};
const langName = { html: 'html', css: 'css', js: 'javascript' } as const;

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: u.title,
    description: u.description,
    inLanguage: 'ja',
    datePublished: u.publishedAt,
    dateModified: updated,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: {
      '@type': 'Organization',
      name: SITE.name,
      url: SITE.url,
      logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon.svg` },
    },
    about: [u.name, u.en, ...u.aka],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: '動きの図鑑', item: `${SITE.url}/ugoki/` },
      { '@type': 'ListItem', position: 3, name: u.name, item: url },
    ],
  },
];
if (u.faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: u.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---

<BaseLayout title={u.title} absoluteTitle={false} description={u.description} path={path} ogImage={`/og/ugoki/${u.slug}.png`} ogType="article" jsonLd={jsonLd}>
  <div class="container ugd">
    <nav class="breadcrumb" aria-label="パンくずリスト">
      <ol>
        <li><a href="/">ホーム</a></li>
        <li><a href="/ugoki/">動きの図鑑</a></li>
        <li aria-current="page">{u.name}</li>
      </ol>
    </nav>

    <article>
      <header class="ugd-head">
        <p class="ugd-kicker">
          <span class="ugd-no">No.{no}</span>
          <a href={`/ugoki/#${u.category}`}>{cat.name}</a>
        </p>
        <h1>{u.name}<span class="ugd-en">{u.en}</span></h1>
        <p class="ugd-one">{u.oneLine}</p>
      </header>

      <div class="ugd-demo">
        <Demo slug={u.slug} />
      </div>

      <dl class="ugd-names">
        <div><dt>英語では</dt><dd>{u.en}</dd></div>
        {u.aka.length > 0 && <div><dt>ほかの呼び方</dt><dd>{u.aka.join('、')}</dd></div>}
      </dl>

      <div class="ugd-body">
        <section aria-labelledby="what">
          <h2 id="what">どんな動き？</h2>
          {u.what.map((p) => <p>{p}</p>)}
        </section>

        <section aria-labelledby="when">
          <h2 id="when">使いどころ</h2>
          <div class="ugd-fit">
            <div class="ugd-fit-col is-yes">
              <h3>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                こんなときに使う
              </h3>
              <ul>{u.when.map((w) => <li>{w}</li>)}</ul>
            </div>
            <div class="ugd-fit-col is-no">
              <h3>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                使わない方がいいとき
              </h3>
              <ul>{u.avoid.map((w) => <li>{w}</li>)}</ul>
            </div>
          </div>
        </section>

        <section aria-labelledby="prompt">
          <h2 id="prompt">AIへの頼み方</h2>
          <p>ClaudeやChatGPTなどにサイトを作ってもらうときは、「おしゃれに動かして」ではなく、演出の名前と中身を指定すると狙いどおりになります。そのまま貼って使えます。</p>
          <div class="ugd-prompt">
            <p class="ugd-prompt-text">{u.prompt}</p>
            <CopyButton text={u.prompt} label="指示文をコピー" />
          </div>
        </section>

        <section aria-labelledby="howto">
          <h2 id="howto">作り方</h2>
          {u.howTo.map((p) => <p>{p}</p>)}
          {u.code.map((c) => (
            <div class="ugd-code">
              <div class="ugd-code-head">
                <span>{c.label}</span>
                <CopyButton text={c.code} label="コピー" small />
              </div>
              <Code code={c.code} lang={langName[c.lang]} themes={{ light: 'github-light', dark: 'github-dark' }} wrap={false} />
            </div>
          ))}
        </section>

        <section aria-labelledby="caution">
          <h2 id="caution">気をつけること</h2>
          <ul class="ugd-list">{u.cautions.map((c) => <li>{c}</li>)}</ul>
        </section>

        {similar.length > 0 && (
          <section aria-labelledby="similar">
            <h2 id="similar">似ている演出との違い</h2>
            <ul class="ugd-similar">
              {similar.map((s) => (
                <li>
                  <a href={`/ugoki/${s.u.slug}/`}>
                    <span class="ugd-similar-name">{s.u.name}<small>{s.u.en}</small></span>
                    <span class="ugd-similar-diff">{s.diff}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {u.faq.length > 0 && (
          <section aria-labelledby="faq-heading">
            <h2 id="faq-heading">よくある質問</h2>
            <div class="faq">
              {u.faq.map((f) => (
                <details>
                  <summary>{f.q}</summary>
                  <p class="faq-a">{f.a}</p>
                </details>
              ))}
            </div>
          </section>
        )}

        <p class="ugd-date"><time datetime={updated}>{jaDate(updated)}更新</time></p>
      </div>
    </article>

    <nav class="ugd-pager" aria-label="前後の演出">
      {prev ? (
        <a href={`/ugoki/${prev.slug}/`} class="is-prev">
          <small>前の演出</small>
          <span>No.{String(prev.no).padStart(2, '0')} {prev.name}</span>
        </a>
      ) : <span />}
      {next ? (
        <a href={`/ugoki/${next.slug}/`} class="is-next">
          <small>次の演出</small>
          <span>No.{String(next.no).padStart(2, '0')} {next.name}</span>
        </a>
      ) : <span />}
    </nav>

    {sameCat.length > 0 && (
      <section class="ugd-more" aria-labelledby="more-heading">
        <div class="section-heading">
          <h2 id="more-heading">{cat.name}のほかの演出</h2>
          <a href="/ugoki/" class="ugd-all">32種すべて見る</a>
        </div>
        <div class="ug-cards">
          {sameCat.map((x) => <UgCard u={x} />)}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .ugd { padding-bottom: var(--sp-8); }
  .ugd article { max-width: var(--article); margin: 0 auto; }
  .ugd-head { margin: var(--sp-4) 0 var(--sp-5); }
  .ugd-kicker { display: flex; align-items: center; gap: var(--sp-3); font-size: var(--fs-sm); color: var(--text-2); }
  .ugd-kicker a { color: var(--text-2); }
  .ugd-no {
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
    letter-spacing: 0.04em;
  }
  .ugd-head h1 {
    margin-top: var(--sp-2);
    font-size: clamp(28px, 5vw, 36px);
    line-height: 1.25;
    font-weight: 800;
    letter-spacing: 0.01em;
  }
  .ugd-en { display: block; margin-top: var(--sp-1); font-size: var(--fs-md); font-weight: 600; color: var(--text-3); letter-spacing: 0.02em; }
  .ugd-one { margin-top: var(--sp-3); font-size: var(--fs-md); color: var(--text-2); }
  .ugd-demo { margin-bottom: var(--sp-3); }
  .ugd-names { display: flex; flex-wrap: wrap; gap: var(--sp-1) var(--sp-5); font-size: var(--fs-sm); color: var(--text-2); }
  .ugd-names div { display: flex; gap: var(--sp-2); }
  .ugd-names dt { color: var(--text-3); }
  .ugd-body section { margin-top: var(--sp-7); }
  .ugd-body h2 { font-size: var(--fs-lg); font-weight: 800; margin-bottom: var(--sp-3); scroll-margin-top: 72px; }
  .ugd-body p { margin-top: var(--sp-3); line-height: 1.85; }
  .ugd-body h2 + p { margin-top: 0; }

  .ugd-fit { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-3); }
  @media (max-width: 640px) { .ugd-fit { grid-template-columns: 1fr; } }
  .ugd-fit-col { padding: var(--sp-4); border-radius: var(--r-md); border: 1px solid var(--border); background: var(--surface); }
  .ugd-fit-col h3 { display: flex; align-items: center; gap: var(--sp-2); font-size: var(--fs-base); font-weight: 800; margin-bottom: var(--sp-2); }
  .ugd-fit-col.is-yes h3 { color: var(--success); }
  .ugd-fit-col.is-no h3 { color: var(--danger); }
  .ugd-fit-col ul { padding-left: 1.2em; display: grid; gap: var(--sp-2); font-size: var(--fs-sm); line-height: 1.75; }

  .ugd-prompt {
    position: relative;
    margin-top: var(--sp-4);
    padding: var(--sp-4);
    border-radius: var(--r-md);
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
  }
  .ugd-prompt-text { margin: 0 0 var(--sp-3) !important; font-size: var(--fs-sm); line-height: 1.85; }

  .ugd-code { margin-top: var(--sp-4); border: 1px solid var(--border); border-radius: var(--r-md); overflow: hidden; background: var(--surface); }
  .ugd-code-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 var(--sp-2) 0 var(--sp-4);
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--text-2);
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }
  .ugd-code :global(pre) { margin: 0; padding: var(--sp-4); font-size: 13px; line-height: 1.7; overflow-x: auto; }

  .ugd-list { padding-left: 1.2em; display: grid; gap: var(--sp-2); line-height: 1.8; }

  .ugd-similar { list-style: none; display: grid; gap: var(--sp-2); }
  .ugd-similar a {
    display: grid;
    gap: var(--sp-1);
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .ugd-similar a:hover { border-color: var(--border-strong); }
  .ugd-similar a:active { transform: scale(0.99); }
  .ugd-similar-name { font-weight: 800; }
  .ugd-similar-name small { margin-left: var(--sp-2); font-weight: 500; color: var(--text-3); font-size: var(--fs-xs); }
  .ugd-similar-diff { font-size: var(--fs-sm); color: var(--text-2); line-height: 1.75; }

  .ugd-date { margin-top: var(--sp-6) !important; font-size: var(--fs-xs); color: var(--text-3); }

  .ugd-pager {
    max-width: var(--article);
    margin: var(--sp-7) auto 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-3);
  }
  .ugd-pager a {
    display: grid;
    gap: 2px;
    min-height: 64px;
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
    font-size: var(--fs-sm);
  }
  .ugd-pager a:hover { border-color: var(--border-strong); }
  .ugd-pager small { color: var(--text-3); font-weight: 500; font-size: var(--fs-xs); }
  .ugd-pager .is-next { text-align: right; }
  .ugd-more { margin-top: var(--sp-8); }
  .ugd-all { font-size: var(--fs-sm); font-weight: 700; color: var(--accent); }
</style>

<style is:global>
  /* コードの色: ダーク表示のときは github-dark に切り替える */
  [data-theme='dark'] .ugd-code .astro-code,
  [data-theme='dark'] .ugd-code .astro-code span {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
  }
</style>
