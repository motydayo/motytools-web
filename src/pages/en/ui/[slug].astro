---
import ZukanArticle from '../../../components/zukan/ZukanArticle.astro';
import { book } from '../../../data/zukan';

export function getStaticPaths() {
  const b = book('ui', 'en');
  return b.entries.map((u) => ({ params: { slug: u.slug }, props: { u } }));
}
const { u } = Astro.props;
---

<ZukanArticle book={book('ui', 'en')} u={u} />
