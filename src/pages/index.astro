---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
import { TOOLS, CATEGORIES } from '../data/tools';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'motytools',
    url: SITE.url,
    logo: `${SITE.url}/favicon.svg`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'motytools',
    url: SITE.url,
    inLanguage: 'ja',
  },
];

const popular = ['tedori', 'wareki', 'moji-count', 'image-compress'].map(
  (slug) => TOOLS.find((t) => t.slug === slug)!,
);

// カード用の短い一言（台帳の short より短く、1行で収まる長さ）
const shortLine: Record<string, string> = {
  tedori: '給与から手取り額を計算します。',
  fukuri: '将来の資産額をシミュレーション。',
  loan: '毎月の返済額・総額を試算。',
  'genka-shokyaku': '建物の減価償却費をかんたんに計算。',
  denkidai: '電気代の目安をかんたんに計算。',
  percent: '割合・増減率・割引などを計算。',
  wareki: '西暦と和暦を変換できます。',
  nenrei: '生年月日から年齢を計算。',
  days: '2つの日付の間の日数を計算。',
  eigyobi: '営業日数を自動でカウント。',
  'moji-count': '文字数・行数・バイト数を計測。',
  qr: 'テキストやURLからQRコードを作成。',
  'image-compress': '画像を圧縮・リサイズして軽く。',
  'heic-jpg': 'HEIC形式の画像をJPGに変換。',
};

// つくったもの。visual = カード上部に出す見た目の種類
type Visual = 'chart' | 'memo' | 'barcode' | 'shot' | 'recipe';
interface Product {
  href: string;
  external?: boolean;
  name: string;
  desc: string;
  visual: Visual;
  shot?: string;
  /** スクショ上部の見出し帯を切り落とす */
  crop?: boolean;
  icon?: string;
}
const showcase: Product[] = [
  {
    href: 'https://firemap.alazora.workers.dev',
    external: true,
    name: '炎上マップ',
    desc: '話題の投稿を時系列で可視化。',
    visual: 'chart',
  },
  {
    href: '/memomail/',
    name: 'メモびゅん',
    desc: 'すぐ書けて、すぐ送れる。シンプルなメモ帳。',
    visual: 'memo',
  },
  {
    href: '/price-scan/',
    name: 'ピッと最安',
    desc: 'バーコードで商品を検索し最安値をチェック。',
    visual: 'barcode',
  },
  {
    href: '/pitto-kigen/',
    name: 'ピッと期限',
    desc: '食品や日用品の期限を管理。',
    visual: 'shot',
    shot: '/pitto-kigen/shots/04.jpg',
    crop: true,
  },
  {
    href: '/recipescrap/',
    name: 'レシピスクラップ',
    desc: 'SNSのレシピを材料と手順だけにして保存。',
    visual: 'recipe',
  },
  {
    href: '/arumono-recipe/',
    name: 'あるものレシピ',
    desc: '冷蔵庫にある食材から、いま作れる料理を。',
    visual: 'shot',
    shot: '/arumono-recipe/shots/01-v2.png',
  },
  {
    href: '/pitto-hosho/',
    name: 'ピッと保証',
    desc: '保証書を撮るだけで、家電の保証期限を管理。',
    visual: 'shot',
    shot: '/pitto-hosho/shots/01-mock.webp',
  },
];
const compact: Product[] = [
  {
    href: '/ooya-note/',
    name: '大家ノート',
    desc: '不動産の収支・管理をシンプルに。',
    visual: 'memo',
    icon: '<path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/><path d="M9 21v-8h6v8"/>',
  },
  {
    href: '/apps/lesson-techo/',
    name: 'レッスン手帳',
    desc: '習いごとの生徒・月謝・振替を管理。',
    visual: 'memo',
    icon: '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
  },
  {
    href: '/apps/tsukulog/',
    name: 'つくログ',
    desc: 'つくる過程を、ログとして残す。',
    visual: 'memo',
    icon: '<rect x="8" y="2" width="13" height="16" rx="2"/><path d="M4 6v14a2 2 0 0 0 2 2h11"/>',
  },
  {
    href: '/buzzmeter/',
    name: '真相メモ',
    desc: '気になることを調べて整理。',
    visual: 'memo',
    icon: '<circle cx="11" cy="11" r="7"/><path d="M16.5 16.5L21 21"/>',
  },
];
---

<BaseLayout
  title="motytools — 無料Webツールとアプリのスタジオ"
  absoluteTitle={true}
  description="手取り計算・和暦変換・文字数カウント・画像圧縮など、登録不要ですぐ使える無料Webツールを公開中。データと技術で「便利」を届けるプロダクトスタジオ motytools。"
  path="/"
  appearance="light"
  chrome="home"
  jsonLd={jsonLd}
>
  <!-- ヒーロー -->
  <section class="hm-hero">
    <div class="container hm-hero-inner">
      <div class="hm-hero-text">
        <p class="hm-eyebrow">Product Studio / Tokyo</p>
        <h1 class="hm-title">役に立つを、<br />かたちにする。</h1>
        <p class="hm-lead">
          毎日のちょっとした不便を解消する、<br class="hm-br-pc" />無料のWebツールとアプリを作っています。
        </p>
        <div class="hm-hero-actions">
          <a class="hm-btn" href="/tools/">
            無料ツールを使う
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
          <a class="hm-textlink" href="#products">プロダクトを見る <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="hm-hero-art" aria-hidden="true">
        <div class="hm-mock hm-mock-a">
          <div class="hm-mock-bar"><i></i><i></i><i></i></div>
          <div class="hm-mock-head">
            <span class="hm-mock-ic"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="13" rx="2"/><path d="M2 10h20"/></svg></span>
            手取り計算
          </div>
          <div class="hm-mock-row"><span>年収（額面）</span><b>500 万円</b></div>
          <div class="hm-mock-row"><span>賞与</span><b>年2回</b></div>
          <div class="hm-mock-row"><span>扶養</span><b>0 人</b></div>
          <div class="hm-mock-result">
            <small>手取り（月額）の目安</small>
            <strong>314,820 円</strong>
          </div>
          <div class="hm-mock-row hm-mock-row-sm"><span>健康保険</span><b>2.1 万円</b></div>
          <div class="hm-mock-row hm-mock-row-sm"><span>厚生年金</span><b>3.8 万円</b></div>
          <div class="hm-mock-row hm-mock-row-sm"><span>所得税</span><b>1.0 万円</b></div>
        </div>

        <div class="hm-mock hm-mock-b">
          <div class="hm-mock-bar"><i></i><i></i><i></i></div>
          <div class="hm-mock-head">
            <span class="hm-mock-ic"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V5h16v2"/><path d="M12 5v14"/><path d="M9 19h6"/></svg></span>
            文字数カウント
          </div>
          <div class="hm-mock-cols">
            <p class="hm-mock-text">伝わる言葉で、誰かの毎日を少しでも楽に。motytoolsは、役に立つツールをつくり続けます。</p>
            <div class="hm-mock-stats">
              <div><small>文字数</small><strong>47</strong></div>
              <div><small>空白抜き</small><b>46</b></div>
              <div><small>行数</small><b>2</b></div>
            </div>
          </div>
        </div>

        <div class="hm-mock hm-mock-c">
          <div class="hm-mock-bar"><i></i><i></i><i></i></div>
          <div class="hm-mock-head">
            <span class="hm-mock-ic"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></span>
            画像圧縮・リサイズ
          </div>
          <div class="hm-mock-cols">
            <div class="hm-mock-drop">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
              <span>画像をドラッグ＆ドロップ<br />または<u>ファイルを選択</u></span>
            </div>
            <div class="hm-mock-settings">
              <small>出力設定</small>
              <div class="hm-mock-row"><span>幅の最大</span><b>1920</b></div>
              <div class="hm-mock-row"><span>画質</span><b>80</b></div>
              <div class="hm-mock-row"><span>形式</span><b>JPEG</b></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- よく使われています -->
  <div class="hm-popular">
    <div class="container hm-popular-inner">
      <span class="hm-popular-label">よく使われています</span>
      <ul class="hm-popular-list">
        {popular.map((t) => (
          <li><a href={`/${t.slug}/`}>{t.name}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <!-- 無料Webツール -->
  <section class="hm-tools" id="tools" aria-labelledby="tools-heading">
    <div class="container">
      <div class="hm-tools-head">
        <h2 id="tools-heading" class="hm-h2">無料Webツール</h2>
        <label class="hm-search">
          <span class="sr-only">ツールを検索</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M16.5 16.5L21 21"/></svg>
          <input type="search" id="hm-search" placeholder="ツール名や用途で検索" autocomplete="off" />
        </label>
      </div>

      <div class="hm-chips" role="group" aria-label="カテゴリで絞り込む">
        <button type="button" class="hm-chip" data-cat="all" aria-pressed="true">すべて</button>
        {CATEGORIES.map((c) => (
          <button type="button" class="hm-chip" data-cat={c.id} aria-pressed="false">{c.name.replace('の計算', '')}</button>
        ))}
      </div>

      <ul class="hm-tool-grid" id="hm-tool-grid">
        {TOOLS.map((t) => (
          <li class="hm-tool-item" data-cat={t.category} data-text={`${t.name} ${t.short} ${t.keywords.join(' ')}`.toLowerCase()}>
            <a href={`/${t.slug}/`} class="hm-tool">
              <span class="hm-tool-ic" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={t.icon} />
              </span>
              <span class="hm-tool-body">
                <span class="hm-tool-name">{t.name}</span>
                <span class="hm-tool-desc">{shortLine[t.slug] ?? t.short}</span>
              </span>
              <svg class="hm-tool-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          </li>
        ))}
      </ul>
      <p class="hm-tool-empty" id="hm-tool-empty" hidden>
        一致するツールがありません。別の言葉で探すか、<a href="/tools/">ツール一覧</a>をご覧ください。
      </p>
    </div>
  </section>

  <!-- つくったもの -->
  <section class="hm-products" id="products" aria-labelledby="products-heading">
    <div class="container">
      <h2 id="products-heading" class="hm-h2">つくったもの</h2>

      <div class="hm-showcase">
        <a href="https://roster.motytools.com" target="_blank" rel="noopener noreferrer" class="hm-feature">
          <div class="hm-feature-text">
            <span class="hm-feature-ic" aria-hidden="true">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="13" width="4" height="8" rx="1"/><rect x="10" y="8" width="4" height="13" rx="1"/><rect x="17" y="3" width="4" height="18" rx="1"/></svg>
            </span>
            <span class="hm-feature-name">Roster</span>
            <p>日本のYouTubeチャンネルをカテゴリ別にランキング。</p>
            <span class="hm-btn hm-btn-outline">詳しく見る <span aria-hidden="true">→</span></span>
          </div>
          <div class="hm-feature-art" aria-hidden="true">
            <div class="hm-roster">
              <div class="hm-roster-side">
                <b>Roster</b>
                <i class="on">すべて</i><i>エンタメ</i><i>音楽</i><i>ゲーム</i><i>スポーツ</i><i>学び</i><i>ビジネス</i><i>ニュース</i><i>料理</i>
              </div>
              <div class="hm-roster-main">
                <b>YouTubeチャンネルランキング</b>
                <div class="hm-roster-search"></div>
                <div class="hm-roster-row hm-roster-th"><span>#</span><span>チャンネル</span><span>カテゴリ</span><span>登録者</span></div>
                <div class="hm-roster-row"><span>1</span><span><em></em><u style="width:62%"></u></span><span>エンタメ</span><span>902万</span></div>
                <div class="hm-roster-row"><span>2</span><span><em></em><u style="width:48%"></u></span><span>エンタメ</span><span>711万</span></div>
                <div class="hm-roster-row"><span>3</span><span><em></em><u style="width:70%"></u></span><span>ゲーム</span><span>686万</span></div>
                <div class="hm-roster-row"><span>4</span><span><em></em><u style="width:55%"></u></span><span>音楽</span><span>671万</span></div>
                <div class="hm-roster-row"><span>5</span><span><em></em><u style="width:40%"></u></span><span>学び</span><span>572万</span></div>
              </div>
            </div>
          </div>
        </a>

        {showcase.map((p) => (
          <a
            href={p.href}
            class={`hm-card hm-card-${p.visual}${p.crop ? ' hm-card-crop' : ''}`}
            target={p.external ? '_blank' : undefined}
            rel={p.external ? 'noopener noreferrer' : undefined}
          >
            <span class="hm-card-name">{p.name}</span>
            <div class="hm-card-art" aria-hidden="true">
              {p.visual === 'chart' && (
                <svg viewBox="0 0 200 60" preserveAspectRatio="none">
                  <path d="M0 48 L20 44 L40 46 L60 38 L80 40 L100 30 L120 34 L140 22 L160 26 L180 12 L200 16 L200 60 L0 60 Z" fill="rgba(220,80,60,0.12)"/>
                  <path d="M0 48 L20 44 L40 46 L60 38 L80 40 L100 30 L120 34 L140 22 L160 26 L180 12 L200 16" fill="none" stroke="#d9534a" stroke-width="2"/>
                </svg>
              )}
              {p.visual === 'memo' && (
                <div class="hm-memo">
                  <b>買い物メモ</b>
                  <u style="width:80%"></u><u style="width:55%"></u><u style="width:68%"></u>
                  <span>送信</span>
                </div>
              )}
              {p.visual === 'barcode' && (
                <div class="hm-barcode">
                  <svg viewBox="0 0 120 40" preserveAspectRatio="none">
                    <g fill="#1c1c1a">
                      <rect x="2" y="0" width="3" height="40"/><rect x="7" y="0" width="1" height="40"/><rect x="10" y="0" width="2" height="40"/><rect x="15" y="0" width="4" height="40"/><rect x="21" y="0" width="1" height="40"/><rect x="24" y="0" width="3" height="40"/><rect x="30" y="0" width="1" height="40"/><rect x="33" y="0" width="2" height="40"/><rect x="38" y="0" width="4" height="40"/><rect x="44" y="0" width="1" height="40"/><rect x="48" y="0" width="2" height="40"/><rect x="52" y="0" width="3" height="40"/><rect x="58" y="0" width="1" height="40"/><rect x="61" y="0" width="4" height="40"/><rect x="67" y="0" width="2" height="40"/><rect x="71" y="0" width="1" height="40"/><rect x="75" y="0" width="3" height="40"/><rect x="80" y="0" width="1" height="40"/><rect x="84" y="0" width="4" height="40"/><rect x="90" y="0" width="2" height="40"/><rect x="94" y="0" width="1" height="40"/><rect x="98" y="0" width="3" height="40"/><rect x="103" y="0" width="1" height="40"/><rect x="106" y="0" width="2" height="40"/><rect x="111" y="0" width="4" height="40"/><rect x="117" y="0" width="1" height="40"/>
                    </g>
                  </svg>
                  <em>最安 ¥178</em>
                </div>
              )}
              {p.visual === 'shot' && <img src={p.shot} alt="" width="620" height="1342" loading="lazy" decoding="async" />}
              {p.visual === 'recipe' && (
                <div class="hm-recipe">
                  <b>鶏むね肉の照り焼き</b>
                  <small>材料（2人分）</small>
                  <span>鶏むね肉 <i>1枚</i></span>
                  <span>しょうゆ <i>大さじ2</i></span>
                </div>
              )}
            </div>
            <span class="hm-card-desc">{p.desc}</span>
          </a>
        ))}
      </div>

      <div class="hm-compact">
        {compact.map((p) => (
          <a href={p.href} class="hm-mini">
            <span class="hm-mini-ic" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
            </span>
            <span class="hm-mini-body">
              <span class="hm-mini-name">{p.name}</span>
              <span class="hm-mini-desc">{p.desc}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- motytoolsについて -->
  <section class="hm-about" id="about" aria-labelledby="about-heading">
    <div class="container hm-about-inner">
      <h2 id="about-heading" class="sr-only">motytoolsについて</h2>
      <div class="hm-about-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
        <div>
          <b>すべて無料・登録不要</b>
          <p>面倒な登録は一切ありません。開いてすぐ使えます。</p>
        </div>
      </div>
      <div class="hm-about-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
        <div>
          <b>入力データはブラウザ内で処理</b>
          <p>計算も画像処理もお使いの端末の中で完結。データが外部に送信されることはありません。</p>
        </div>
      </div>
      <div class="hm-about-item">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M11 18h2"/></svg>
        <div>
          <b>iPhoneアプリも作っています</b>
          <p>ご意見・ご要望は各アプリの「ご意見・要望」からお寄せください。</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // 検索とカテゴリ絞り込み（トップページだけの小さな処理）
  const input = document.getElementById('hm-search') as HTMLInputElement | null;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.hm-chip'));
  const items = Array.from(document.querySelectorAll<HTMLLIElement>('.hm-tool-item'));
  const empty = document.getElementById('hm-tool-empty');
  let cat = 'all';

  function apply() {
    const q = (input?.value ?? '').trim().toLowerCase();
    let shown = 0;
    for (const li of items) {
      const okCat = cat === 'all' || li.dataset.cat === cat;
      const okText = !q || (li.dataset.text ?? '').includes(q);
      const ok = okCat && okText;
      li.hidden = !ok;
      if (ok) shown++;
    }
    if (empty) empty.hidden = shown > 0;
  }
  input?.addEventListener('input', apply);
  for (const chip of chips) {
    chip.addEventListener('click', () => {
      cat = chip.dataset.cat ?? 'all';
      for (const c of chips) c.setAttribute('aria-pressed', String(c === chip));
      apply();
    });
  }

  // スマホ用メニュー
  const btn = document.querySelector<HTMLButtonElement>('.hm-menu-btn');
  const nav = document.getElementById('hm-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
