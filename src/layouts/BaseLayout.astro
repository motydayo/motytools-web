---
import { SITE } from '../config';
import { TOOLS, CATEGORIES } from '../data/tools';
import { APPS } from '../data/apps';
import '../styles/global.css';

interface Props {
  /** ページタイトル（「 | motytools」が付く）。absoluteTitle=true ならそのまま出す */
  title: string;
  absoluteTitle?: boolean;
  description: string;
  /** 先頭スラッシュ始まり・末尾スラッシュ込みのパス（例: '/percent/'） */
  path: string;
  ogImage?: string;
  /** 'auto' = ライト/ダーク切替あり, 'dark' = 常にダーク, 'light' = 常にライト（トップ用） */
  appearance?: 'auto' | 'dark' | 'light';
  /** 'home' = トップ専用のヘッダー/フッター（見た目はトップページ側のCSSで定義） */
  chrome?: 'default' | 'home';
  jsonLd?: object[];
  noindex?: boolean;
  /** App StoreのアプリID。入れるとiPhoneのSafariで「ダウンロード帯」（Smart App Banner）が出る */
  appleAppId?: string;
  ogType?: 'website' | 'article';
  /** 'en' = 英語ページ（英語のヘッダー・フッター、og:locale en_US） */
  lang?: 'ja' | 'en';
  /** 同じ内容の別言語ページ（hreflang）。例 { ja: '/ugoki/', en: '/en/motion/' } */
  alternates?: { ja?: string; en?: string };
}

const {
  title,
  absoluteTitle = false,
  description,
  path,
  ogImage = '/og/default.png',
  appearance = 'auto',
  jsonLd = [],
  noindex = false,
  chrome = 'default',
  appleAppId,
  ogType = 'website',
  lang = 'ja',
  alternates,
} = Astro.props;
const en = lang === 'en';

const fullTitle = absoluteTitle ? title : `${title} | ${SITE.name}`;
const canonical = `${SITE.url}${path}`;
const ogImageUrl = `${SITE.url}${ogImage}`;
---

<!doctype html>
<html lang={lang} data-theme={appearance === 'auto' ? undefined : appearance}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    {appleAppId && <meta name="apple-itunes-app" content={`app-id=${appleAppId}`} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={en ? 'en_US' : 'ja_JP'} />
    {alternates?.ja && <link rel="alternate" hreflang="ja" href={`${SITE.url}${alternates.ja}`} />}
    {alternates?.en && <link rel="alternate" hreflang="en" href={`${SITE.url}${alternates.en}`} />}
    {alternates?.ja && alternates?.en && <link rel="alternate" hreflang="x-default" href={`${SITE.url}${alternates.en}`} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {SITE.searchConsoleToken && <meta name="google-site-verification" content={SITE.searchConsoleToken} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    {appearance === 'auto' && (
      <script is:inline>
        (function () {
          try {
            var t = localStorage.getItem('mt-theme');
            if (t !== 'light' && t !== 'dark') {
              t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-theme', t);
          } catch (e) {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        })();
      </script>
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Sans+JP:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />

    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}

    {SITE.gaId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`}></script>
        <script is:inline define:vars={{ gaId: SITE.gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}
    <script
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`}
      crossorigin="anonymous"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">{en ? 'Skip to content' : '本文へスキップ'}</a>
    {en ? (
      <header class="site-header">
        <div class="inner">
          <a href="/en/" class="logo">moty<span>tools</span></a>
          <nav class="header-nav" aria-label="Site menu">
            <a href="/en/motion/">Motion</a>
            <a href="/en/ui/">UI<span class="nav-sm-hide">&nbsp;components</span></a>
            {alternates?.ja && <a href={alternates.ja} lang="ja" hreflang="ja">日本語</a>}
            <button class="theme-toggle" type="button" aria-label="Toggle light and dark theme">
              <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
              <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            </button>
          </nav>
        </div>
      </header>
    ) : chrome === 'home' ? (
      <header class="hm-header">
        <div class="hm-header-inner">
          <a href="/" class="hm-logo">motytools</a>
          <nav class="hm-nav" id="hm-nav" aria-label="サイト内メニュー">
            <a href="#tools">無料ツール</a>
            <a href="/apps/">iPhoneアプリ</a>
            <a href="/guide/">使い方ガイド</a>
            <a href="/ugoki/">動きの図鑑</a>
            <a href="#products">プロダクト</a>
            <a href="/tools/" class="hm-nav-cta">ツールを探す</a>
          </nav>
          <a href="/tools/" class="hm-header-cta">ツールを探す</a>
          <button class="hm-menu-btn" type="button" aria-expanded="false" aria-controls="hm-nav" aria-label="メニューを開く">
            <svg class="ic-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            <svg class="ic-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        </div>
      </header>
    ) : (
    <header class="site-header">
        <div class="inner">
          <a href="/" class="logo">moty<span>tools</span></a>
          <nav class="header-nav" aria-label="サイト内メニュー">
            <a href="/apps/">アプリ</a>
            <a href="/guide/"><span class="nav-sm-hide">使い方</span>ガイド</a>
            <a href="/tools/">ツール<span class="nav-sm-hide">一覧</span></a>
            {appearance === 'auto' && (
              <button class="theme-toggle" type="button" aria-label="ライト/ダークテーマを切り替える">
                <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
              </button>
            )}
          </nav>
        </div>
      </header>
    )}

    <main id="main">
      <slot />
    </main>

    {en ? (
      <footer class="site-footer">
        <div class="container">
          <div class="cols">
            <div>
              <h2>Libraries</h2>
              <ul>
                <li><a href="/en/motion/">Web Motion Library</a></li>
                <li><a href="/en/ui/">UI Component Library</a></li>
              </ul>
            </div>
            <div>
              <h2>motytools</h2>
              <ul>
                <li><a href="/" lang="ja" hreflang="ja">motytools (Japanese)</a></li>
                <li><a href="/about/" lang="ja" hreflang="ja">About motytools (Japanese)</a></li>
                <li><a href="/en/privacy/">Privacy policy</a></li>
              </ul>
            </div>
          </div>
          <div class="legal">
            <p>© 2026 motytools</p>
            <p>Free to use. No sign-up. Everything runs in your browser.</p>
          </div>
        </div>
      </footer>
    ) : chrome === 'home' ? (
      <footer class="hm-footer">
        <div class="container">
          <div class="hm-footer-top">
            <div class="hm-footer-brand">
              <a href="/" class="hm-footer-logo">motytools</a>
              <p>日常をちょっと便利にする、<br />Webツールとプロダクトを。</p>
            </div>
            <nav class="hm-footer-nav" aria-label="フッターメニュー">
              <a href="/tools/">無料ツール</a>
              <a href="/apps/">iPhoneアプリ</a>
              <a href="/guide/">使い方ガイド</a>
              <a href="/ugoki/">動きの図鑑</a>
              <a href="/ui/">UI部品の図鑑</a>
              <a href="/shiryo/">資料レイアウトの図鑑</a>
              <a href="#products">プロダクト</a>
              <a href="/about/">運営者情報</a>
              <a href="/site-privacy/">プライバシーポリシー</a>
            </nav>
          </div>
          <div class="hm-footer-bottom">
            <p>© 2026 motytools</p>
            <p>すべて無料・登録不要。入力データはブラウザ内で処理されます。</p>
          </div>
        </div>
      </footer>
    ) : (
    <footer class="site-footer">
        <div class="container">
          <div class="cols">
            {CATEGORIES.map((cat) => (
              <div>
                <h2>{cat.name}</h2>
                <ul>
                  {TOOLS.filter((t) => t.category === cat.id).map((t) => (
                    <li><a href={`/${t.slug}/`}>{t.name}</a></li>
                  ))}
                </ul>
              </div>
            ))}
            <div>
              <h2>iPhoneアプリ</h2>
              <ul>
                {APPS.map((a) => (
                  <li><a href={a.lpPath}>{a.name}</a></li>
                ))}
              </ul>
            </div>
            <div>
              <h2>motytools</h2>
              <ul>
                <li><a href="/">ホーム</a></li>
                <li><a href="/tools/">ツール一覧</a></li>
                <li><a href="/apps/">iPhoneアプリ一覧</a></li>
                <li><a href="/guide/">使い方ガイド</a></li>
                <li><a href="/ugoki/">Webの動きの図鑑</a></li>
                <li><a href="/ui/">UI部品の図鑑</a></li>
                <li><a href="/shiryo/">資料レイアウトの図鑑</a></li>
                <li><a href="/about/">運営者情報</a></li>
                <li><a href="/site-privacy/">プライバシーポリシー</a></li>
              </ul>
            </div>
          </div>
          <div class="legal">
            <p>© 2026 motytools</p>
            <p>すべてのツールは無料・登録不要で、データはブラウザ内で処理されます。</p>
          </div>
        </div>
      </footer>
    )}

    {appearance === 'auto' && (
      <script>
        const btn = document.querySelector('.theme-toggle');
        btn?.addEventListener('click', () => {
          const cur = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
          const next = cur === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try {
            localStorage.setItem('mt-theme', next);
          } catch {}
        });
      </script>
    )}
  </body>
</html>
