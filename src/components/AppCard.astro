---
// /apps/ ハブのアプリカード
import type { AppEntry } from '../data/apps';
import StoreBadge from './StoreBadge.astro';
import MoreLink from './MoreLink.astro';

interface Props {
  app: AppEntry;
  /** このアプリの記事数（0なら記事リンクを出さない） */
  guideCount?: number;
}
const { app, guideCount = 0 } = Astro.props;
---

<article class="app-card">
  <div class="app-card-head">
    <img class="app-icon-img" src={app.icon} width="64" height="64" alt="" loading="lazy" decoding="async" />
    <div class="app-card-head-text">
      <h3 class="app-card-name"><a href={app.lpPath}>{app.name}</a></h3>
      <span class="app-card-genre">{app.genre}・{app.pricing.startsWith('無料') ? '無料で始められます' : app.pricing}</span>
    </div>
  </div>
  <p class="app-card-tagline">{app.tagline}</p>
  <p class="app-card-for"><b>こんな人に</b>　{app.audience}</p>
  <div class="app-card-actions">
    <StoreBadge app={app} />
    <MoreLink href={app.lpPath}>詳しく見る</MoreLink>
    {guideCount > 0 && <MoreLink href={`/guide/app/${app.slug}/`}>使い方の記事（{guideCount}）</MoreLink>}
  </div>
</article>
