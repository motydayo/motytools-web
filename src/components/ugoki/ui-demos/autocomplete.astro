---
// UI部品の見本: オートコンプリート（コンボボックス）
// 本体は input[role=combobox] ＋ ul[role=listbox]。打つたびに候補を絞り、矢印キーで選んで Enter で決める。
// 選んでいる候補は aria-activedescendant で読み上げソフトに伝える（焦点は入力欄に置いたまま）。
import UgFrame from '../UgFrame.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
const mini = size === 'mini';
const Lb = mini ? 'p' : 'label';
const Btn = mini ? 'span' : 'button';
const L = {
  ja: {
    name: 'オートコンプリート',
    nav: ['国内旅行', '特集'],
    label: 'SEARCH',
    title: 'どこへ行きますか？',
    field: '行き先',
    hint: '例: はこね、はかた',
    search: '検索する',
    found: '{n}件の候補があります。上下の矢印キーで選べます',
    none: '「{q}」に合う行き先が見つかりません',
    picked: '{v}の宿を探します',
    more: 'ほか{n}件。続けて入力すると絞り込めます',
    popular: '人気の行き先',
    pop: ['箱根', '京都', '金沢', '博多'],
    items: [
      ['箱根', 'はこね', '神奈川県'], ['函館', 'はこだて', '北海道'], ['博多', 'はかた', '福岡県'], ['浜松', 'はままつ', '静岡県'],
      ['白馬', 'はくば', '長野県'], ['花巻', 'はなまき', '岩手県'], ['八丈島', 'はちじょうじま', '東京都'], ['萩', 'はぎ', '山口県'],
      ['熱海', 'あたみ', '静岡県'], ['有馬温泉', 'ありまおんせん', '兵庫県'], ['伊勢', 'いせ', '三重県'], ['金沢', 'かなざわ', '石川県'],
      ['軽井沢', 'かるいざわ', '長野県'], ['京都', 'きょうと', '京都府'], ['草津', 'くさつ', '群馬県'], ['別府', 'べっぷ', '大分県'],
    ],
    tour: ['は', 'はこ'],
  },
  en: {
    name: 'Autocomplete',
    nav: ['Flights', 'Hotels'],
    label: 'SEARCH',
    title: 'Where to?',
    field: 'Destination',
    hint: 'e.g. Boston, Denver',
    search: 'Search',
    found: '{n} suggestions. Use up and down arrows to choose',
    none: 'No destinations match “{q}”',
    picked: 'Searching stays in {v}',
    more: '{n} more. Keep typing to narrow it down',
    popular: 'Popular destinations',
    pop: ['Boston', 'Denver', 'Austin', 'Chicago'],
    items: [
      ['Boston', '', 'MA'], ['Boise', '', 'ID'], ['Boulder', '', 'CO'], ['Bozeman', '', 'MT'],
      ['Bowling Green', '', 'KY'], ['Baltimore', '', 'MD'], ['Buffalo', '', 'NY'], ['Burlington', '', 'VT'],
      ['Austin', '', 'TX'], ['Chicago', '', 'IL'], ['Denver', '', 'CO'], ['Miami', '', 'FL'],
      ['Nashville', '', 'TN'], ['Portland', '', 'OR'], ['San Diego', '', 'CA'], ['Seattle', '', 'WA'],
    ],
    tour: ['B', 'Bo'],
  },
}[lang as 'ja' | 'en'];
const text = { found: L.found, none: L.none, picked: L.picked, more: L.more, tour: L.tour };
---

<UgFrame mode="script" size={size} label={L.name} lang={lang}>
  <div class="ug-site ac-site" data-demo="autocomplete" data-items={JSON.stringify(L.items)} data-text={JSON.stringify(text)}>
    <header class="ug-nav"><span class="ug-logo">SAMPLE</span>{L.nav.map((n) => <span>{n}</span>)}</header>
    <section class="ug-sec ac-sec">
      <p class="ug-label">{L.label}</p>
      <h3 class="ug-h">{L.title}</h3>

      <div class="ac-form">
        <Lb class="ac-name" data-ac-label>{L.field}</Lb>
        <div class="ac-row">
          <!-- これが部品の本体: 入力欄の下に、打った文字に合う候補が出る -->
          <div class="ac-box" data-ug-focus={L.name}>
            <svg class="ac-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M20 20l-4.2-4.2" /></svg>
            {mini ? (
              <span class="ac-input" data-ac-input data-placeholder={L.hint}></span>
            ) : (
              <input class="ac-input" type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" autocomplete="off" placeholder={L.hint} data-ac-input />
            )}
            <ul class="ac-list" role={mini ? undefined : 'listbox'} hidden data-ac-list></ul>
          </div>
          <Btn class="ug-btn-site ac-go" {...(mini ? {} : { type: 'button' })} data-ac-go>{L.search}</Btn>
        </div>
        <p class="ac-status" role="status" data-ac-status></p>
      </div>

      <p class="ac-pop-h">{L.popular}</p>
      <ul class="ac-pop">
        {L.pop.map((p) => <li>{p}</li>)}
      </ul>
    </section>
  </div>
</UgFrame>

<style>
  .ac-site { min-height: 100%; }
  .ac-form { margin-top: 8px; }
  .ac-name { display: block; margin-bottom: 4px; font-size: 12px; font-weight: 700; color: var(--ug-ink-2); }
  .ac-row { display: flex; gap: 8px; align-items: flex-start; }
  .ac-box { position: relative; flex: 1; min-width: 0; max-width: 400px; }
  .ac-icon { position: absolute; left: 12px; top: 13px; color: var(--ug-ink-2); pointer-events: none; }
  .ac-input {
    display: flex;
    align-items: center;
    box-sizing: border-box;
    width: 100%;
    height: 44px;
    margin: 0;
    padding: 0 12px 0 38px;
    border: 1.5px solid #c9c7c0;
    border-radius: 10px;
    background: #fff;
    font: inherit;
    font-size: 15px;
    color: var(--ug-ink);
    outline: none;
  }
  .ac-input::placeholder { color: #9a978f; }
  span.ac-input:empty::before { content: attr(data-placeholder); color: #9a978f; }
  .ac-input:focus, .ac-input.is-focus { border-color: var(--ug-blue); box-shadow: 0 0 0 3px rgba(79, 115, 217, 0.2); }

  /* 候補の一覧。入力欄の真下に重ねて出す */
  .ac-list {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    right: 0;
    z-index: 10;
    margin: 0;
    padding: 4px;
    list-style: none;
    border: 1px solid var(--ug-line);
    border-radius: 10px;
    background: #fff;
    box-shadow: 0 12px 24px -12px rgba(20, 24, 40, 0.35);
    animation: ac-in 0.15s ease-out;
  }
  .ac-list[hidden] { display: none; }
  @keyframes ac-in { from { opacity: 0; transform: translateY(-4px); } }
  .ac-list :global(.ac-opt) {
    display: flex;
    align-items: baseline;
    gap: 8px;
    min-height: 44px;
    padding: 0 12px;
    border-radius: 6px;
    align-content: center;
    flex-wrap: wrap;
    cursor: pointer;
  }
  .ac-list :global(.ac-opt-name) { font-size: 14px; font-weight: 700; line-height: 44px; }
  .ac-list :global(.ac-opt-sub) { font-size: 11px; color: var(--ug-ink-2); }
  .ac-list :global(.ac-opt b) { font-weight: 800; color: var(--ug-ink); }
  /* 今選んでいる候補（矢印キー・マウス） */
  .ac-list :global(.ac-opt.is-active) { background: #e8eefc; }
  .ac-list :global(.ac-more) { padding: 4px 12px; font-size: 11px; color: var(--ug-ink-2); }

  .ac-go { flex: none; min-height: 44px; }
  .ac-go:hover, .ac-go.is-hover { filter: brightness(0.94); }
  .ac-status { min-height: 20px; margin-top: 4px; font-size: 12px; color: var(--ug-ink-2); }
  .ac-status.is-picked { font-weight: 700; color: #1f7a4d; }

  .ac-pop-h { margin-top: 16px; font-size: 12px; font-weight: 700; color: var(--ug-ink-2); }
  .ac-pop { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 8px 0 0; padding: 0; list-style: none; }
  .ac-pop li { padding: 12px; border-radius: 10px; background: var(--ug-bg); font-size: 13px; font-weight: 700; }

  @container (max-width: 340px) {
    .ac-sec .ug-label, .ac-sec .ug-h { display: none; }
    .ac-list :global(.ac-opt) { min-height: 30px; }
    .ac-list :global(.ac-opt-name) { line-height: 30px; }
  }
  :global(.ug-frame.is-mini) .ac-go,
  :global(.ug-frame.is-mini) .ac-status { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .ac-list { animation: none; }
  }
</style>

<script>
  import { onTour, tuneNum } from '../../../lib/ugoki/runtime';

  document.querySelectorAll<HTMLElement>('[data-demo="autocomplete"]').forEach((root) => {
    const view = root.closest<HTMLElement>('[data-ug-view]')!;
    const items: [string, string, string][] = JSON.parse(root.dataset.items ?? '[]');
    const text: { found: string; none: string; picked: string; more: string; tour: string[] } = JSON.parse(root.dataset.text ?? '{}');
    const box = root.querySelector<HTMLElement>('.ac-box')!;
    const inputEl = root.querySelector<HTMLElement>('[data-ac-input]')!;
    const input = inputEl instanceof HTMLInputElement ? inputEl : null;
    const list = root.querySelector<HTMLElement>('[data-ac-list]')!;
    const status = root.querySelector<HTMLElement>('[data-ac-status]')!;
    const go = root.querySelector<HTMLElement>('[data-ac-go]')!;
    const mini = root.closest<HTMLElement>('[data-ug-frame]')?.dataset.size === 'mini';
    const uid = Math.random().toString(36).slice(2, 8);
    let matches: [string, string, string][] = [];
    let active = -1;
    let timer = 0;

    // 入力欄・候補の一覧・ラベルを id で結びつける（id は見本ごとに作る）
    if (input) {
      input.id = `ac-in-${uid}`;
      list.id = `ac-list-${uid}`;
      input.setAttribute('aria-controls', list.id);
      root.querySelector('[data-ac-label]')?.setAttribute('for', input.id);
    }

    const getQ = () => (input ? input.value : inputEl.textContent ?? '');
    const setQ = (v: string) => (input ? (input.value = v) : (inputEl.textContent = v));
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    // 打った部分を太字にして、なぜこの候補が出たのかを見せる
    const mark = (s: string, q: string) => (s.toLowerCase().startsWith(q.toLowerCase()) ? `<b>${esc(s.slice(0, q.length))}</b>${esc(s.slice(q.length))}` : esc(s));

    const close = () => {
      list.hidden = true;
      active = -1;
      input?.setAttribute('aria-expanded', 'false');
      input?.removeAttribute('aria-activedescendant');
    };
    const setActive = (i: number) => {
      active = i;
      list.querySelectorAll<HTMLElement>('.ac-opt').forEach((o, k) => {
        o.classList.toggle('is-active', k === i);
        o.setAttribute('aria-selected', String(k === i));
      });
      const el = list.querySelectorAll<HTMLElement>('.ac-opt')[i];
      if (input) {
        if (el) input.setAttribute('aria-activedescendant', el.id);
        else input.removeAttribute('aria-activedescendant');
      }
    };
    const render = () => {
      const q = getQ().trim();
      status.classList.remove('is-picked');
      if (!q) {
        close();
        status.textContent = '';
        return;
      }
      const ql = q.toLowerCase();
      matches = items.filter(([n, r]) => n.toLowerCase().startsWith(ql) || (r && r.startsWith(q)) || n.includes(q));
      const rows = Math.round(tuneNum(root, 'rows', 5));
      const shown = matches.slice(0, rows);
      if (!shown.length) {
        close();
        status.textContent = text.none.replace('{q}', q);
        return;
      }
      list.innerHTML =
        shown
          .map(([n, r, s], i) => {
            const name = r ? `${esc(n)}` : mark(n, q);
            const sub = r ? `${mark(r, q)}・${esc(s)}` : esc(s);
            return `<li class="ac-opt" ${input ? `role="option" id="ac-${uid}-${i}" aria-selected="false"` : ''} data-i="${i}"><span class="ac-opt-name">${name}</span><span class="ac-opt-sub">${sub}</span></li>`;
          })
          .join('') + (matches.length > shown.length ? `<li class="ac-more" aria-hidden="true">${esc(text.more.replace('{n}', String(matches.length - shown.length)))}</li>` : '');
      list.hidden = false;
      input?.setAttribute('aria-expanded', 'true');
      // 候補が枠の下にはみ出すなら、見えるところまで送る
      const over = list.getBoundingClientRect().bottom - view.getBoundingClientRect().bottom + 8;
      if (over > 0 && !mini) view.scrollTo({ top: view.scrollTop + over, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      setActive(-1);
      status.textContent = text.found.replace('{n}', String(matches.length));
    };
    // 打つたびではなく、手が止まって少し待ってから候補を出す（デバウンス）
    const schedule = () => {
      clearTimeout(timer);
      timer = window.setTimeout(render, tuneNum(root, 'delay', 150));
    };
    const pick = (i: number) => {
      const m = matches[i];
      if (!m) return;
      setQ(m[0]);
      close();
      status.textContent = text.picked.replace('{v}', m[0]);
      status.classList.add('is-picked');
    };

    if (input) {
      input.addEventListener('input', schedule);
      input.addEventListener('keydown', (e) => {
        const n = list.querySelectorAll('.ac-opt').length;
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          if (list.hidden) render();
          else setActive((active + 1) % n);
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          if (!list.hidden) setActive(active <= 0 ? n - 1 : active - 1);
        } else if (e.key === 'Enter') {
          if (!list.hidden && active >= 0) {
            e.preventDefault();
            pick(active);
          }
        } else if (e.key === 'Escape') {
          // 1回目で候補を閉じ、2回目で入力を消す
          if (!list.hidden) close();
          else setQ('');
        }
      });
      input.addEventListener('blur', () => window.setTimeout(close, 120));
    }
    // マウス・タップで候補を選ぶ（押した瞬間に入力欄の焦点が外れないように pointerdown で止める）
    list.addEventListener('pointerdown', (e) => e.preventDefault());
    list.addEventListener('click', (e) => {
      const o = (e.target as HTMLElement).closest<HTMLElement>('.ac-opt');
      if (o) pick(Number(o.dataset.i));
    });
    list.addEventListener('pointermove', (e) => {
      const o = (e.target as HTMLElement).closest<HTMLElement>('.ac-opt');
      if (o) setActive(Number(o.dataset.i));
    });
    go.addEventListener('click', () => (active >= 0 ? pick(active) : render()));

    const reset = () => {
      clearTimeout(timer);
      setQ('');
      close();
      status.textContent = '';
      status.classList.remove('is-picked');
      inputEl.classList.remove('is-focus');
      if (!mini) view.scrollTop = 0;
    };
    view.addEventListener('ug:reset', reset);

    onTour(root, async (t) => {
      reset();
      await t.move({ x: t.view.clientWidth * 0.75, y: t.view.clientHeight * 0.85 }, 10);
      await t.sleep(400);
      await t.move(inputEl, 700);
      await t.click(inputEl);
      inputEl.classList.add('is-focus');
      t.showCursor(false);
      await t.sleep(400);
      // 1文字ずつ打つ
      for (const q of text.tour) {
        setQ(q);
        schedule();
        await t.sleep(700 + tuneNum(root, 'delay', 150));
      }
      await t.sleep(600);
      // 矢印キーで下へ（ここでは見た目だけ）
      for (const i of [0, 1]) {
        setActive(i);
        await t.sleep(650);
      }
      await t.sleep(300);
      const opt = list.querySelectorAll<HTMLElement>('.ac-opt')[1];
      if (opt) {
        t.showCursor(true);
        await t.move(opt, 500);
        await t.click(opt);
        pick(1);
      }
      inputEl.classList.remove('is-focus');
      await t.sleep(2200);
    });
  });
</script>
