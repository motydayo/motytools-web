---
interface Props {
  /** コピーする文字。from を使うときは不要 */
  text?: string;
  /** 近くの [data-copy-scope] の中から、この要素の文字をコピーする（つまみで中身が変わる所） */
  from?: string;
  label: string;
  small?: boolean;
  /** 押したあとの表示（英語ページ用） */
  doneLabel?: string;
  failLabel?: string;
}
const { text = '', from, label, small = false, doneLabel = 'コピーしました', failLabel = 'コピーできませんでした。長押しで選んでください' } = Astro.props;
---

<button type="button" class:list={['ug-copy', { 'is-small': small }]} data-ug-copy={text} data-copy-from={from} data-done={doneLabel} data-fail={failLabel}>
  <svg class="i-copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15V5a2 2 0 0 1 2-2h10" /></svg>
  <svg class="i-done" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
  <span data-copy-label>{label}</span>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-ug-copy]').forEach((btn) => {
    const labelEl = btn.querySelector('[data-copy-label]')!;
    const original = labelEl.textContent;
    let timer = 0;
    btn.addEventListener('click', async () => {
      const from = btn.dataset.copyFrom;
      const text = from
        ? (btn.closest('[data-copy-scope]')?.querySelector(from)?.textContent ?? '')
        : (btn.dataset.ugCopy ?? '');
      let ok = false;
      try {
        await navigator.clipboard.writeText(text);
        ok = true;
      } catch {
        // 古いブラウザ向け: 見えない入力欄を使ってコピーする
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        ok = document.execCommand('copy');
        ta.remove();
      }
      labelEl.textContent = ok ? (btn.dataset.done ?? '') : (btn.dataset.fail ?? '');
      btn.classList.toggle('is-done', ok);
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        labelEl.textContent = original;
        btn.classList.remove('is-done');
      }, 2000);
    });
  });
</script>

<style>
  .ug-copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 16px;
    font: inherit;
    font-size: var(--fs-sm);
    font-weight: 700;
    color: var(--on-accent);
    background: var(--accent);
    border: 0;
    border-radius: var(--r-full);
    cursor: pointer;
    transition: background 0.15s;
  }
  .ug-copy:hover { background: var(--accent-hover); }
  .ug-copy:active { transform: scale(0.97); }
  .ug-copy:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .ug-copy.is-small {
    min-height: 40px;
    padding: 0 12px;
    font-size: var(--fs-xs);
    color: var(--text-2);
    background: transparent;
  }
  .ug-copy.is-small:hover { background: var(--border); color: var(--text); }
  .i-done { display: none; }
  .is-done .i-done { display: block; }
  .is-done .i-copy { display: none; }
  .ug-copy.is-small.is-done { color: var(--success); }
</style>
