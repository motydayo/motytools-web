---
import UgFrame from '../UgFrame.astro';
import Scene from '../Scene.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
// 見本の中の文字（日英）
const L = {
  ja: {
    name: 'ふわふわアニメーション',
    focus: 'ふわふわ',
    url: 'tabi-note.app',
    logo: '旅ノート',
    nav: ['機能', '使い方'],
    cta: '入手する',
    title: ['旅の予約を、', 'ひとつのアプリで。'],
    sub: '宿・交通・旅程をまとめて管理。',
    btn: '無料でダウンロード',
    screen: '山の宿',
    badgeA: '予約が確定しました',
    reviews: 'レビュー1,200件',
    feats: [['宿', '予約をまとめて表示'], ['交通', '乗り換えも一緒に'], ['旅程', '家族と共有できる']],
  },
  en: {
    name: 'Floating animation',
    focus: 'Floating',
    url: 'tripnote.app',
    logo: 'Tripnote',
    nav: ['Features', 'How it works'],
    cta: 'Get the app',
    title: ['Every booking for your trip,', 'in one app.'],
    sub: 'Hotels, trains and plans, all in one place.',
    btn: 'Download free',
    screen: 'Pine Ridge',
    badgeA: 'Booking confirmed',
    reviews: '1,200 reviews',
    feats: [['Stays', 'All your bookings'], ['Travel', 'Transfers included'], ['Plans', 'Share with family']],
  },
}[lang as 'ja' | 'en'];
---

<UgFrame mode="loop" size={size} label={L.name} url={L.url} lang={lang}>
  <div class="ug-site fl-site">
    <header class="ug-nav"><span class="ug-logo">{L.logo}</span>{L.nav.map((n) => <span>{n}</span>)}<span class="ug-cta">{L.cta}</span></header>
    <section class="fl-hero">
      <div class="fl-copy">
        <p class="ug-label">TRAVEL APP</p>
        <h3 class="fl-title">{L.title[0]}<br />{L.title[1]}</h3>
        <p class="fl-sub">{L.sub}</p>
        <span class="ug-btn-site fl-btn">{L.btn}</span>
      </div>
      <!-- これが演出の本体: 画像を上下に少しだけ、ゆっくり行き来させ続ける -->
      <div class="fl-stage ug-pausable" data-ug-focus={L.focus}>
        <div class="fl-float fl-phone">
          <div class="fl-screen">
            <Scene tone="day" />
            <span class="fl-screen-h">{L.screen}</span>
            <span class="fl-screen-l"><i></i><i></i><i></i></span>
            <span class="fl-screen-btn"></span>
          </div>
        </div>
        <span class="fl-shadow" aria-hidden="true"></span>
        <span class="fl-float fl-badge fl-badge-a">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
          {L.badgeA}
        </span>
        <span class="fl-float fl-badge fl-badge-b">
          <svg width="12" height="12" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z" fill="currentColor" /></svg>
          4.8<small>{L.reviews}</small>
        </span>
      </div>
    </section>
    <section class="ug-sec fl-feat">
      <div class="ug-grid">
        {L.feats.map(([b, t]) => <div class="fl-f"><b>{b}</b><span>{t}</span></div>)}
      </div>
    </section>
  </div>
</UgFrame>

<style>
  .fl-hero { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 8px; padding: 16px 16px 8px 24px; background: linear-gradient(180deg, #fff, var(--ug-bg)); }
  .fl-title { margin: 4px 0 8px !important; font-size: 22px; font-weight: 800; line-height: 1.35 !important; }
  .fl-sub { font-size: 12px; color: var(--ug-ink-2); }
  .fl-btn { margin-top: 16px; }

  .fl-stage { position: relative; display: grid; justify-items: center; padding: 16px 0 20px; }

  /* ふわふわの本体: 上へ --t-dist、--t-dur で1往復。緩急は --t-ease（いずれもつまみから） */
  .fl-float { animation: fl-float var(--t-dur) var(--t-ease) infinite; }
  /* 吹き出しは、周期とタイミングを少しずつずらす */
  .fl-badge-a { animation-delay: calc(var(--t-dur) * -0.34); animation-duration: calc(var(--t-dur) * 1.19); }
  .fl-badge-b { animation-delay: calc(var(--t-dur) * -0.69); animation-duration: calc(var(--t-dur) * 1.09); }
  @keyframes fl-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(calc(var(--t-dist) * -1)); }
  }
  /* 影は、浮いたときに小さく薄くなる */
  .fl-shadow { width: 96px; height: 12px; margin-top: 8px; border-radius: 50%; background: rgba(29, 37, 65, 0.22); filter: blur(3px); animation: fl-shadow var(--t-dur) var(--t-ease) infinite; }
  @keyframes fl-shadow {
    0%, 100% { transform: scaleX(1); opacity: 1; }
    50% { transform: scaleX(0.78); opacity: 0.55; }
  }

  .fl-phone { width: 128px; height: 232px; padding: 6px; border-radius: 24px; background: var(--ug-navy); box-shadow: 0 18px 30px -18px rgba(29, 37, 65, 0.6); }
  .fl-screen { display: flex; flex-direction: column; gap: 6px; height: 100%; padding: 8px; border-radius: 18px; background: #fff; overflow: hidden; }
  .fl-screen :global(.ug-scene) { border-radius: 10px; }
  .fl-screen-h { font-size: 11px; font-weight: 800; }
  .fl-screen-l { display: grid; gap: 5px; }
  .fl-screen-l i { height: 5px; border-radius: 3px; background: #e9e7e1; }
  .fl-screen-l i:nth-child(2) { width: 80%; }
  .fl-screen-l i:nth-child(3) { width: 60%; }
  .fl-screen-btn { height: 18px; margin-top: auto; border-radius: 999px; background: var(--ug-orange); }

  .fl-badge {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 10px;
    background: #fff;
    font-size: 11px;
    font-weight: 700;
    white-space: nowrap;
    box-shadow: 0 10px 22px -12px rgba(29, 37, 65, 0.5);
  }
  .fl-badge-a { top: 40px; left: calc(50% - 132px); color: var(--ug-ink); }
  .fl-badge-a svg { padding: 2px; border-radius: 50%; background: #2f9e6a; color: #fff; }
  .fl-badge-b { bottom: 52px; left: calc(50% + 30px); color: var(--ug-orange); }
  .fl-badge-b small { font-size: 10px; font-weight: 400; color: var(--ug-ink-2); }

  .fl-feat { border-top: 0; }
  .fl-f { display: grid; gap: 2px; padding: 12px; border: 1px solid var(--ug-line); border-radius: 10px; }
  .fl-f b { font-size: 13px; }
  .fl-f span { font-size: 10px; color: var(--ug-ink-2); }

  /* スマホの詳細ページ（枠の幅が340px以下） */
  @container (max-width: 340px) {
    .fl-hero { grid-template-columns: 1fr 1fr; padding: 16px 8px 8px 16px; gap: 0; }
    .fl-title { font-size: 17px; }
    .fl-sub { font-size: 11px; }
    .fl-btn { min-height: 36px; margin-top: 12px; padding: 0 14px; font-size: 11px; }
    .fl-phone { width: 104px; height: 188px; padding: 5px; border-radius: 20px; }
    .fl-screen { border-radius: 15px; }
    .fl-badge { padding: 4px 8px; font-size: 10px; gap: 4px; }
    .fl-badge-a { top: 44px; left: calc(50% - 96px); }
    .fl-badge-b { display: none; }
    .fl-shadow { width: 80px; }
  }
  /* 一覧の小さな見本（高さ196px）はさらに小さく */
  :global(.ug-frame.is-mini) .fl-hero { grid-template-columns: 1.1fr 1fr; padding: 8px 12px 0 16px; }
  :global(.ug-frame.is-mini) .fl-title { font-size: 15px; }
  :global(.ug-frame.is-mini) .fl-sub { display: none; }
  :global(.ug-frame.is-mini) .fl-btn { min-height: 30px; margin-top: 8px; padding: 0 12px; font-size: 10px; }
  :global(.ug-frame.is-mini) .fl-stage { padding: 12px 0 8px; }
  :global(.ug-frame.is-mini) .fl-phone { width: 74px; height: 120px; padding: 4px; border-radius: 16px; }
  :global(.ug-frame.is-mini) .fl-screen { padding: 5px; gap: 4px; border-radius: 12px; }
  :global(.ug-frame.is-mini) .fl-screen-h,
  :global(.ug-frame.is-mini) .fl-screen-l i:nth-child(3) { display: none; }
  :global(.ug-frame.is-mini) .fl-screen-btn { height: 10px; }
  :global(.ug-frame.is-mini) .fl-shadow { width: 60px; height: 8px; margin-top: 6px; }
  :global(.ug-frame.is-mini) .fl-badge { padding: 4px 7px; font-size: 9px; }
  :global(.ug-frame.is-mini) .fl-badge-a { top: 64px; left: calc(50% - 80px); }
  :global(.ug-frame.is-mini) .fl-badge-b { display: none; }
  /* 動きを減らす設定なら止める（止まった絵でも成り立つ） */
  @media (prefers-reduced-motion: reduce) {
    .fl-float, .fl-shadow { animation: none; }
  }
</style>
