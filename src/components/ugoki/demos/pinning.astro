---
import UgFrame from '../UgFrame.astro';
import Scene from '../Scene.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
// 一覧の小さな見本はカード全体がリンクなので、押せる要素を置かない
const Btn = size === 'mini' ? 'span' : 'button';
const btnType = size === 'mini' ? undefined : 'button';
const tones = ['day', 'sunset', 'night'] as const;
// 見本の中の文字（日英）
const L = {
  ja: {
    name: 'ピン留め', logo: '山の宿 ひかり', nav: ['お部屋', '料金'], cta: '予約する',
    lead: 'ご予約は3ステップ', faq: 'よくある質問', more: '空室を見る',
    steps: [
      { title: '日にちを選ぶ', text: 'カレンダーから空いている日を選びます。' },
      { title: 'お部屋を選ぶ', text: '人数に合うお部屋とプランを選びます。' },
      { title: '予約を確定', text: '確認メールが届いたら完了です。' },
    ],
  },
  en: {
    name: 'Pinning', logo: 'Hikari Lodge', nav: ['Rooms', 'Rates'], cta: 'Book',
    lead: 'Book in 3 easy steps', faq: 'Questions', more: 'Check dates',
    steps: [
      { title: 'Pick your dates', text: 'Choose any open night on the calendar.' },
      { title: 'Choose a room', text: 'Find the room and rate that fit your group.' },
      { title: 'Confirm', text: 'You are all set once the email arrives.' },
    ],
  },
}[lang as 'ja' | 'en'];
const steps = L.steps.map((s, i) => ({ ...s, no: String(i + 1).padStart(2, '0'), tone: tones[i] }));
---

<UgFrame mode="scroll" size={size} label={L.name} lang={lang}>
  <div class="ug-site pn" data-demo="pinning">
    <header class="ug-nav">
      <span class="ug-logo">{L.logo}</span>
      {L.nav.map((n) => <span>{n}</span>)}
      <span class="ug-cta">{L.cta}</span>
    </header>

    <section class="ug-sec intro">
      <p class="ug-label">HOW TO</p>
      <h3 class="ug-h">{L.lead}</h3>
    </section>

    <!-- この区間（枠の3画面ぶん）のあいだだけ、中のパネルが止まる -->
    <section class="pin-sec">
      <div class="pin" data-ug-focus={L.name}>
        <ol class="rail" aria-hidden="true">
          {steps.map((s, i) => <li class:list={['dot', { 'is-on': i === 0 }]}>{s.no}</li>)}
        </ol>
        <div class="stage">
          {steps.map((s, i) => (
            <div class:list={['step', { 'is-on': i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
              <div class="step-text">
                <p class="step-no"><small>STEP</small>{s.no}</p>
                <h4 class="step-h">{s.title}</h4>
                <p class="step-p">{s.text}</p>
              </div>
              <div class="step-pic"><Scene tone={s.tone} /></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="ug-sec">
      <p class="ug-label">FAQ</p>
      <h3 class="ug-h">{L.faq}</h3>
      <div class="ug-lines"><i></i><i></i><i></i><i></i></div>
    </section>
    <section class="ug-sec">
      <div class="ug-lines"><i></i><i></i></div>
      <Btn type={btnType} class="ug-btn-site more">{L.more}</Btn>
    </section>
  </div>
</UgFrame>

<style>
  /* 区間の長さ＝止めておきたいスクロール量（枠いくつ分か。つまみ --t-len） */
  .pin-sec { height: calc(var(--vh, 420px) * var(--t-len)); }
  /* これが演出の本体: 区間の中にいる間だけ、上端に止まる */
  .pin {
    position: sticky;
    top: 0;
    height: var(--vh, 420px);
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 16px;
    padding: 24px 24px 24px 16px;
    background: var(--ug-bg);
    border-top: 1px solid var(--ug-line);
    border-bottom: 1px solid var(--ug-line);
  }

  /* 左の目盛り: いま何番目か */
  .rail {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    margin: 0;
    padding: 8px 0;
    list-style: none;
  }
  .rail::before {
    content: '';
    position: absolute;
    top: 16px;
    bottom: 16px;
    left: 50%;
    width: 2px;
    margin-left: -1px;
    background: var(--ug-line);
  }
  .dot {
    position: relative;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid var(--ug-line);
    color: var(--ug-ink-2);
    font-size: 10px;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    transition: background-color 0.2s ease-out, border-color 0.2s ease-out, color 0.2s ease-out;
  }
  .dot.is-on { background: var(--ug-orange); border-color: var(--ug-orange); color: #fff; }

  .stage { position: relative; }
  .step {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 24px;
    opacity: 0;
    transform: translateY(var(--t-dist));
    transition: opacity var(--t-dur) ease-out, transform var(--t-dur) ease-out;
  }
  .step.is-on { opacity: 1; transform: none; }
  .step.is-past { transform: translateY(calc(var(--t-dist) * -1)); }
  .step-no { display: flex; align-items: baseline; gap: 6px; font-size: 44px; font-weight: 800; line-height: 1; color: var(--ug-orange); font-variant-numeric: tabular-nums; }
  .step-no small { font-size: 12px; letter-spacing: 0.12em; }
  .step-h { margin-top: 12px !important; font-size: 22px; font-weight: 800; }
  .step-p { margin-top: 8px; color: var(--ug-ink-2); }
  .step-pic { border-radius: 12px; overflow: hidden; box-shadow: 0 12px 24px -16px rgba(29, 37, 65, 0.5); }
  .step-pic :global(.ug-scene) { display: block; }
  .more { margin-top: 16px; }

  /* スマホ幅: 文字の下に絵 */
  @container (max-width: 520px) {
    .pin { grid-template-columns: 28px 1fr; gap: 12px; padding: 16px 16px 16px 12px; }
    .dot { width: 24px; height: 24px; font-size: 9px; }
    .step { grid-template-columns: 1fr; align-content: center; gap: 16px; }
    .step-no { font-size: 36px; }
    .step-h { font-size: 19px; }
    .step-pic { max-width: 260px; }
  }
  /* 一覧の小さな枠: 前置きを省き、文字と絵を横並びに */
  :global(.is-mini) .intro { display: none; }
  :global(.is-mini) .pin { padding: 12px 12px 12px 8px; gap: 8px; }
  :global(.is-mini) .rail { padding: 4px 0; }
  :global(.is-mini) .rail::before { top: 12px; bottom: 12px; }
  :global(.is-mini) .step { grid-template-columns: 1fr 96px; gap: 12px; }
  :global(.is-mini) .step-no { font-size: 30px; }
  :global(.is-mini) .step-h { margin-top: 6px !important; font-size: 15px; }
  :global(.is-mini) .step-p { display: none; }

  @media (prefers-reduced-motion: reduce) {
    .step, .step.is-past { transform: none; transition: opacity 0.15s linear; }
  }
</style>

<script>
  import { onTour, onTune } from '../../../lib/ugoki/runtime';

  document.querySelectorAll<HTMLElement>('[data-demo="pinning"]').forEach((root) => {
    const view = root.closest<HTMLElement>('[data-ug-view]');
    if (!view) return;
    const sec = root.querySelector<HTMLElement>('.pin-sec')!;
    const steps = [...root.querySelectorAll<HTMLElement>('.step')];
    const dots = [...root.querySelectorAll<HTMLElement>('.dot')];

    // パネルの高さ＝枠の高さ
    const fit = () => root.style.setProperty('--vh', `${view.clientHeight}px`);
    new ResizeObserver(fit).observe(view);
    fit();

    let current = -1;
    const update = () => {
      // 区間をどこまで進んだか（0〜1）で、表示するステップを決める
      const top = sec.getBoundingClientRect().top - view.getBoundingClientRect().top;
      const p = Math.min(1, Math.max(0, -top / (sec.offsetHeight - view.clientHeight)));
      const idx = Math.min(steps.length - 1, Math.floor(p * steps.length));
      if (idx === current) return;
      current = idx;
      steps.forEach((s, i) => {
        s.classList.toggle('is-on', i === idx);
        s.classList.toggle('is-past', i < idx);
        s.setAttribute('aria-hidden', String(i !== idx));
      });
      dots.forEach((d, i) => d.classList.toggle('is-on', i <= idx));
    };
    view.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    update();
    // 区間の長さが変わったら、いまの位置で表示し直す
    onTune(view, () => {
      current = -1;
      update();
    });

    // 自動再生: 区間に入ったら、1ステップずつ止まりながら進む
    onTour(root, async (t) => {
      t.showCursor(false);
      if (t.view.scrollTop > 0) await t.scrollTo(0, 600);
      await t.sleep(900);
      const start = sec.getBoundingClientRect().top - t.view.getBoundingClientRect().top + t.view.scrollTop;
      const dist = sec.offsetHeight - t.view.clientHeight;
      await t.scrollTo(start, 800);
      await t.sleep(1100);
      // 区間を同じ速さで進む（区間が長いほど、次のステップまで長くスクロールする）
      const leg = dist / steps.length;
      const ms = Math.max(500, (leg / t.view.clientHeight) * 1300);
      for (let i = 1; i <= steps.length; i++) {
        const p = i === steps.length ? 1 : i / steps.length + 0.06;
        await t.scrollTo(start + dist * p, ms);
        await t.sleep(1000);
      }
      await t.scrollTo(t.view.scrollHeight, 1000);
      await t.sleep(900);
      await t.scrollTo(0, 900);
      await t.sleep(400);
    });
  });
</script>
