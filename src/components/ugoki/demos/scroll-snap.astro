---
import UgFrame from '../UgFrame.astro';
import Scene from '../Scene.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
// 一覧の小さな見本はカード全体がリンクなので、押せる要素を置かない
const Btn = size === 'mini' ? 'span' : 'button';
const btnType = size === 'mini' ? undefined : 'button';
const tones = ['sunset', 'day', 'night'] as const;
// 見本の中の文字（日英）
const L = {
  ja: {
    name: 'スクロールスナップ', focus: '1画面ずつ止まる', brand: 'なぎさ',
    slides: [
      { kicker: '海の宿 なぎさ', title: '波の音で目覚める朝', sub: '全室オーシャンビュー' },
      { kicker: 'ROOM', title: '海が見える和室', sub: '8畳＋広縁・2〜4名' },
      { kicker: 'DINNER', title: '地魚の炭火焼き', sub: '夕食は個室でゆっくり' },
    ],
    price: '1泊2食 18,000円〜', cta: '空室を見る',
  },
  en: {
    name: 'Scroll snap', focus: 'Snaps one screen at a time', brand: 'Nagisa',
    slides: [
      { kicker: 'NAGISA SEASIDE INN', title: 'Wake up to the waves', sub: 'Every room faces the ocean' },
      { kicker: 'ROOMS', title: 'Ocean-view suites', sub: 'Sleeps 2–4 · Private balcony' },
      { kicker: 'DINNER', title: 'Fresh catch, grilled', sub: 'Served in a private dining room' },
    ],
    price: 'From $160 / night, meals included', cta: 'Check dates',
  },
}[lang as 'ja' | 'en'];
const slides = L.slides.map((s, i) => ({ ...s, tone: tones[i] }));
const total = slides.length + 1;
---

<UgFrame mode="scroll" size={size} label={L.name} lang={lang}>
  <div class="ug-site sn" data-demo="scroll-snap">
    {slides.map((s, i) => (
      <section class="slide" data-ug-focus={L.focus}>
        <Scene tone={s.tone} />
        <span class="brand ug-logo">{L.brand}</span>
        <div class="copy">
          <p class="count">{String(i + 1).padStart(2, '0')} / {String(total).padStart(2, '0')}</p>
          <p class="kicker">{s.kicker}</p>
          <h3 class="title">{s.title}</h3>
          <p class="sub">{s.sub}</p>
        </div>
        <ol class="dots" aria-hidden="true">
          {Array.from({ length: total }, (_, j) => <li class:list={{ 'is-on': j === i }}></li>)}
        </ol>
      </section>
    ))}
    <section class="slide last" data-ug-focus={L.focus}>
      <span class="brand ug-logo">{L.brand}</span>
      <div class="copy">
        <p class="count">{String(total).padStart(2, '0')} / {String(total).padStart(2, '0')}</p>
        <p class="kicker">RESERVE</p>
        <h3 class="title">{L.price}</h3>
        <Btn type={btnType} class="ug-btn-site cta">{L.cta}</Btn>
      </div>
      <ol class="dots" aria-hidden="true">
        {Array.from({ length: total }, (_, j) => <li class:list={{ 'is-on': j === total - 1 }}></li>)}
      </ol>
    </section>
  </div>
</UgFrame>

<style>
  /* これが演出の本体（1）: スクロールする箱に「縦方向で止まる」を指定。強さはつまみ（--t-snap）
     （見本では枠の中の箱。本番のページなら html に付ける） */
  :global(.ug-view:has(.sn)) {
    scroll-snap-type: y var(--t-snap, mandatory);
  }
  /* 自動再生の間は外し、台本の側で吸い付きを再現する（途中の位置に勝手に吸い付かないように） */
  :global(.ug-view.is-programmatic:has(.sn)),
  :global(.is-touring .ug-view:has(.sn)) {
    scroll-snap-type: none;
  }
  .slide {
    position: relative;
    height: var(--slide-h, 420px);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    /* これが演出の本体（2）: 各画面の上端（か真ん中）で止まる。止まる途中で飛ばさない */
    scroll-snap-align: var(--t-align, start);
    scroll-snap-stop: always;
    background: var(--ug-navy);
    color: #fff;
  }
  .slide :global(.ug-scene) { position: absolute; inset: 0; width: 100%; height: 100%; aspect-ratio: auto; }
  .slide::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgba(29, 37, 65, 0.78), rgba(29, 37, 65, 0) 62%);
  }
  .brand { position: absolute; top: 16px; left: 20px; z-index: 2; padding: 4px 12px 4px 10px; border-radius: 999px; background: rgba(29, 37, 65, 0.6); color: #fff; font-size: 12px; }
  .copy { position: relative; z-index: 2; padding: 0 56px 28px 24px; }
  .count { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; font-variant-numeric: tabular-nums; opacity: 0.85; }
  .kicker { margin-top: 8px; font-size: 11px; font-weight: 800; letter-spacing: 0.12em; color: var(--ug-orange-2); }
  .title { font-size: 26px; font-weight: 800; }
  .sub { margin-top: 4px; font-size: 13px; opacity: 0.9; }
  .last { align-items: center; background: linear-gradient(160deg, var(--ug-navy), #34406b); }
  .last::before { display: none; }
  .cta { margin-top: 16px; }

  .dots {
    position: absolute;
    top: 50%;
    right: 16px;
    z-index: 2;
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 8px 6px;
    border-radius: 999px;
    background: rgba(29, 37, 65, 0.45);
    list-style: none;
    transform: translateY(-50%);
  }
  .dots li { width: 8px; height: 8px; border-radius: 50%; background: rgba(255, 255, 255, 0.45); }
  .dots li.is-on { height: 20px; border-radius: 4px; background: #fff; }

  @container (max-width: 520px) {
    .copy { padding: 0 44px 24px 16px; }
    .brand { left: 16px; }
    .title { font-size: 22px; }
  }
  /* 端末で「動きを減らす」設定なら、吸い付きを弱める */
  @media (prefers-reduced-motion: reduce) {
    :global(.ug-view:has(.sn)) { scroll-snap-type: y proximity; }
  }
  :global(.is-mini) .brand { top: 8px; left: 8px; padding: 2px 8px 2px 6px; font-size: 10px; }
  :global(.is-mini) .copy { padding: 0 36px 14px 14px; }
  :global(.is-mini) .count { display: none; }
  :global(.is-mini) .kicker { margin-top: 0; font-size: 9px; }
  :global(.is-mini) .title { font-size: 17px; }
  :global(.is-mini) .sub { font-size: 11px; }
  :global(.is-mini) .cta { margin-top: 8px; min-height: 30px; font-size: 11px; }
  :global(.is-mini) .dots { right: 8px; gap: 6px; padding: 6px 4px; }
  :global(.is-mini) .dots li { width: 6px; height: 6px; }
  :global(.is-mini) .dots li.is-on { height: 14px; }
</style>

<script>
  import { onTour, onTune, tuneNum, tuneStr } from '../../../lib/ugoki/runtime';

  document.querySelectorAll<HTMLElement>('[data-demo="scroll-snap"]').forEach((root) => {
    const view = root.closest<HTMLElement>('[data-ug-view]');
    if (!view) return;
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    // 1枚の高さ＝枠の高さ×つまみの割合
    const fit = () => {
      const pct = tuneNum(root, 'size', 100);
      root.style.setProperty('--slide-h', `${Math.round((view.clientHeight * pct) / 100)}px`);
    };
    new ResizeObserver(fit).observe(view);
    onTune(view, fit);
    fit();

    // 各スライドで止まる位置（scroll-snap-align が start なら上端、center なら真ん中）
    const stops = () => {
      const h = view.clientHeight;
      const max = view.scrollHeight - h;
      const center = tuneStr(root, 'align', 'start') === 'center';
      const base = view.getBoundingClientRect().top - view.scrollTop;
      const list = slides.map((s) => {
        const r = s.getBoundingClientRect();
        const top = r.top - base;
        return Math.max(0, Math.min(max, center ? top + r.height / 2 - h / 2 : top));
      });
      return list.filter((y, i) => i === 0 || Math.abs(y - list[i - 1]) > 2);
    };

    // 自動再生: 少し送って指を離す → 吸い付く、を繰り返す。
    // 吸い付きの強さ（mandatory / proximity）による違いも、台本で同じように再現する
    onTour(root, async (t) => {
      t.showCursor(false);
      const h = t.view.clientHeight;
      const ys = stops();
      if (Math.abs(t.view.scrollTop - ys[0]) > 2) await t.scrollTo(ys[0], 500);
      await t.sleep(1200);
      for (let i = 1; i < ys.length; i++) {
        const from = t.view.scrollTop;
        const to = ys[i];
        // 次の区切りへ半分ちょっと進めたところで手を離す
        const release = from + (to - from) * 0.55;
        await t.scrollTo(release, 450);
        if (tuneStr(root, 'snap', 'mandatory') === 'proximity' && Math.abs(to - release) > h * 0.3) {
          // proximity: 区切りから遠いので吸い付かず、その場で止まる。もう一度送ると吸い付く
          await t.sleep(1300);
          await t.scrollTo(to - (to - release) * 0.25, 400);
        }
        await t.scrollTo(to, 280);
        await t.sleep(1300);
      }
      await t.scrollTo(0, 800);
      await t.sleep(300);
    });
  });
</script>
