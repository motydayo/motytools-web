---
import UgFrame from '../UgFrame.astro';
import Scene from '../Scene.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
const A = size === 'mini' ? 'span' : 'a';
const href = size === 'mini' ? undefined : '#';
// 見本の中の文字（日英）
const L = {
  ja: {
    name: '下線アニメーション',
    focus: '下線がのびる',
    menu: ['ホーム', 'サービス', '料金', 'お問い合わせ'],
    h: '秋の宿泊プランを公開しました',
    p: ['紅葉が見ごろの10月下旬から、朝食つきのプランを始めます。くわしくは', 'プランの一覧', 'をご覧ください。'],
  },
  en: {
    name: 'Underline animation',
    focus: 'Underline grows',
    menu: ['Home', 'Services', 'Pricing', 'Contact'],
    h: 'Our fall packages are here',
    p: ['From late October, when the leaves peak, every stay includes breakfast. See ', 'all packages', ' for dates and rates.'],
  },
}[lang as 'ja' | 'en'];
---

<UgFrame mode="pointer" size={size} label={L.name} lang={lang}>
  <div class="ug-site page" data-demo="underline">
    <header class="bar">
      <span class="ug-logo">SAMPLE</span>
      <nav class="menu" data-ug-focus={L.focus} data-ug-focus-at="below">
        <A class="ul is-current" href={href} aria-current={size === 'mini' ? undefined : 'page'}>{L.menu[0]}</A>
        <A class="ul" href={href} data-ug-target>{L.menu[1]}</A>
        <A class="ul" href={href} data-ug-target>{L.menu[2]}</A>
        <A class="ul hide-s" href={href}>{L.menu[3]}</A>
      </nav>
    </header>
    <section class="body">
      <div class="text">
        <p class="ug-label">NEWS</p>
        <h3 class="ug-h">{L.h}</h3>
        <p class="p">{L.p[0]}<A class="ul in" href={href} data-ug-target>{L.p[1]}</A>{L.p[2]}</p>
      </div>
      <div class="pic"><Scene tone="sunset" /></div>
    </section>
  </div>
</UgFrame>

<style>
  .page { min-height: 100%; display: flex; flex-direction: column; }
  .bar { display: flex; align-items: center; gap: 16px; height: 56px; padding: 0 20px; border-bottom: 1px solid var(--ug-line); background: #fff; }
  .menu { position: relative; display: flex; gap: 20px; margin-right: -8px; padding: 6px 8px 10px; font-size: 13px; font-weight: 700; }
  .body { flex: 1; display: grid; grid-template-columns: 1.3fr 1fr; align-items: center; gap: 24px; padding: 32px 20px; }
  .p { font-size: 13px; line-height: 1.9; color: var(--ug-ink-2); }
  .pic { border-radius: 12px; overflow: hidden; }

  .ul {
    position: relative;
    color: var(--ug-ink);
    text-decoration: none;
    cursor: pointer;
  }
  .ul::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    /* 線の太さ・文字との間・のびる速さはつまみ（--t-thick・--t-offset・--t-dur）から */
    bottom: calc(var(--t-offset) * -1);
    height: var(--t-thick);
    border-radius: var(--t-thick);
    background: var(--ug-orange);
    /* これが演出の本体: ふだんは幅0。乗せると左からのびる */
    transform: scaleX(0);
    transform-origin: right; /* 離れるときは右へ縮んで消える */
    transition: transform var(--t-dur) ease-out;
  }
  .ul.is-hover::after,
  .ul:focus-visible::after,
  .ul.is-current::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  @media (hover: hover) {
    .ul:hover::after { transform: scaleX(1); transform-origin: left; }
  }
  /* いまいるページは、ホバーとは別の色で下線を出しっぱなしにする */
  .ul.is-current::after { background: var(--ug-navy); }
  .ul:focus-visible { outline: 2px solid var(--ug-blue); outline-offset: 4px; border-radius: 2px; }
  /* 文中のリンクは色で見分けがつくようにしておく（下線が無い間もリンクだと分かる） */
  .in { color: var(--ug-blue); font-weight: 700; }
  .in::after { background: var(--ug-blue); }

  @container (max-width: 340px) {
    .bar { height: 48px; padding: 0 12px; gap: 12px; }
    .menu { gap: 10px; margin-right: -6px; padding: 6px 6px 10px; font-size: 11px; }
    .hide-s { display: none; }
    .body { grid-template-columns: 1fr; gap: 16px; padding: 20px 12px; }
  }
  :global(.is-mini) .pic, :global(.is-mini) .ug-label { display: none; }
  :global(.is-mini) .body { padding: 16px 12px; }
  :global(.is-mini) .ug-h { font-size: 14px; }
  :global(.is-mini) .p { font-size: 12px; line-height: 1.8; }
  @media (prefers-reduced-motion: reduce) {
    .ul::after { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-demo="underline"] a.ul').forEach((a) => a.addEventListener('click', (e) => e.preventDefault()));
</script>
