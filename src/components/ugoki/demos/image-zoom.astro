---
import UgFrame from '../UgFrame.astro';
import Scene from '../Scene.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
const Card = size === 'mini' ? 'span' : 'a';
// 見本の中の文字（日英）
const L = {
  ja: {
    name: 'ホバーで画像ズーム',
    focus: '画像だけ拡大',
    nav: ['実績', '会社概要'],
    cta: '相談する',
    h: '制作実績',
    works: [['海辺のカフェ', '店舗デザイン'], ['高原のホテル', 'Webサイト'], ['星空ツアー', 'パンフレット']],
  },
  en: {
    name: 'Image zoom on hover',
    focus: 'Only the image zooms',
    nav: ['Work', 'About'],
    cta: 'Contact',
    h: 'Selected work',
    works: [['Beach Café', 'Interior design'], ['Highland Hotel', 'Website'], ['Night Sky Tours', 'Brochure']],
  },
}[lang as 'ja' | 'en'];
const tones = ['sunset', 'day', 'night'] as const;
---

<UgFrame mode="pointer" size={size} label={L.name} lang={lang}>
  <div class="ug-site page">
    <header class="ug-nav nav"><span class="ug-logo">SAMPLE</span>{L.nav.map((n) => <span>{n}</span>)}<span class="ug-cta">{L.cta}</span></header>
    <section class="ug-sec body">
      <div class="head">
        <p class="ug-label">WORKS</p>
        <h3 class="ug-h">{L.h}</h3>
      </div>
      <div class="grid" data-ug-focus={L.focus} data-ug-focus-at="below">
        {L.works.map(([name, tag], i) => (
          <Card class="item" href={size === 'mini' ? undefined : '#'} data-ug-target>
            <span class="pic"><Scene tone={tones[i]} /></span>
            <span class="cap"><b>{name}</b><small>{tag}</small></span>
          </Card>
        ))}
      </div>
    </section>
  </div>
</UgFrame>

<style>
  .page { min-height: 100%; display: flex; flex-direction: column; }
  .body { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 12px; }
  .grid { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 0 -8px 20px; padding: 8px 8px 10px; }
  .item { display: block; color: inherit; text-decoration: none; cursor: pointer; }
  /* 枠（はみ出しを隠す）と、中の絵 */
  .pic { display: block; overflow: hidden; border-radius: 10px; background: var(--ug-sky); }
  .pic :global(.ug-scene) {
    aspect-ratio: 4 / 3;
    /* これが演出の本体: 枠はそのままで、中の絵だけを大きくする。数値はつまみ（--t-*）から */
    transition: transform var(--t-dur) ease-out;
  }
  .item.is-hover .pic :global(.ug-scene),
  .item:focus-visible .pic :global(.ug-scene) { transform: scale(var(--t-scale)); }
  @media (hover: hover) {
    .item:hover .pic :global(.ug-scene) { transform: scale(var(--t-scale)); }
  }
  .item:focus-visible { outline: none; }
  .item:focus-visible .pic { outline: 2px solid var(--ug-blue); outline-offset: 2px; }
  .cap { display: block; padding: 8px 2px 0; font-size: 12px; line-height: 1.5; }
  .cap small { display: block; font-size: 10px; color: var(--ug-ink-2); }
  /* 枠が狭いときは2枚に。一覧の小さな見本では写真だけを見せる */
  @container (max-width: 340px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-bottom: 18px; padding: 6px 8px 8px; }
    .item:nth-child(3) { display: none; }
  }
  :global(.is-mini) .nav, :global(.is-mini) .head { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .pic :global(.ug-scene) { transition: none; }
    .item.is-hover .pic :global(.ug-scene),
    .item:hover .pic :global(.ug-scene),
    .item:focus-visible .pic :global(.ug-scene) { transform: none; }
    .item.is-hover .pic, .item:hover .pic { filter: brightness(0.92); }
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a.item').forEach((a) => a.addEventListener('click', (e) => e.preventDefault()));
</script>
