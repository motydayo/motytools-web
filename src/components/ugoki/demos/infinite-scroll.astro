---
import UgFrame from '../UgFrame.astro';
import Scene from '../Scene.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
const tones = ['day', 'sunset', 'night'] as const;
// 見本の中の文字（日英）
const L = {
  ja: {
    name: '無限スクロール',
    logo: '旅のよみもの',
    nav: ['特集', '地域'],
    cta: '会員登録',
    title: '新着記事',
    shown: ['表示中', '件'],
    meta: (i: number) => `10月${15 - (i % 14)}日・${3 + (i % 4)}分で読めます`,
    loading: '続きを読み込み中',
    end: 'すべての記事を表示しました',
    foot: ['運営会社', 'お問い合わせ', 'プライバシー'],
    posts: [
      '紅葉が見ごろの露天風呂 5選',
      '日帰りで行ける高原の牧場',
      '雨の日でも楽しめる港町の歩き方',
      '星がよく見える山小屋の泊まり方',
      '朝市で買いたい海の幸ガイド',
      '子ども連れで行く渓谷キャンプ',
      'ローカル線で巡る温泉街',
      '冬の岬で見る日の出',
      'ひとり旅に向いた湖畔の宿',
      '地元の人に聞いた棚田の撮り方',
      '吊り橋と滝をめぐる半日コース',
      '夕日がきれいな海辺のカフェ',
      '雪見風呂のある小さな宿',
      '秋祭りに合わせて泊まる城下町',
      '森の中のサウナ付きコテージ',
      '灯台のある島へ船で渡る',
      '週末に行ける山のパン屋さん',
    ],
  },
  en: {
    name: 'Infinite scroll',
    logo: 'Wander Weekly',
    nav: ['Features', 'Places'],
    cta: 'Sign up',
    title: 'Latest stories',
    shown: ['Showing', ''],
    meta: (i: number) => `Oct ${15 - (i % 14)} · ${3 + (i % 4)} min read`,
    loading: 'Loading more stories',
    end: 'You’re all caught up',
    foot: ['About', 'Contact', 'Privacy'],
    posts: [
      '5 hot springs at peak fall color',
      'A day trip to a highland ranch',
      'Rainy-day walks in a harbor town',
      'Stargazing from a mountain hut',
      'What to buy at the morning fish market',
      'Canyon camping with kids',
      'Hot spring towns by local train',
      'Winter sunrise from the cape',
      'Lakeside inns for solo travelers',
      'How locals photograph rice terraces',
      'A half-day loop of bridges and falls',
      'Seaside cafés with the best sunsets',
      'Small inns with snow-view baths',
      'Castle towns during the fall festival',
      'Forest cabins with a private sauna',
      'Taking the ferry to a lighthouse island',
      'Mountain bakeries worth a weekend drive',
    ],
  },
}[lang as 'ja' | 'en'];
const FIRST = 6; // 最初に表示する件数
---

<UgFrame mode="scroll" size={size} label={L.name} lang={lang}>
  <div class="ug-site" data-demo="infinite-scroll" data-first={FIRST} data-step="4">
    <header class="ug-nav"><span class="ug-logo">{L.logo}</span>{L.nav.map((n) => <span>{n}</span>)}<span class="ug-cta">{L.cta}</span></header>
    <div class="is-head">
      <h3 class="is-title">{L.title}</h3>
      <span class="is-count">{L.shown[0]} <b data-is-count>{FIRST}</b>{L.shown[1]}</span>
    </div>
    <ul class="is-list">
      {L.posts.map((title, i) => (
        <li class="is-item" data-is-item hidden={i >= FIRST}>
          <Scene tone={tones[i % 3]} class="is-thumb" />
          <span class="is-text">
            <span class="is-name">{title}</span>
            <span class="is-meta">{L.meta(i)}</span>
          </span>
        </li>
      ))}
    </ul>
    <!-- これが演出の本体: 下端の見張り役。見えたら続きを読み込んで足す -->
    <div class="is-more" data-is-sentinel data-ug-focus={L.name}>
      <span class="is-loading" data-is-loading>
        <span class="is-spin" aria-hidden="true"></span>
        {L.loading}
      </span>
      <span class="is-end" data-is-end>{L.end}</span>
    </div>
    <footer class="is-foot" data-is-foot>
      <span class="ug-logo">{L.logo}</span>
      <span class="is-foot-links">{L.foot.map((f) => <span>{f}</span>)}</span>
    </footer>
  </div>
</UgFrame>

<style>
  .is-head {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.94);
    border-bottom: 1px solid var(--ug-line);
  }
  .is-title { font-size: 15px; font-weight: 800; }
  .is-count { font-size: 11px; color: var(--ug-ink-2); font-variant-numeric: tabular-nums; }
  .is-count b { color: var(--ug-orange); font-size: 13px; }
  .is-list { list-style: none; margin: 0; padding: 0 16px; }
  .is-item { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--ug-line); }
  .is-item[hidden] { display: none; }
  .is-item :global(.is-thumb) { flex: none; width: 72px; height: 48px; border-radius: 6px; aspect-ratio: auto; }
  .is-text { display: grid; gap: 2px; min-width: 0; }
  .is-name { font-size: 13px; font-weight: 700; line-height: 1.45; }
  .is-meta { font-size: 10px; color: var(--ug-ink-2); }
  /* 足された記事は、下から少し持ち上げて出す。速さと距離はつまみ（--t-dur・--t-rise）から */
  .is-item.is-new { animation: is-in var(--t-dur) ease-out both; }
  @keyframes is-in { from { opacity: 0; transform: translateY(var(--t-rise)); } }

  .is-more {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 72px;
    padding: 16px;
    font-size: 12px;
    font-weight: 700;
    color: var(--ug-ink-2);
  }
  .is-loading, .is-end { display: none; align-items: center; gap: 8px; }
  .is-more.is-busy .is-loading { display: inline-flex; }
  .is-more.is-done .is-end { display: inline-flex; }
  .is-spin {
    width: 16px;
    height: 16px;
    border: 2px solid var(--ug-line);
    border-top-color: var(--ug-orange);
    border-radius: 50%;
    animation: is-spin 0.8s linear infinite;
  }
  @keyframes is-spin { to { transform: rotate(1turn); } }

  /* フッターは「最後まで読み込んだあと」でないと届かない */
  .is-foot { display: none; align-items: center; justify-content: space-between; gap: 12px; padding: 24px 16px 32px; background: var(--ug-navy); color: #fff; font-size: 11px; }
  .is-foot .ug-logo { margin-right: 0; }
  .is-foot-links { display: inline-flex; gap: 12px; color: rgba(255, 255, 255, 0.7); }
  .is-foot.is-shown { display: flex; }

  @container (max-width: 340px) {
    .is-head { padding: 8px 12px; }
    .is-list { padding: 0 12px; }
    .is-item { gap: 8px; padding: 8px 0; }
    .is-item :global(.is-thumb) { width: 56px; height: 40px; }
    .is-name { font-size: 12px; }
    .is-foot-links span:nth-child(n + 2) { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-item.is-new { animation: none; }
    .is-spin { animation-duration: 2.4s; }
  }
</style>

<script>
  import { onTour, onTune, tuneNum } from '../../../lib/ugoki/runtime';

  document.querySelectorAll<HTMLElement>('[data-demo="infinite-scroll"]').forEach((root) => {
    const view = root.closest<HTMLElement>('[data-ug-view]');
    const sentinel = root.querySelector<HTMLElement>('[data-is-sentinel]');
    const count = root.querySelector<HTMLElement>('[data-is-count]');
    const foot = root.querySelector<HTMLElement>('[data-is-foot]');
    if (!view || !sentinel || !count || !foot) return;
    const items = [...root.querySelectorAll<HTMLElement>('[data-is-item]')];
    const first = Number(root.dataset.first);
    const step = Number(root.dataset.step);
    let shown = first;
    let busy = false;
    let timer = 0;

    const done = () => shown >= items.length;

    // 続きを読み込む（見本では通信に0.9秒かかる想定で、隠しておいた記事を4件ずつ出す）
    const loadMore = () => {
      if (busy || done()) return;
      busy = true;
      sentinel.classList.add('is-busy');
      timer = window.setTimeout(() => {
        items.slice(shown, shown + step).forEach((el) => {
          el.hidden = false;
          el.classList.add('is-new');
        });
        shown = Math.min(items.length, shown + step);
        count.textContent = String(shown);
        busy = false;
        sentinel.classList.remove('is-busy');
        if (done()) {
          io?.disconnect();
          sentinel.classList.add('is-done');
          foot.classList.add('is-shown');
        } else {
          // 足したあとも見張り役が見えたままなら、もう一度読み込む
          io?.unobserve(sentinel);
          io?.observe(sentinel);
        }
      }, 900);
    };

    // 下端の何px手前で読み込み始めるか（つまみ --t-margin）。変わったら見張りを作り直す
    let io: IntersectionObserver | null = null;
    const watch = () => {
      io?.disconnect();
      io = new IntersectionObserver((entries) => entries[0].isIntersecting && loadMore(), {
        root: view,
        rootMargin: `0px 0px ${tuneNum(root, 'margin', 200)}px 0px`,
      });
      if (!done()) io.observe(sentinel);
    };
    watch();
    // つまみが動いたら見張りを作り直し、最後に足した記事の出方をもう一度見せる
    let replay = 0;
    onTune(view, () => {
      watch();
      clearTimeout(replay);
      replay = window.setTimeout(() => {
        const last = items.slice(Math.max(first, shown - step), shown);
        last.forEach((el) => el.classList.remove('is-new'));
        void root.offsetWidth;
        last.forEach((el) => el.classList.add('is-new'));
      }, 450);
    });

    const reset = () => {
      clearTimeout(timer);
      busy = false;
      shown = first;
      items.forEach((el, i) => {
        el.hidden = i >= first;
        el.classList.remove('is-new');
      });
      count.textContent = String(first);
      sentinel.classList.remove('is-busy', 'is-done');
      foot.classList.remove('is-shown');
      watch();
    };
    reset();
    view.addEventListener('ug:reset', reset);

    onTour(root, async (t) => {
      t.showCursor(false);
      t.view.scrollTop = 0;
      reset();
      await t.sleep(1000);
      while (!done()) {
        await t.scrollTo(t.view.scrollHeight - t.view.clientHeight, 1100);
        await t.sleep(1700); // 「読み込み中」→ 記事が足されるのを見せる
      }
      await t.scrollTo(t.view.scrollHeight - t.view.clientHeight, 900);
      await t.sleep(1600);
      await t.scrollTo(0, 1000);
      await t.sleep(500);
    });
  });
</script>
