---
import UgFrame from '../UgFrame.astro';
const { size = 'full' } = Astro.props;
---

<UgFrame mode="loop" size={size} label="グラデーションアニメーション" url="nagare-app.jp">
  <div class="ug-site ag-site">
    <header class="ug-nav"><span class="ug-logo">ナガレ</span><span>機能</span><span>料金</span><span class="ug-cta">無料で試す</span></header>
    <!-- これが演出の本体: 大きなグラデーションの背景を、ゆっくり左右に動かし続ける -->
    <section class="ag-hero ug-pausable" data-ug-focus="グラデーションアニメーション">
      <p class="ag-kicker">チームの予定表アプリ</p>
      <h3 class="ag-title">予定のすり合わせを、<br />1日5分に。</h3>
      <p class="ag-sub">カレンダーを重ねるだけで、全員の空き時間が見つかります。</p>
      <span class="ag-btn">14日間 無料で試す</span>
    </section>
    <section class="ag-points">
      <div class="ag-point"><b>3分</b><span>はじめての設定</span></div>
      <div class="ag-point"><b>40社</b><span>先行導入</span></div>
      <div class="ag-point"><b>0円</b><span>5人まで無料</span></div>
    </section>
    <section class="ug-sec">
      <div class="ug-lines"><i></i><i></i><i></i></div>
    </section>
  </div>
</UgFrame>

<style>
  .ag-hero {
    position: relative;
    padding: 40px 24px 36px;
    color: #fff;
    /* 色を多めに並べた帯を3倍の大きさで敷き、見える位置を動かす */
    background: linear-gradient(120deg, #1d2541, #4f73d9, #b4467a, #f06a35, #4f73d9, #1d2541);
    background-size: 300% 300%;
    animation: ag-shift 8s ease-in-out infinite alternate;
  }
  /* 白い文字が読めるよう、薄い暗幕を1枚かぶせる */
  .ag-hero::before { content: ''; position: absolute; inset: 0; background: rgba(20, 24, 45, 0.28); pointer-events: none; }
  .ag-hero > * { position: relative; }
  @keyframes ag-shift {
    from { background-position: 0% 50%; }
    to { background-position: 100% 50%; }
  }
  .ag-kicker { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; opacity: 0.9; }
  .ag-title { margin: 6px 0 8px !important; font-size: 26px; font-weight: 800; line-height: 1.3 !important; }
  .ag-sub { font-size: 12px; opacity: 0.92; }
  .ag-btn { display: inline-flex; align-items: center; min-height: 40px; margin-top: 16px; padding: 0 20px; border-radius: 999px; background: #fff; color: var(--ug-navy); font-size: 13px; font-weight: 800; }
  .ag-points { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; padding: 20px 16px 0; }
  .ag-point { display: grid; gap: 2px; padding: 12px; border: 1px solid var(--ug-line); border-radius: 10px; text-align: center; }
  .ag-point b { font-size: 20px; font-weight: 800; color: var(--ug-ink); font-variant-numeric: tabular-nums; }
  .ag-point span { font-size: 10px; color: var(--ug-ink-2); }

  @container (max-width: 340px) {
    .ag-hero { padding: 20px 16px 20px; }
    .ag-kicker { font-size: 10px; }
    .ag-title { font-size: 19px; margin: 4px 0 6px !important; }
    .ag-sub { display: none; }
    .ag-btn { min-height: 32px; margin-top: 8px; padding: 0 14px; font-size: 11px; }
  }
  /* 動きを減らす設定なら、止まったグラデーションにする */
  @media (prefers-reduced-motion: reduce) {
    .ag-hero { animation: none; background-position: 30% 50%; }
  }
</style>
