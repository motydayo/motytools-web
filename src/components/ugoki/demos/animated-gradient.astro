---
import UgFrame from '../UgFrame.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
// 見本の中の文字（日英）
const L = {
  ja: {
    name: 'グラデーションアニメーション',
    url: 'nagare-app.jp',
    logo: 'ナガレ',
    nav: ['機能', '料金'],
    cta: '無料で試す',
    kicker: 'チームの予定表アプリ',
    title: ['予定のすり合わせを、', '1日5分に。'],
    sub: 'カレンダーを重ねるだけで、全員の空き時間が見つかります。',
    btn: '14日間 無料で試す',
    points: [['3分', 'はじめての設定'], ['40社', '先行導入'], ['0円', '5人まで無料']],
  },
  en: {
    name: 'Animated gradient',
    url: 'flowcal.app',
    logo: 'Flowcal',
    nav: ['Features', 'Pricing'],
    cta: 'Start free',
    kicker: 'SHARED TEAM CALENDAR',
    title: ['Schedule your team', 'in five minutes a day.'],
    sub: 'Overlay everyone’s calendars and the open slots appear.',
    btn: 'Start 14-day free trial',
    points: [['3 min', 'to set up'], ['40', 'early teams'], ['$0', 'up to 5 seats']],
  },
}[lang as 'ja' | 'en'];
---

<UgFrame mode="loop" size={size} label={L.name} url={L.url} lang={lang}>
  <div class="ug-site ag-site">
    <header class="ug-nav"><span class="ug-logo">{L.logo}</span>{L.nav.map((n) => <span>{n}</span>)}<span class="ug-cta">{L.cta}</span></header>
    <!-- これが演出の本体: 大きなグラデーションの背景を、ゆっくり左右に動かし続ける -->
    <section class="ag-hero ug-pausable" data-ug-focus={L.name}>
      <p class="ag-kicker">{L.kicker}</p>
      <h3 class="ag-title">{L.title[0]}<br />{L.title[1]}</h3>
      <p class="ag-sub">{L.sub}</p>
      <span class="ag-btn">{L.btn}</span>
    </section>
    <section class="ag-points">
      {L.points.map(([b, s]) => <div class="ag-point"><b>{b}</b><span>{s}</span></div>)}
    </section>
    <section class="ug-sec">
      <div class="ug-lines"><i></i><i></i><i></i></div>
    </section>
  </div>
</UgFrame>

<style>
  .ag-hero {
    position: relative;
    padding: 40px 24px 36px;
    color: #fff;
    /* 色を並べた帯を3倍の大きさで敷き、見える位置を動かす。2色はつまみ（--t-c1・--t-c2）から */
    background: linear-gradient(120deg, #1d2541, var(--t-c1), var(--t-c2), var(--t-c1), #1d2541);
    background-size: 300% 300%;
    animation: ag-shift var(--t-dur) ease-in-out infinite alternate;
  }
  /* oklch で混ぜると、2色の間がにごらず鮮やかにつながる（対応ブラウザだけ） */
  @supports (background: linear-gradient(in oklch, red, blue)) {
    .ag-hero { background-image: linear-gradient(120deg in oklch, #1d2541, var(--t-c1), var(--t-c2), var(--t-c1), #1d2541); }
  }
  /* 白い文字が読めるよう、薄い暗幕を1枚かぶせる。濃さはつまみ（--t-dim）から */
  .ag-hero::before { content: ''; position: absolute; inset: 0; background: rgba(20, 24, 45, var(--t-dim)); pointer-events: none; }
  .ag-hero > * { position: relative; }
  @keyframes ag-shift {
    from { background-position: 0% 50%; }
    to { background-position: 100% 50%; }
  }
  .ag-kicker { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; opacity: 0.9; }
  .ag-title { margin: 6px 0 8px !important; font-size: 26px; font-weight: 800; line-height: 1.3 !important; }
  .ag-sub { font-size: 12px; opacity: 0.92; }
  .ag-btn { display: inline-flex; align-items: center; min-height: 40px; margin-top: 16px; padding: 0 20px; border-radius: 999px; background: #fff; color: var(--ug-navy); font-size: 13px; font-weight: 800; }
  .ag-points { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; padding: 20px 16px 0; }
  .ag-point { display: grid; gap: 2px; padding: 12px; border: 1px solid var(--ug-line); border-radius: 10px; text-align: center; }
  .ag-point b { font-size: 20px; font-weight: 800; color: var(--ug-ink); font-variant-numeric: tabular-nums; }
  .ag-point span { font-size: 10px; color: var(--ug-ink-2); }

  @container (max-width: 340px) {
    .ag-hero { padding: 20px 16px 20px; }
    .ag-kicker { font-size: 10px; }
    .ag-title { font-size: 19px; margin: 4px 0 6px !important; }
    .ag-sub { display: none; }
    .ag-btn { min-height: 32px; margin-top: 8px; padding: 0 14px; font-size: 11px; }
  }
  /* 動きを減らす設定なら、止まったグラデーションにする */
  @media (prefers-reduced-motion: reduce) {
    .ag-hero { animation: none; background-position: 30% 50%; }
  }
</style>
