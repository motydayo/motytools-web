---
import UgFrame from '../UgFrame.astro';
import Scene from '../Scene.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
const Btn = size === 'mini' ? 'span' : 'button';
const tones = ['day', 'sunset', 'night', 'day'] as const;
// 見本の中の文字（日英）
const L = {
  ja: {
    name: 'スケルトンスクリーン',
    nav: ['宿をさがす', '特集'],
    cta: 'ログイン',
    h: '今週のおすすめ',
    reload: '更新',
    reloadLabel: 'もう一度読み込む',
    loading: 'おすすめの宿を読み込んでいます',
    done: 'おすすめの宿を4件表示しました',
    items: [
      { name: '山の宿 はなれ', meta: '長野県・露天風呂つき', price: '1泊 12,000円〜' },
      { name: '海の宿 しおさい', meta: '静岡県・海が見える部屋', price: '1泊 15,000円〜' },
      { name: '星の宿 そらの', meta: '岐阜県・天体観測つき', price: '1泊 9,800円〜' },
      { name: '森の宿 こもれび', meta: '群馬県・ペット可', price: '1泊 11,500円〜' },
    ],
  },
  en: {
    name: 'Skeleton screen',
    nav: ['Find a stay', 'Guides'],
    cta: 'Sign in',
    h: 'Top picks this week',
    reload: 'Refresh',
    reloadLabel: 'Reload the list',
    loading: 'Loading top picks',
    done: 'Showing 4 top picks',
    items: [
      { name: 'Pinecrest Mountain Lodge', meta: 'Aspen, CO · Private hot tub', price: 'From $129 / night' },
      { name: 'Driftwood Seaside Inn', meta: 'Carmel, CA · Ocean view', price: 'From $165 / night' },
      { name: 'Stargazer Cabins', meta: 'Moab, UT · Dark-sky site', price: 'From $98 / night' },
      { name: 'Hollow Creek Retreat', meta: 'Asheville, NC · Pet friendly', price: 'From $119 / night' },
    ],
  },
}[lang as 'ja' | 'en'];
---

<UgFrame mode="script" size={size} label={L.name} lang={lang}>
  <div class="ug-site sk" data-demo="skeleton" data-loading={L.loading} data-done={L.done}>
    <header class="ug-nav"><span class="ug-logo">SAMPLE</span>{L.nav.map((n) => <span>{n}</span>)}<span class="ug-cta">{L.cta}</span></header>
    <section class="body">
      <div class="head">
        <h3 class="ug-h">{L.h}</h3>
        <Btn class="reload" type={size === 'mini' ? undefined : 'button'} aria-label={size === 'mini' ? undefined : L.reloadLabel}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7" /><path d="M21 4v5h-5" /></svg>
          <span>{L.reload}</span>
        </Btn>
      </div>
      <!-- 読み込み中は is-loading。同じ部品を灰色の骨組みとして見せるので、差し替わっても位置がずれない -->
      <ul class="list is-loading" aria-busy="true" data-ug-focus={L.name} data-ug-focus-at="below">
        {L.items.map((it, i) => (
          <li class="item" style={`--i:${i}`}>
            <div class="thumb"><Scene tone={tones[i]} /></div>
            <div class="txt">
              <p class="t">{it.name}</p>
              <p class="m">{it.meta}</p>
              <p class="p">{it.price}</p>
            </div>
          </li>
        ))}
      </ul>
      <p class="sr-only" role="status" data-status>{L.loading}</p>
    </section>
  </div>
</UgFrame>

<style>
  .body { padding: 16px; }
  .head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
  .head .ug-h { margin: 0; }
  .reload {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 32px;
    padding: 0 12px;
    border: 1px solid var(--ug-line);
    border-radius: 999px;
    background: #fff;
    color: var(--ug-ink-2);
    font: inherit;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.15s, transform 0.15s;
  }
  .reload:hover, .reload.is-hover { background: var(--ug-bg); }
  .reload:active { transform: scale(0.96); }
  .reload:focus-visible { outline: 2px solid var(--ug-blue); outline-offset: 2px; }

  .list { position: relative; list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .item { display: grid; grid-template-columns: 96px 1fr; gap: 12px; align-items: center; }
  .thumb { border-radius: 8px; overflow: hidden; aspect-ratio: 16 / 10; }
  .txt { display: grid; gap: 4px; min-width: 0; }
  .txt p { margin: 0; line-height: 18px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .t { font-weight: 800; font-size: 14px; }
  .m { font-size: 11px; color: var(--ug-ink-2); }
  .p { font-size: 12px; font-weight: 700; color: var(--ug-orange); }

  /* ── 読み込み中: 文字と絵を透明にして、同じ場所を灰色の帯にする ── */
  .is-loading .thumb,
  .is-loading .txt p {
    color: transparent;
    border-radius: 6px;
    background: linear-gradient(90deg, #ecebe7 0%, #ecebe7 40%, #f7f6f3 50%, #ecebe7 60%, #ecebe7 100%);
    background-size: 300% 100%;
    /* 光の帯が左から右へ流れて「読み込み中」と伝える。1周の時間はつまみ（--t-shimmer）から */
    animation: sk-shimmer var(--t-shimmer) linear infinite;
  }
  .is-loading .thumb > :global(*) { opacity: 0; }
  .is-loading .t { width: 72%; }
  .is-loading .m { width: 52%; }
  .is-loading .p { width: 34%; }
  @keyframes sk-shimmer {
    from { background-position: 100% 0; }
    to { background-position: 0 0; }
  }
  /* ── 読み込み完了: 中身をふわっと出す（カードごとに --t-stagger ずつ遅らせる） ── */
  .list:not(.is-loading) .item > * {
    animation: sk-in var(--t-fade) ease-out both;
    animation-delay: calc(var(--i, 0) * var(--t-stagger));
  }
  @keyframes sk-in {
    from { opacity: 0; }
  }
  @container (max-width: 340px) {
    .item { grid-template-columns: 80px 1fr; }
    .reload span { display: none; }
  }
  :global(.is-mini) .body { padding: 12px 16px; }
  :global(.is-mini) .list { gap: 8px; }
  @media (prefers-reduced-motion: reduce) {
    .is-loading .thumb, .is-loading .txt p { animation: none; }
    .list:not(.is-loading) .item > * { animation: none; }
  }
</style>

<script>
  import { onTour, onTune } from '../../../lib/ugoki/runtime';

  document.querySelectorAll<HTMLElement>('[data-demo="skeleton"]').forEach((root) => {
    const view = root.closest<HTMLElement>('[data-ug-view]');
    const list = root.querySelector<HTMLElement>('.list');
    const reload = root.querySelector<HTMLElement>('.reload');
    const status = root.querySelector<HTMLElement>('[data-status]');
    if (!view || !list || !reload || !status) return;
    let timer = 0;

    const setLoading = (on: boolean) => {
      list.classList.toggle('is-loading', on);
      list.setAttribute('aria-busy', String(on));
      status.textContent = (on ? root.dataset.loading : root.dataset.done) ?? '';
    };
    // 本物のサイトでは、ここで fetch してから中身を入れる。見本は1.6秒待つだけ
    const load = () => {
      clearTimeout(timer);
      setLoading(true);
      timer = window.setTimeout(() => setLoading(false), 1600);
    };

    reload.addEventListener('click', load);
    reload.addEventListener('ug:click', load);
    view.addEventListener('ug:reset', load);
    load();
    // つまみを動かしたら読み込みからやり直して、光の筋と出方の違いを見せる
    let tuneTimer = 0;
    onTune(view, () => {
      clearTimeout(tuneTimer);
      tuneTimer = window.setTimeout(load, 300);
    });

    onTour(root, async (t) => {
      load();
      t.showCursor(false);
      await t.sleep(3800);
      await t.move(reload, 700);
      t.hover(reload);
      await t.sleep(200);
      await t.click(reload);
      t.hover(null);
      await t.move({ x: t.view.clientWidth * 0.7, y: t.view.clientHeight * 0.92 }, 600);
      await t.sleep(3600);
    });
  });
</script>
