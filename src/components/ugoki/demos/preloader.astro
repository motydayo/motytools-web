---
import UgFrame from '../UgFrame.astro';
import Scene from '../Scene.astro';
const { size = 'full' } = Astro.props;
// 一覧の小さな見本は外側がリンクなので、中に押せる要素を置かない（span で代用）
const Btn = size === 'mini' ? 'span' : 'button';
const btnAttrs = size === 'mini' ? {} : { type: 'button' };
---

<UgFrame mode="script" size={size} label="ローディング画面" url="yama-no-yado.jp">
  <div class="ug-site pl-site" data-demo="preloader">
    <header class="ug-nav"><span class="ug-logo">山の宿</span><span>客室</span><span>料理</span><span class="ug-cta">予約する</span></header>
    <section class="pl-hero">
      <Scene tone="sunset" wide class="pl-bg" />
      <div class="pl-copy">
        <p class="pl-kicker">WELCOME</p>
        <h3 class="pl-title">湖のほとりで、<br />何もしない休日を。</h3>
        <p class="pl-price">1泊2食 18,000円〜</p>
      </div>
    </section>
    <section class="pl-rooms">
      <div class="ug-card"><Scene tone="day" /><div class="ug-card-body">和室</div></div>
      <div class="ug-card"><Scene tone="night" /><div class="ug-card-body">露天風呂付き</div></div>
      <div class="ug-card"><Scene tone="sunset" /><div class="ug-card-body">湖側の洋室</div></div>
    </section>

    <Btn {...btnAttrs} class="pl-reload" data-reload>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7" /><path d="M21 4v5h-5" /></svg>
      もう一度読み込む
    </Btn>

    <!-- これが演出の本体: ページの上にかぶせる幕。読み込みが終わったら消す -->
    <div class="pl-loader" data-loader data-ug-focus="ローディング画面" role="status" aria-label="読み込み中">
      <span class="pl-mark" aria-hidden="true"></span>
      <span class="pl-name">山の宿</span>
      <span class="pl-bar" aria-hidden="true"><i></i></span>
      <span class="pl-msg">読み込み中</span>
    </div>
  </div>
</UgFrame>

<style>
  .pl-site { position: relative; height: 100%; overflow: hidden; background: var(--ug-paper); }

  .pl-hero { position: relative; height: 200px; overflow: hidden; }
  .pl-hero :global(.pl-bg) { position: absolute; inset: 0; width: 100%; height: 100%; aspect-ratio: auto; }
  .pl-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(29, 37, 65, 0.62), rgba(29, 37, 65, 0) 75%); }
  .pl-copy { position: relative; z-index: 1; padding: 32px 24px; color: #fff; }
  .pl-kicker { font-size: 10px; font-weight: 800; letter-spacing: 0.14em; color: var(--ug-orange-2); }
  .pl-title { margin: 4px 0 8px !important; font-size: 22px; font-weight: 800; line-height: 1.35 !important; }
  .pl-price { display: inline-block; padding: 2px 10px; border-radius: 999px; background: rgba(255, 255, 255, 0.18); font-size: 12px; font-weight: 700; }
  .pl-rooms { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; padding: 16px; }

  /* ページが出てくるとき、中身を少し下から持ち上げる */
  .pl-copy, .pl-rooms { transition: opacity 0.35s ease-out, transform 0.35s ease-out; }
  .pl-site:not(.is-ready) .pl-copy,
  .pl-site:not(.is-ready) .pl-rooms { opacity: 0; transform: translateY(8px); }

  .pl-reload {
    position: absolute;
    right: 12px;
    bottom: 12px;
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid var(--ug-line);
    border-radius: 999px;
    background: #fff;
    color: var(--ug-ink);
    font: inherit;
    font-size: 12px;
    font-weight: 700;
    box-shadow: 0 6px 16px -8px rgba(29, 37, 65, 0.35);
    cursor: pointer;
  }
  .pl-reload:hover, .pl-reload.is-hover { border-color: var(--ug-ink-2); }
  .pl-reload:active { transform: scale(0.96); }

  /* ── ローディング画面 ── */
  .pl-loader {
    position: absolute;
    inset: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--ug-navy);
    color: #fff;
    /* 消えるときは加速（ease-in）で、すっと引く */
    transition: opacity 0.3s ease-in, visibility 0s linear 0.3s;
  }
  .pl-loader.is-done { opacity: 0; visibility: hidden; }
  .pl-mark { width: 28px; height: 28px; border-radius: 8px; background: var(--ug-orange); animation: pl-pulse 1.2s ease-in-out infinite; }
  .pl-name { font-size: 16px; font-weight: 800; letter-spacing: 0.12em; }
  .pl-bar { width: 140px; height: 4px; border-radius: 2px; background: rgba(255, 255, 255, 0.18); overflow: hidden; }
  .pl-bar i { display: block; width: 0; height: 100%; border-radius: inherit; background: var(--ug-orange); }
  /* 進み具合は分からないので、90%まで「それらしく」進め、終わったら100%にする */
  .pl-loader.is-run .pl-bar i { animation: pl-fill 1.6s cubic-bezier(0.2, 0.7, 0.3, 1) forwards; }
  .pl-loader.is-done .pl-bar i { width: 100%; animation: none; transition: width 0.15s ease-out; }
  .pl-msg { font-size: 11px; color: rgba(255, 255, 255, 0.7); }
  @keyframes pl-fill { to { width: 90%; } }
  @keyframes pl-pulse { 50% { transform: scale(0.82); opacity: 0.7; } }

  @container (max-width: 340px) {
    .pl-hero { height: 148px; }
    .pl-copy { padding: 20px 16px; }
    .pl-title { font-size: 17px; }
    .pl-rooms { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pl-rooms .ug-card:nth-child(3) { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pl-mark { animation: none; }
    .pl-loader.is-run .pl-bar i { animation: none; width: 60%; }
    .pl-copy, .pl-rooms { transition: none; }
  }
</style>

<script>
  import { onTour } from '../../../lib/ugoki/runtime';

  document.querySelectorAll<HTMLElement>('[data-demo="preloader"]').forEach((root) => {
    const view = root.closest<HTMLElement>('[data-ug-view]');
    const loader = root.querySelector<HTMLElement>('[data-loader]');
    const btn = root.querySelector<HTMLElement>('[data-reload]');
    if (!view || !loader || !btn) return;
    let timer = 0;

    // 読み込み完了の合図で幕を消す（見本では1.6秒後に「読み込み完了」とみなす）
    const hide = () => {
      loader.classList.add('is-done');
      root.classList.add('is-ready');
    };
    const play = () => {
      clearTimeout(timer);
      root.classList.remove('is-ready');
      loader.classList.remove('is-done', 'is-run');
      void loader.offsetWidth; // 進むバーのアニメーションを最初からやり直す
      loader.classList.add('is-run');
      timer = window.setTimeout(hide, 1600);
    };

    btn.addEventListener('click', play);
    view.addEventListener('ug:reset', play);

    onTour(root, async (t) => {
      play();
      await t.sleep(1600 + 300 + 2400);
      await t.move(btn, 700);
      t.hover(btn);
      await t.sleep(200);
      await t.click(null); // 押した見た目だけ。次の周の頭で読み込み直す
      await t.sleep(120);
      t.hover(null);
    });
  });
</script>
