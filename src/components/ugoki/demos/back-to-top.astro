---
import UgFrame from '../UgFrame.astro';
import Scene from '../Scene.astro';
const { size = 'full' } = Astro.props;
const mini = size === 'mini';
const Btn = mini ? 'span' : 'button';
---

<UgFrame mode="script" size={size} label="上に戻るボタン">
  <div class="ug-site bt" data-demo="back-to-top">
    <header class="ug-nav"><span class="ug-logo">SAMPLE</span><span>お部屋</span><span>料金</span><span class="ug-cta">予約する</span></header>
    <div class="hero"><Scene tone="day" wide /></div>
    <section class="ug-sec">
      <p class="ug-label">NEWS</p>
      <h3 class="ug-h">お知らせ</h3>
      <div class="ug-lines"><i></i><i></i><i></i></div>
    </section>
    <section class="ug-sec">
      <p class="ug-label">ROOM</p>
      <h3 class="ug-h">お部屋</h3>
      <div class="ug-grid">
        <div class="ug-card"><Scene tone="sunset" /><div class="ug-card-body">和室</div></div>
        <div class="ug-card"><Scene tone="night" /><div class="ug-card-body">洋室</div></div>
        <div class="ug-card"><Scene tone="day" /><div class="ug-card-body">離れ</div></div>
      </div>
    </section>
    <section class="ug-sec">
      <p class="ug-label">PRICE</p>
      <h3 class="ug-h">料金</h3>
      <div class="ug-lines"><i></i><i></i><i></i><i></i><i></i></div>
    </section>
    <section class="ug-sec">
      <p class="ug-label">ACCESS</p>
      <h3 class="ug-h">アクセス</h3>
      <div class="map"><Scene tone="sunset" wide /></div>
      <div class="ug-lines"><i></i><i></i><i></i><i></i></div>
    </section>
    <!-- 枠の右下にくっつける台。本物のサイトでは position: fixed で画面の右下に置く -->
    <div class="dock">
      <Btn class="btt" type={mini ? undefined : 'button'} aria-label={mini ? undefined : 'ページの先頭へ戻る'} data-ug-focus="上に戻る">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
      </Btn>
    </div>
  </div>
</UgFrame>

<style>
  .bt { padding-bottom: 16px; }
  .map { margin: 8px 0; border-radius: 10px; overflow: hidden; }
  /* sticky + bottom で、枠の下端から16pxの位置に居続ける（高さ0の台） */
  .dock { position: sticky; bottom: 16px; height: 0; z-index: 20; }
  .btt {
    position: absolute;
    right: 16px;
    bottom: 0;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: var(--ug-navy);
    color: #fff;
    box-shadow: 0 8px 20px -8px rgba(29, 37, 65, 0.55);
    cursor: pointer;
    /* 隠れているとき: 少し下＋透明。visibility も隠して焦点が行かないようにする */
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition: opacity 0.2s ease-in, transform 0.2s ease-in, visibility 0s linear 0.2s, background-color 0.15s;
  }
  .btt.is-shown {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 0.25s ease-out, transform 0.25s ease-out, visibility 0s, background-color 0.15s;
  }
  .btt:hover, .btt.is-hover { background: var(--ug-blue); }
  .btt:active { transform: scale(0.94); }
  .btt:focus-visible { outline: 3px solid var(--ug-orange); outline-offset: 2px; }
  /* 名札はボタンの左に出す */
  :global(.ug-frame.show-focus) .btt[data-ug-focus]::after { top: 50%; right: calc(100% + 8px); transform: translateY(-50%); }
  :global(.ug-frame.show-focus) .btt[data-ug-focus] { outline-offset: 2px; }
  :global(.is-mini) .dock { bottom: 12px; }
  :global(.is-mini) .btt { width: 40px; height: 40px; right: 12px; }
  @media (prefers-reduced-motion: reduce) {
    .btt, .btt.is-shown { transform: none; }
  }
</style>

<script>
  import { onTour } from '../../../lib/ugoki/runtime';

  const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-demo="back-to-top"]').forEach((root) => {
    const view = root.closest<HTMLElement>('[data-ug-view]');
    const btn = root.querySelector<HTMLElement>('.btt');
    if (!view || !btn) return;

    // 枠の高さの6割ほどスクロールしたら出す
    const sync = () => btn.classList.toggle('is-shown', view.scrollTop > view.clientHeight * 0.6);
    view.addEventListener('scroll', sync, { passive: true });
    sync();

    const goTop = (real: boolean) => {
      view.scrollTo({ top: 0, behavior: reduce() ? 'auto' : 'smooth' });
      // キーボードで押した人のために、焦点もページの先頭（枠）へ移す
      if (real) view.focus({ preventScroll: true });
    };
    btn.addEventListener('click', () => goTop(true));
    btn.addEventListener('ug:click', () => goTop(false));
    view.addEventListener('ug:reset', sync);

    // 一覧の小さな見本は、ボタンが出ている「スクロール済み」の状態から始める（最初の一目で分かるように）
    const mini = Boolean(root.closest('.is-mini'));
    onTour(root, async (t) => {
      t.showCursor(false);
      const h = t.view.clientHeight;
      t.view.scrollTop = mini ? h * 1.6 : 0;
      sync();
      await t.sleep(mini ? 900 : 500);
      if (!mini) {
        await t.scrollTo(h * 0.9, 1000);
        await t.sleep(450);
      }
      await t.scrollTo(h * 1.9, 1000);
      await t.sleep(600);
      await t.move(btn, 650);
      t.hover(btn);
      await t.sleep(250);
      await t.click(btn);
      t.hover(null);
      await t.sleep(1300);
      t.showCursor(false);
      await t.sleep(700);
    });
  });
</script>
