---
import UgFrame from '../UgFrame.astro';
import Scene from '../Scene.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
const mini = size === 'mini';
const Btn = mini ? 'span' : 'button';
// 見本の中の文字（日英）
const L = {
  ja: {
    name: '上に戻るボタン',
    focus: '上に戻る',
    nav: ['お部屋', '料金'],
    cta: '予約する',
    news: 'お知らせ',
    rooms: 'お部屋',
    roomNames: ['和室', '洋室', '離れ'],
    price: '料金',
    access: 'アクセス',
    voice: 'お客さまの声',
    faq: 'よくある質問',
    label: 'ページの先頭へ戻る',
    guide: 'この線が上に消えたらボタンが出る',
  },
  en: {
    name: 'Back to top button',
    focus: 'Back to top',
    nav: ['Rooms', 'Rates'],
    cta: 'Book now',
    news: 'News',
    rooms: 'Rooms',
    roomNames: ['Garden room', 'King suite', 'Private cottage'],
    price: 'Rates',
    access: 'Getting here',
    voice: 'Guest reviews',
    faq: 'FAQ',
    label: 'Back to top',
    guide: 'Button appears once this line scrolls out of view',
  },
}[lang as 'ja' | 'en'];
---

<UgFrame mode="script" size={size} label={L.name} lang={lang}>
  <div class="ug-site bt" data-demo="back-to-top">
    <header class="ug-nav"><span class="ug-logo">SAMPLE</span>{L.nav.map((n) => <span>{n}</span>)}<span class="ug-cta">{L.cta}</span></header>
    <!-- ボタンが出る位置（つまみ --t-show）の目印。詳細ページの見本だけに出す -->
    {!mini && <div class="bt-guide" aria-hidden="true"><span>{L.guide}</span></div>}
    <div class="hero"><Scene tone="day" wide /></div>
    <section class="ug-sec">
      <p class="ug-label">NEWS</p>
      <h3 class="ug-h">{L.news}</h3>
      <div class="ug-lines"><i></i><i></i><i></i></div>
    </section>
    <section class="ug-sec">
      <p class="ug-label">ROOM</p>
      <h3 class="ug-h">{L.rooms}</h3>
      <div class="ug-grid">
        <div class="ug-card"><Scene tone="sunset" /><div class="ug-card-body">{L.roomNames[0]}</div></div>
        <div class="ug-card"><Scene tone="night" /><div class="ug-card-body">{L.roomNames[1]}</div></div>
        <div class="ug-card"><Scene tone="day" /><div class="ug-card-body">{L.roomNames[2]}</div></div>
      </div>
    </section>
    <section class="ug-sec">
      <p class="ug-label">PRICE</p>
      <h3 class="ug-h">{L.price}</h3>
      <div class="ug-lines"><i></i><i></i><i></i><i></i><i></i></div>
    </section>
    <section class="ug-sec">
      <p class="ug-label">ACCESS</p>
      <h3 class="ug-h">{L.access}</h3>
      <div class="map"><Scene tone="sunset" wide /></div>
      <div class="ug-lines"><i></i><i></i><i></i><i></i></div>
    </section>
    <!-- スマホ幅でも「画面の高さの200%」まで届くよう、ページを長めにしておく -->
    <section class="ug-sec">
      <p class="ug-label">VOICE</p>
      <h3 class="ug-h">{L.voice}</h3>
      <div class="ug-grid">
        <div class="ug-card"><Scene tone="night" /></div>
        <div class="ug-card"><Scene tone="day" /></div>
        <div class="ug-card"><Scene tone="sunset" /></div>
      </div>
      <div class="ug-lines"><i></i><i></i><i></i></div>
    </section>
    <section class="ug-sec">
      <p class="ug-label">FAQ</p>
      <h3 class="ug-h">{L.faq}</h3>
      <div class="ug-lines"><i></i><i></i><i></i><i></i><i></i><i></i></div>
    </section>
    <!-- 枠の右下にくっつける台。本物のサイトでは position: fixed で画面の右下に置く -->
    <div class="dock">
      <Btn class="btt" type={mini ? undefined : 'button'} aria-label={mini ? undefined : L.label} data-ug-focus={L.focus}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
      </Btn>
    </div>
  </div>
</UgFrame>

<style>
  .bt { position: relative; padding-bottom: 16px; }
  /* ボタンが出る位置の目印（JSで top を入れる） */
  .bt-guide {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    z-index: 3;
    height: 0;
    border-top: 2px dashed rgba(240, 106, 53, 0.85);
    pointer-events: none;
  }
  .bt-guide span {
    position: absolute;
    left: 8px;
    bottom: 2px;
    padding: 1px 6px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ug-orange);
    font-size: 10px;
    font-weight: 700;
  }
  .map { margin: 8px 0; border-radius: 10px; overflow: hidden; }
  /* sticky + bottom で、枠の下端から16pxの位置に居続ける（高さ0の台） */
  .dock { position: sticky; bottom: 16px; height: 0; z-index: 20; }
  .btt {
    position: absolute;
    right: 16px;
    bottom: 0;
    display: grid;
    place-items: center;
    /* 大きさはつまみ（--t-size）から */
    width: var(--t-size);
    height: var(--t-size);
    border: 0;
    border-radius: 50%;
    background: var(--ug-navy);
    color: #fff;
    box-shadow: 0 8px 20px -8px rgba(29, 37, 65, 0.55);
    cursor: pointer;
    /* 隠れているとき: 少し下＋透明。visibility も隠して焦点が行かないようにする */
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition: opacity calc(var(--t-dur) * 0.8) ease-in, transform calc(var(--t-dur) * 0.8) ease-in, visibility 0s linear calc(var(--t-dur) * 0.8), background-color 0.15s;
  }
  .btt.is-shown {
    opacity: 1;
    visibility: visible;
    transform: none;
    /* 出る速さはつまみ（--t-dur）から */
    transition: opacity var(--t-dur) ease-out, transform var(--t-dur) ease-out, visibility 0s, background-color 0.15s;
  }
  .btt:hover, .btt.is-hover { background: var(--ug-blue); }
  .btt:active { transform: scale(0.94); }
  .btt:focus-visible { outline: 3px solid var(--ug-orange); outline-offset: 2px; }
  /* 名札はボタンの左に出す */
  :global(.ug-frame.show-focus) .btt[data-ug-focus]::after { top: 50%; right: calc(100% + 8px); transform: translateY(-50%); }
  :global(.ug-frame.show-focus) .btt[data-ug-focus] { outline-offset: 2px; }
  :global(.is-mini) .dock { bottom: 12px; }
  :global(.is-mini) .btt { width: 40px; height: 40px; right: 12px; }
  @media (prefers-reduced-motion: reduce) {
    .btt, .btt.is-shown { transform: none; }
  }
</style>

<script>
  import { onTour, onTune, tuneNum } from '../../../lib/ugoki/runtime';

  const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-demo="back-to-top"]').forEach((root) => {
    const view = root.closest<HTMLElement>('[data-ug-view]');
    const btn = root.querySelector<HTMLElement>('.btt');
    if (!view || !btn) return;

    // 枠の高さの --t-show（初期値60%）以上スクロールしたら出す
    const at = () => (view.clientHeight * tuneNum(root, 'show', 60)) / 100;
    const sync = () => btn.classList.toggle('is-shown', view.scrollTop > at());
    view.addEventListener('scroll', sync, { passive: true });
    // 目印は「この線が枠の上端を過ぎたら出る」位置に置く
    const guide = root.querySelector<HTMLElement>('.bt-guide');
    const place = () => {
      if (guide) guide.style.top = `${at()}px`;
      sync();
    };
    new ResizeObserver(place).observe(view);
    onTune(view, place);
    place();

    const goTop = (real: boolean) => {
      view.scrollTo({ top: 0, behavior: reduce() ? 'auto' : 'smooth' });
      // キーボードで押した人のために、焦点もページの先頭（枠）へ移す
      if (real) view.focus({ preventScroll: true });
    };
    btn.addEventListener('click', () => goTop(true));
    btn.addEventListener('ug:click', () => goTop(false));
    view.addEventListener('ug:reset', sync);

    // 一覧の小さな見本は、ボタンが出ている「スクロール済み」の状態から始める（最初の一目で分かるように）
    const mini = Boolean(root.closest('.is-mini'));
    onTour(root, async (t) => {
      t.showCursor(false);
      const h = t.view.clientHeight;
      t.view.scrollTop = mini ? h * 1.6 : 0;
      sync();
      await t.sleep(mini ? 900 : 500);
      if (!mini) {
        // まずは出る位置の手前まで → 次に出る位置を越える
        await t.scrollTo(Math.max(0, at() - h * 0.35), 1000);
        await t.sleep(600);
      }
      await t.scrollTo(Math.max(h * 1.9, at() + h * 0.4), 1000);
      await t.sleep(600);
      await t.move(btn, 650);
      t.hover(btn);
      await t.sleep(250);
      await t.click(btn);
      t.hover(null);
      await t.sleep(1300);
      t.showCursor(false);
      await t.sleep(700);
    });
  });
</script>
