---
import UgFrame from '../UgFrame.astro';
import Scene from '../Scene.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
// 一覧の小さな見本は、外側がリンクなので中にリンクを入れない（span で代用）
const Card = size === 'mini' ? 'span' : 'a';
// 見本の中の文字（日英）
const L = {
  ja: {
    name: 'ホバーで浮き上がる',
    focus: '浮き上がるカード',
    nav: ['宿をさがす', '特集'],
    cta: '予約する',
    h: '泊まれる場所を選ぶ',
    stays: [['山の宿', '1泊 12,000円〜'], ['海の宿', '1泊 15,000円〜'], ['星の宿', '1泊 9,800円〜']],
    more: 'ほかに 24 件の宿があります',
  },
  en: {
    name: 'Hover lift',
    focus: 'Lifting card',
    nav: ['Find a stay', 'Guides'],
    cta: 'Book',
    h: 'Pick your getaway',
    stays: [['Mountain lodge', 'From $89 / night'], ['Seaside inn', 'From $110 / night'], ['Stargazer cabin', 'From $72 / night']],
    more: '24 more places to stay',
  },
}[lang as 'ja' | 'en'];
const tones = ['day', 'sunset', 'night'] as const;
---

<UgFrame mode="pointer" size={size} label={L.name} lang={lang}>
  <div class="ug-site page">
    <header class="ug-nav nav"><span class="ug-logo">SAMPLE</span>{L.nav.map((n) => <span>{n}</span>)}<span class="ug-cta">{L.cta}</span></header>
    <section class="ug-sec body">
      <div class="area" data-ug-focus={L.focus}>
        <p class="ug-label">STAY</p>
        <h3 class="ug-h">{L.h}</h3>
        <div class="ug-grid lift-grid">
          {L.stays.map(([name, price], i) => (
            <Card class="ug-card lift" href={size === 'mini' ? undefined : '#'} data-ug-target>
              <Scene tone={tones[i]} />
              <span class="ug-card-body">{name}<small>{price}</small></span>
            </Card>
          ))}
        </div>
      </div>
      <p class="more">{L.more}</p>
    </section>
  </div>
</UgFrame>

<style>
  .page { min-height: 100%; display: flex; flex-direction: column; }
  .body { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 16px; }
  .area { position: relative; margin: 0 -8px; padding: 8px 8px 12px; }
  .lift-grid { margin-top: 12px; }
  .lift {
    display: block;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    /* これが演出の本体: 浮き上がり＋影を、出るときは減速で。数値はつまみ（--t-*）から */
    transition:
      transform var(--t-dur) ease-out,
      box-shadow var(--t-dur) ease-out;
  }
  /* 影は浮いた距離に合わせて、下へ遠く・広くぼかす */
  .lift.is-hover,
  .lift:focus-visible {
    transform: translateY(calc(var(--t-lift) * -1));
    box-shadow: 0 calc(var(--t-lift) * 2) calc(var(--t-lift) * 4) -12px rgba(29, 37, 65, var(--t-shadow));
  }
  /* マウスのある端末だけ、乗せたときに浮かせる */
  @media (hover: hover) {
    .lift:hover {
      transform: translateY(calc(var(--t-lift) * -1));
      box-shadow: 0 calc(var(--t-lift) * 2) calc(var(--t-lift) * 4) -12px rgba(29, 37, 65, var(--t-shadow));
    }
  }
  /* 押した瞬間は少し沈める（スマホのタップにも反応が出る） */
  .lift:active { transform: translateY(-2px); transition-duration: 0.1s; }
  .lift:focus-visible { outline: 2px solid var(--ug-blue); outline-offset: 2px; }
  .lift .ug-card-body { display: block; } /* span でも余白が値段の行まで効くように */
  .lift small { display: block; font-weight: 400; color: var(--ug-ink-2); font-size: 10px; }
  .more { font-size: 11px; color: var(--ug-ink-2); }
  /* 一覧の小さな見本では、カードだけを見せる */
  :global(.is-mini) .nav, :global(.is-mini) .more, :global(.is-mini) .lift small { display: none; }
  :global(.is-mini) .body { padding-top: 14px; }
  @media (prefers-reduced-motion: reduce) {
    .lift { transition: box-shadow var(--t-dur) ease-out; }
    .lift.is-hover, .lift:hover, .lift:focus-visible, .lift:active { transform: none; }
  }
</style>

<script>
  // 見本の中のリンクで本当にページが移動しないようにする
  document.querySelectorAll<HTMLAnchorElement>('a.lift').forEach((a) => a.addEventListener('click', (e) => e.preventDefault()));
</script>
