---
import UgFrame from '../UgFrame.astro';
import Scene from '../Scene.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
// 見本の中の文字（日英）。数字は最初から「最後の値」で書いておく（JSが動かない環境でも正しい数字が読める）
const L = {
  ja: {
    name: 'カウントアップ',
    locale: 'ja-JP',
    nav: ['導入事例', '料金'],
    cta: '資料請求',
    top: [
      { to: 1280, dec: 0, pre: '', unit: '社', cap: '導入企業' },
      { to: 98.2, dec: 1, pre: '', unit: '%', cap: '継続率' },
      { to: 4.6, dec: 1, pre: '', unit: '時間', cap: '1日の削減時間' },
    ],
    band: [
      { to: 32400, dec: 0, pre: '', unit: '人', cap: '年間の利用者' },
      { to: 4.8, dec: 1, pre: '', unit: '点', cap: '満足度（5点満点）' },
      { to: 63, dec: 0, pre: '', unit: '%', cap: 'リピート率' },
    ],
    caseH: '導入した会社の声',
    cases: ['山の宿', '海辺の食堂', '星の村'],
    price: '料金プラン',
  },
  en: {
    name: 'Count-up',
    locale: 'en-US',
    nav: ['Customers', 'Pricing'],
    cta: 'Get a demo',
    top: [
      { to: 1280, dec: 0, pre: '', unit: '+', cap: 'Businesses' },
      { to: 98.2, dec: 1, pre: '', unit: '%', cap: 'Retention' },
      { to: 4.6, dec: 1, pre: '', unit: 'h', cap: 'Saved per day' },
    ],
    band: [
      { to: 32400, dec: 0, pre: '', unit: '', cap: 'Guests a year' },
      { to: 4.8, dec: 1, pre: '', unit: '/5', cap: 'Average rating' },
      { to: 2.4, dec: 1, pre: '$', unit: 'M', cap: 'Booked in 2026' },
    ],
    caseH: 'What customers say',
    cases: ['Mountain lodge', 'Seaside diner', 'Stargazer village'],
    price: 'Plans & pricing',
  },
}[lang as 'ja' | 'en'];
const fmt = (v: number, dec: number) => v.toLocaleString(L.locale, { minimumFractionDigits: dec, maximumFractionDigits: dec });
---

<UgFrame mode="script" size={size} label={L.name} lang={lang}>
  <div class="ug-site cu" data-demo="count-up" data-locale={L.locale}>
    <header class="ug-nav"><span class="ug-logo">SAMPLE</span>{L.nav.map((n) => <span>{n}</span>)}<span class="ug-cta">{L.cta}</span></header>
    <section class="stats" data-count-group data-ug-focus={L.name} data-ug-focus-at="below">
      {L.top.map((s) => (
        <div class="stat">
          <span class="sr-only">{s.cap} {s.pre}{fmt(s.to, s.dec)}{s.unit}</span>
          <span class="cu-num" aria-hidden="true">{s.pre && <small>{s.pre}</small>}<b class="count" data-to={s.to} data-dec={s.dec}>{fmt(s.to, s.dec)}</b><small>{s.unit}</small></span>
          <span class="cap" aria-hidden="true">{s.cap}</span>
        </div>
      ))}
    </section>
    <section class="ug-sec">
      <p class="ug-label">CASE</p>
      <h3 class="ug-h">{L.caseH}</h3>
      <div class="ug-grid">
        <div class="ug-card"><Scene tone="day" /><div class="ug-card-body">{L.cases[0]}</div></div>
        <div class="ug-card"><Scene tone="sunset" /><div class="ug-card-body">{L.cases[1]}</div></div>
        <div class="ug-card"><Scene tone="night" /><div class="ug-card-body">{L.cases[2]}</div></div>
      </div>
      <div class="ug-lines"><i></i><i></i><i></i></div>
    </section>
    <section class="stats is-dark" data-count-group>
      {L.band.map((s) => (
        <div class="stat">
          <span class="sr-only">{s.cap} {s.pre}{fmt(s.to, s.dec)}{s.unit}</span>
          <span class="cu-num" aria-hidden="true">{s.pre && <small>{s.pre}</small>}<b class="count" data-to={s.to} data-dec={s.dec}>{fmt(s.to, s.dec)}</b><small>{s.unit}</small></span>
          <span class="cap" aria-hidden="true">{s.cap}</span>
        </div>
      ))}
    </section>
    <section class="ug-sec">
      <p class="ug-label">PRICE</p>
      <h3 class="ug-h">{L.price}</h3>
      <div class="ug-lines"><i></i><i></i><i></i><i></i><i></i></div>
    </section>
  </div>
</UgFrame>

<style>
  .stats {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    padding: 24px 16px;
    background: #fff7f2;
    text-align: center;
  }
  .stats.is-dark { background: var(--ug-navy); color: #fff; }
  .stat { display: grid; gap: 4px; justify-items: center; }
  .cu-num { display: inline-flex; align-items: baseline; gap: 2px; white-space: nowrap; }
  .count {
    display: inline-block;
    font-size: 30px;
    font-weight: 800;
    line-height: 1.1;
    color: var(--ug-orange);
    /* これが大事: 数字の幅をそろえて、数えている途中で横に揺れないようにする */
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .is-dark .count { color: #fff; }
  .cu-num small { font-size: 12px; font-weight: 700; }
  .cap { font-size: 11px; color: var(--ug-ink-2); }
  .is-dark .cap { color: #c7cce0; }
  @container (max-width: 340px) {
    .stats { padding: 20px 8px; gap: 4px; }
    .count { font-size: 22px; }
    .cu-num small { font-size: 10px; }
    .cap { font-size: 10px; line-height: 1.4; }
  }
</style>

<script>
  import { onTour, onTune, tuneNum } from '../../../lib/ugoki/runtime';

  const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-demo="count-up"]').forEach((root) => {
    const view = root.closest<HTMLElement>('[data-ug-view]');
    if (!view) return;
    const locale = root.dataset.locale ?? 'ja-JP';
    const fmt = (v: number, dec: number) => v.toLocaleString(locale, { minimumFractionDigits: dec, maximumFractionDigits: dec });
    const groups = [...root.querySelectorAll<HTMLElement>('[data-count-group]')];
    let token = 0;

    // 最後の値を表示した状態で幅を測り、その幅を確保しておく（桁が増えても周りが動かない）
    root.querySelectorAll<HTMLElement>('.count').forEach((el) => {
      el.style.minWidth = `${Math.ceil(el.getBoundingClientRect().width)}px`;
    });

    const setZero = (g: HTMLElement) =>
      g.querySelectorAll<HTMLElement>('.count').forEach((el) => (el.textContent = fmt(0, Number(el.dataset.dec))));

    const play = (g: HTMLElement) => {
      g.dataset.done = '1';
      const my = token;
      // 数値はつまみ（--t-dur・--t-ease・--t-stagger）から
      const ms = tuneNum(root, 'dur', 1.6) * 1000;
      const pow = tuneNum(root, 'ease', 3);
      const gap = tuneNum(root, 'stagger', 0.1) * 1000;
      // 緩急の強さ: 1なら等速、数が大きいほど最初が速く最後がゆっくり
      const easeOut = (k: number) => 1 - Math.pow(1 - k, pow);
      g.querySelectorAll<HTMLElement>('.count').forEach((el, i) => {
        const to = Number(el.dataset.to);
        const dec = Number(el.dataset.dec);
        if (reduce()) {
          el.textContent = fmt(to, dec);
          return;
        }
        el.textContent = fmt(0, dec);
        const t0 = performance.now() + i * gap;
        const tick = (now: number) => {
          if (my !== token) return; // 「最初から」で止める
          const k = Math.max(0, Math.min(1, (now - t0) / ms));
          el.textContent = fmt(to * easeOut(k), dec);
          if (k < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    };

    const reset = () => {
      token++;
      groups.forEach((g) => {
        delete g.dataset.done;
        if (!reduce()) setZero(g);
      });
    };

    // 画面（枠）に入ったら1回だけ数える
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const g = e.target as HTMLElement;
          if (e.isIntersecting && !g.dataset.done) play(g);
        });
      },
      { root: view, threshold: 0.6 }
    );
    reset();
    groups.forEach((g) => io.observe(g));

    view.addEventListener('ug:reset', () => {
      reset();
      requestAnimationFrame(() => play(groups[0]));
    });

    // つまみを動かしたら、見えている数字をすぐに数え直して違いを見せる
    let tuneTimer = 0;
    onTune(view, () => {
      clearTimeout(tuneTimer);
      tuneTimer = window.setTimeout(() => {
        token++;
        const vr = view.getBoundingClientRect();
        groups.forEach((g) => {
          const r = g.getBoundingClientRect();
          if (r.bottom > vr.top && r.top < vr.bottom) play(g);
        });
      }, 250);
    });

    onTour(root, async (t) => {
      t.showCursor(false);
      reset();
      t.view.scrollTop = 0;
      await t.sleep(500);
      play(groups[0]);
      const wait = () => tuneNum(root, 'dur', 1.6) * 1000 + tuneNum(root, 'stagger', 0.1) * 2000 + 1000;
      await t.sleep(wait());
      const g = groups[1];
      const top = g.getBoundingClientRect().top - t.view.getBoundingClientRect().top + t.view.scrollTop;
      await t.scrollTo(top - (t.view.clientHeight - g.offsetHeight) / 2, 1000);
      await t.sleep(wait() + 200);
      await t.scrollTo(0, 800);
      await t.sleep(400);
    });
  });
</script>
