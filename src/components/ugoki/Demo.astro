---
// 本（動き・UI部品・資料レイアウト）と slug から見本を探して出す。
// つまみの初期値は外側の箱に CSS 変数（--t-<key>）として置き、枠の中へ受け継がせる。
// 選択肢のつまみ（type: 'select'）は data-t-<key>="値" の属性にも置く（CSSで出し分けるため。Tuner が書き換える）。
import { tuneVars } from '../../lib/zukan/tune';
import type { TuneParam } from '../../data/ugoki/types';
import type { BookId } from '../../data/zukan';

const motion = import.meta.glob<{ default: any }>('./demos/*.astro', { eager: true });
const ui = import.meta.glob<{ default: any }>('./ui-demos/*.astro', { eager: true });
const shiryo = import.meta.glob<{ default: any }>('./shiryo-demos/*.astro', { eager: true });
const DIRS: Record<BookId, [string, Record<string, { default: any }>]> = {
  ugoki: ['demos', motion],
  ui: ['ui-demos', ui],
  shiryo: ['shiryo-demos', shiryo],
};

interface Props {
  slug: string;
  book?: BookId;
  size?: 'mini' | 'full';
  lang?: 'ja' | 'en';
  tune?: TuneParam[];
}
const { slug, book = 'ugoki', size = 'full', lang = 'ja', tune } = Astro.props;
const [dir, mods] = DIRS[book];
const mod = mods[`./${dir}/${slug}.astro`];
if (!mod) throw new Error(`見本 ${dir}/${slug}.astro がありません`);
const Comp = mod.default;
const vars = tuneVars(tune);
const selAttrs = Object.fromEntries((tune ?? []).filter((p) => p.type === 'select').map((p) => [`data-t-${p.key}`, p.value]));
---

<div class="zk-demo" style={vars} data-zk-demo={slug} {...selAttrs}>
  <Comp size={size} lang={lang} />
</div>
