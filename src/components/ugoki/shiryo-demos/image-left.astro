---
// 資料レイアウトの見本: 左図右文型（左に写真・右に見出しと3つの説明。写真は描いた絵で代用）
// つまみ: --t-accent（色）・data-t-side（写真の位置 left|right）・--t-img（写真の幅。スライド幅に対する%）
import SlideFrame from '../SlideFrame.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
const DICT = {
  ja: {
    name: '左図右文型',
    kicker: 'ベーカリーの店頭業務',
    title: '朝の発注作業が、1日40分から10分に',
    points: [
      ['紙の発注書をやめた', '店長が閉店後に、タブレットで数を入力する'],
      ['売れ残りが見える', '前日の残りが画面に出るので、作りすぎを防げる'],
      ['工場へすぐ届く', '入力するとその場で届き、朝5時の仕込みに間に合う'],
    ],
    cap: '写真はイメージ',
    note: '※ 3店舗の平均（2026年6月）。1日あたりの発注作業の時間。',
  },
};
// 英語版を作るときは DICT に en を足す（今は日本語だけ）
const T = DICT[lang as keyof typeof DICT] ?? DICT.ja;
---

<SlideFrame size={size} label={T.name} page={8} lang={lang}>
  <div class="il" data-demo="image-left">
    <div class="il-photo" data-sf-in style="--i: 0">
<svg viewBox="0 0 420 540" preserveAspectRatio="xMidYMid slice" role="img" aria-label="パン屋の店頭で、カウンターの上のタブレットを操作する場面のイメージ" xmlns="http://www.w3.org/2000/svg">
  <rect width="420" height="540" fill="#efe3d0"/>
  <rect y="330" width="420" height="40" fill="#e3d2b8"/>
  <path d="M210 0v44" stroke="#6b5a48" stroke-width="3"/>
  <path d="M170 44h80a40 28 0 0 1-80 0z" fill="#f2c66d"/>
  <rect x="24" y="118" width="372" height="10" rx="3" fill="#b98a5a"/>
  <rect x="24" y="228" width="372" height="10" rx="3" fill="#b98a5a"/>
  <g fill="#d9a15f"><ellipse cx="70" cy="104" rx="34" ry="14"/><ellipse cx="150" cy="106" rx="30" ry="12"/><ellipse cx="236" cy="104" rx="36" ry="14"/><ellipse cx="322" cy="106" rx="32" ry="12"/></g>
  <g fill="#c98a45"><ellipse cx="96" cy="214" rx="30" ry="13"/><ellipse cx="176" cy="212" rx="34" ry="14"/><ellipse cx="270" cy="214" rx="30" ry="12"/><ellipse cx="344" cy="212" rx="28" ry="12"/></g>
  <g stroke="#a56f32" stroke-width="3" stroke-linecap="round"><path d="M56 100l8 8M72 98l8 8M222 100l8 8M240 98l8 8M160 208l8 8M178 206l8 8"/></g>
  <rect y="372" width="420" height="168" fill="#8a5a3a"/>
  <rect y="360" width="420" height="16" fill="#a9744c"/>
  <path d="M168 360l8-34h48l8 34z" fill="#3a3f4c"/>
  <rect x="104" y="196" width="212" height="136" rx="12" fill="#2b2f3a"/>
  <rect x="114" y="206" width="192" height="116" rx="4" fill="#f7f7f4"/>
  <rect x="124" y="216" width="80" height="10" rx="3" fill="#2b2f3a"/>
  <g fill="#d9dce3"><rect x="124" y="242" width="172" height="18" rx="3"/><rect x="124" y="268" width="172" height="18" rx="3"/><rect x="124" y="294" width="172" height="18" rx="3"/></g>
  <g fill="#d9a15f"><circle cx="136" cy="251" r="5"/><circle cx="136" cy="277" r="5"/><circle cx="136" cy="303" r="5"/></g>
  <g fill="#8a8f9c"><rect x="150" y="248" width="70" height="6" rx="2"/><rect x="150" y="274" width="58" height="6" rx="2"/><rect x="150" y="300" width="80" height="6" rx="2"/></g>
  <g fill="#2b2f3a"><rect x="262" y="246" width="26" height="10" rx="3"/><rect x="262" y="272" width="26" height="10" rx="3"/><rect x="262" y="298" width="26" height="10" rx="3"/></g>
  <ellipse cx="352" cy="352" rx="46" ry="12" fill="#6e4528"/>
  <g fill="#d9a15f"><ellipse cx="334" cy="338" rx="22" ry="14"/><ellipse cx="368" cy="340" rx="22" ry="14"/></g>
  <ellipse cx="60" cy="356" rx="36" ry="9" fill="#f7f1e6"/>
  <ellipse cx="60" cy="346" rx="30" ry="12" fill="#c98a45"/>
</svg>
      <span class="il-cap">{T.cap}</span>
    </div>
    <div class="il-text">
      <p class="sf-kicker" data-sf-in style="--i: 1">{T.kicker}</p>
      <p class="il-title" data-sf-in style="--i: 1">{T.title}</p>
      <ol class="il-points">
        {T.points.map(([h, d], i) => (
          <li data-sf-in style={`--i: ${i + 2}`}>
            <span class="il-no">{i + 1}</span>
            <span class="il-body"><b>{h}</b><span>{d}</span></span>
          </li>
        ))}
      </ol>
      <p class="sf-note il-note" data-sf-in style="--i: 5">{T.note}</p>
    </div>
  </div>
</SlideFrame>

<style>
  .il { position: absolute; inset: 0; display: grid; grid-template-columns: var(--t-img) 1fr; background: #fff; }
  .il-photo { position: relative; overflow: hidden; background: #efe3d0; }
  .il-photo :global(svg) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .il-cap {
    position: absolute;
    left: calc(14 * var(--u));
    bottom: calc(14 * var(--u));
    padding: calc(3 * var(--u)) calc(10 * var(--u));
    border-radius: calc(999 * var(--u));
    background: rgba(31, 36, 48, 0.62);
    color: #fff;
    font-size: calc(13 * var(--u));
  }
  .il-text { display: flex; flex-direction: column; min-width: 0; padding: calc(44 * var(--u)) calc(56 * var(--u)) calc(40 * var(--u)) calc(48 * var(--u)); }
  .il-title { margin: 0; font-size: calc(32 * var(--u)); font-weight: 800; line-height: 1.3; letter-spacing: 0.01em; text-wrap: balance; }
  .il-points { list-style: none; margin: calc(26 * var(--u)) 0 0; padding: 0; display: flex; flex-direction: column; gap: calc(18 * var(--u)); }
  .il-points li { display: flex; gap: calc(14 * var(--u)); align-items: flex-start; }
  .il-no {
    flex: none;
    display: grid;
    place-items: center;
    width: calc(30 * var(--u));
    height: calc(30 * var(--u));
    border-radius: calc(8 * var(--u));
    background: var(--t-accent);
    color: #fff;
    font-size: calc(16 * var(--u));
    font-weight: 800;
  }
  .il-body { display: flex; flex-direction: column; gap: calc(2 * var(--u)); }
  .il-body b { font-size: calc(20 * var(--u)); font-weight: 800; }
  .il-body span { font-size: calc(16 * var(--u)); color: var(--sf-ink-2); line-height: 1.5; }
  .il-note { margin-top: auto; padding-right: calc(32 * var(--u)); }

  /* 写真の位置（つまみ: 写真の位置） */
  :global([data-t-side='right']) .il { grid-template-columns: 1fr var(--t-img); }
  :global([data-t-side='right']) .il-photo { order: 2; }
  :global([data-t-side='right']) .il-text { padding: calc(44 * var(--u)) calc(48 * var(--u)) calc(40 * var(--u)) calc(56 * var(--u)); }
</style>
