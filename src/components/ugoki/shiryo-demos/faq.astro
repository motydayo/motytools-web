---
// 資料レイアウトの見本: FAQ型（よく聞かれる質問と答えを、Q・Aの記号つきの枠で並べる）
// つまみ: --t-accent（色）・data-t-cols（並べ方 2|1）・data-t-mark（Qの記号 fill|line）
import SlideFrame from '../SlideFrame.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
const DICT = {
  ja: {
    name: 'FAQ型',
    kicker: '予約管理サービス「サンプル予約」（架空）のよくある質問',
    title: '導入前によく聞かれる4つの質問と答え',
    items: [
      { q: '今の予約データは移せますか？', a: 'CSVの形式なら取り込めます。移行の作業は、当社が無料で代行します。' },
      { q: 'スマートフォンでも使えますか？', a: 'iPhoneとAndroidのブラウザで使えます。アプリのインストールは要りません。' },
      { q: '途中で解約できますか？', a: '月払いなら翌月末で解約でき、違約金はかかりません。' },
      { q: 'サポートはいつ受けられますか？', a: '平日の9時から18時まで、電話とチャットで受け付けます。' },
    ],
    note: '※ ここにない質問は、導入前のご相談でお答えします。',
  },
};
// 英語版を作るときは DICT に en を足す（今は日本語だけ）
const T = DICT[lang as keyof typeof DICT] ?? DICT.ja;
---

<SlideFrame size={size} label={T.name} page={25} lang={lang}>
  <div class="fq" data-demo="faq">
    <p class="sf-kicker" data-sf-in style="--i: 0">{T.kicker}</p>
    <p class="sf-title" data-sf-in style="--i: 0">{T.title}</p>
    <div class="fq-grid">
      {T.items.map((it, i) => (
        <div class="fq-card" data-sf-in style={`--i: ${i + 1}`}>
          <div class="fq-q"><span class="fq-mark fq-mq">Q</span><span class="fq-qt">{it.q}</span></div>
          <div class="fq-a"><span class="fq-mark fq-ma">A</span><span class="fq-at">{it.a}</span></div>
        </div>
      ))}
    </div>
    <p class="sf-note" data-sf-in style="--i: 5">{T.note}</p>
  </div>
</SlideFrame>

<style>
  .fq { display: flex; flex-direction: column; height: 100%; }
  .fq-grid { flex: 1; display: grid; grid-auto-rows: 1fr; gap: calc(14 * var(--u)); margin: calc(22 * var(--u)) 0 calc(12 * var(--u)); min-height: 0; }
  .fq-card { display: flex; flex-direction: column; justify-content: center; gap: calc(8 * var(--u)); padding: calc(10 * var(--u)) calc(20 * var(--u)); border: calc(2 * var(--u)) solid var(--sf-line); border-radius: calc(12 * var(--u)); background: #fff; min-height: 0; }
  .fq-q, .fq-a { display: flex; align-items: flex-start; gap: calc(12 * var(--u)); }
  .fq-mark { flex: none; display: flex; align-items: center; justify-content: center; width: calc(30 * var(--u)); height: calc(30 * var(--u)); border-radius: 50%; box-sizing: border-box; font-size: calc(17 * var(--u)); font-weight: 800; line-height: 1; }
  .fq-qt { padding-top: calc(2 * var(--u)); font-size: calc(21 * var(--u)); font-weight: 800; line-height: 1.35; }
  .fq-at { padding-top: calc(3 * var(--u)); font-size: calc(17 * var(--u)); color: var(--sf-ink-2); line-height: 1.5; }
  .fq-ma { border: calc(2 * var(--u)) solid var(--sf-mute); color: var(--sf-ink-2); }

  /* 並べ方（つまみ: 並べ方） */
  :global([data-t-cols='2']) .fq-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }

  /* Qの記号（つまみ: Qの記号） */
  :global([data-t-mark='fill']) .fq-mq { background: var(--t-accent); color: #fff; }
  :global([data-t-mark='line']) .fq-mq { border: calc(2 * var(--u)) solid var(--t-accent); color: var(--t-accent); }
</style>
