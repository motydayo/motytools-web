---
// 資料レイアウトの見本: スパークライン表型（6商品の売上を表で見せ、各行の右に12か月の推移を小さな折れ線で添える）
// 線の高さは行ごとに「最小〜最大」を幅300×高さ38の中に収める（行どうしでは比べられない。注記に書く）。
// つまみ: --t-accent（色）・data-t-hl（強調する行 on|off）・data-t-marker（線の印 last|range|none）・--t-w（線の太さ）
import SlideFrame from '../SlideFrame.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
const PFX = 'sp-';
const PAGE = 14;
const ATTRS = ['hl', 'marker'];
// 商品別の月間売上（万円）。昨年11月〜今年10月の12か月。表は直近月の売上の大きい順。
const DATA = [
  ['コーヒー豆（定番）', [500, 498, 502, 505, 500, 497, 503, 506, 501, 504, 502, 505]],
  ['水出しコーヒー', [60, 55, 58, 70, 95, 150, 240, 310, 330, 280, 190, 120]],
  ['紅茶ギフト', [180, 420, 200, 150, 140, 150, 160, 150, 140, 150, 160, 210]],
  ['ドリップバッグ', [200, 210, 215, 230, 240, 255, 270, 290, 310, 330, 350, 380]],
  ['豆の定期便', [90, 95, 100, 98, 105, 110, 108, 115, 120, 118, 125, 122]],
  ['マグカップ', [70, 150, 60, 55, 50, 52, 55, 58, 60, 62, 70, 66]],
];
const rows = DATA.map(([name, v]) => ({ name, v, last: v[11], chg: (v[11] / v[10] - 1) * 100, rising: v.every((x, i) => i === 0 || x > v[i - 1]) })).sort((a, b) => b.last - a.last);
const rising = rows.filter((r) => r.rising);
if (rising.length !== 1) throw new Error('sparkline-table: 毎月増えている商品が1つではありません（見出しと合いません）');
const T = {
  name: 'スパークライン表型',
  kicker: 'コーヒー通販「豆ごよみ」の商品別売上（昨年11月〜今年10月）',
  title: `${rising[0].name}だけが、1年間ずっと毎月増えている`,
  note: '※ 単位は万円（税抜）。推移の線は行ごとに最小〜最大の幅に合わせて描いているため、線の高さは行どうしでは比べられません。',
};
const fmt = (n) => String(Math.round(n * 100) / 100);
const sgn = (n) => (n >= 0 ? '+' : '−') + Math.abs(n).toFixed(1) + '%';
function buildBody(p) {
  const c = (...n) => n.map((x) => p + x).join(' ');
  let s = `    <div class="${c('tbl')}">\n`;
  s += `      <div class="${c('hd')}"><span>商品</span><span class="${c('r')}">直近月の売上</span><span class="${c('r')}">前月比</span><span class="${c('tr')}">12か月の推移</span></div>\n`;
  rows.forEach((r) => {
    const mn = Math.min(...r.v), mx = Math.max(...r.v);
    const x = (i) => fmt(8 + (i / 11) * 284), y = (v) => fmt(32 - ((v - mn) / (mx - mn)) * 26);
    const imax = r.v.indexOf(mx), imin = r.v.indexOf(mn);
    s += `      <div class="${c('rw', r.rising ? 'hot' : 'x')}">\n`;
    s += `        <span class="${c('nm')}">${r.name}</span>\n        <span class="${c('v')}">${r.last}</span>\n        <span class="${c('c', r.chg >= 0 ? 'pos' : 'neg')}">${sgn(r.chg)}</span>\n`;
    s += `        <svg class="${c('spark')}" viewBox="0 0 300 38" aria-hidden="true">\n`;
    s += `          <polyline class="${c('ln')}" points="${r.v.map((v, i) => `${x(i)},${y(v)}`).join(' ')}" />\n`;
    s += `          <circle class="${c('m', 'mlast')}" cx="${x(11)}" cy="${y(r.last)}" r="4.5" />\n`;
    s += `          <circle class="${c('m', 'mmax')}" cx="${x(imax)}" cy="${y(mx)}" r="4" />\n`;
    s += `          <circle class="${c('m', 'mmin')}" cx="${x(imin)}" cy="${y(mn)}" r="4" />\n`;
    s += `        </svg>\n      </div>\n`;
  });
  s += `    </div>`;
  return s;
}
// 英語版を作るときは T を言語ごとに用意する（今は日本語だけ）
const body = buildBody('sp-');
---

<SlideFrame size={size} label={T.name} page={PAGE} lang={lang}>
  <div class="sp" data-demo="sparkline-table">
    <p class="sf-kicker" data-sf-in style="--i: 0">{T.kicker}</p>
    <p class="sf-title" data-sf-in style="--i: 0">{T.title}</p>
    <div class="sp-body" data-sf-in style="--i: 2" set:html={body} />
    <p class="sf-note">{T.note}</p>
  </div>
</SlideFrame>

<style is:global>
  .sp { display: flex; flex-direction: column; height: 100%; }
  .sp-body { flex: 1; min-height: 0; margin: calc(18 * var(--u)) 0 calc(10 * var(--u)); }
  /* 表は 商品名・直近月の売上・前月比・推移の4列。推移の線は各行の最小〜最大に合わせて 幅300×高さ38 の中に描く */
  .sp-tbl { display: flex; flex-direction: column; height: 100%; }
  .sp-hd, .sp-rw { display: grid; grid-template-columns: calc(260 * var(--u)) calc(150 * var(--u)) calc(130 * var(--u)) 1fr; align-items: center; padding: 0 calc(12 * var(--u)); }
  .sp-hd { height: calc(38 * var(--u)); border-bottom: calc(2 * var(--u)) solid #1f2430; font-size: calc(15 * var(--u)); font-weight: 700; color: #5a6070; }
  .sp-rw { flex: 1; border-bottom: calc(1 * var(--u)) solid #e3e5ea; }
  .sp-r { text-align: right; }
  .sp-tr { padding-left: calc(36 * var(--u)); }
  .sp-nm { font-size: calc(18 * var(--u)); font-weight: 700; }
  .sp-v { text-align: right; font-size: calc(22 * var(--u)); font-weight: 800; font-variant-numeric: tabular-nums; }
  .sp-c { text-align: right; font-size: calc(18 * var(--u)); font-weight: 800; font-variant-numeric: tabular-nums; color: #5a6070; }
  .sp-spark { display: block; width: calc(300 * var(--u)); height: calc(38 * var(--u)); margin-left: calc(36 * var(--u)); overflow: visible; }
  
  .sp-ln { fill: none; stroke: #5a6070; stroke-width: var(--t-w); stroke-linejoin: round; stroke-linecap: round; }
  .sp-m { display: none; fill: #5a6070; }
  .sp-rw.sp-hot .sp-ln { stroke: var(--t-accent); }
  .sp-rw.sp-hot .sp-m { fill: var(--t-accent); }
  [data-t-marker='last'] .sp-mlast { display: inline; }
  [data-t-marker='range'] .sp-mmax,
  [data-t-marker='range'] .sp-mmin { display: inline; }
  
  /* 強調する行（data-hl="on" で、毎月増えている商品の行に薄い色を敷く） */
  [data-t-hl='on'] .sp-rw.sp-hot { background: color-mix(in srgb, var(--t-accent) 9%, #fff); }
  [data-t-hl='on'] .sp-rw.sp-hot .sp-nm,
  [data-t-hl='on'] .sp-rw.sp-hot .sp-c { color: var(--t-accent); }
</style>
