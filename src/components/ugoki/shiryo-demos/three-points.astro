---
// prefix: tp
// 資料レイアウトの見本: 3ポイント並列型（要点を3つの柱に横に並べ、同じ順番で中身を書く）
// つまみ: --t-accent（色）・data-t-focus（強調 all|1|2|3）・--t-gap（柱の間隔。幅960pxのスライドでのpx）
import SlideFrame from '../SlideFrame.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
const DICT = {
  ja: {
    name: '3ポイント並列型',
    kicker: '在庫管理システムの入れ替え',
    title: '新しい在庫システムを選ぶ理由は、この3つ',
    points: [
      { head: '入力の手間が半分に', from: '90分', to: '45分', label: '1日の入出庫の入力時間', body: 'バーコードを読み取るだけで記録。手入力は例外のときだけです。' },
      { head: '欠品が減る', from: '12件', to: '3件', label: '月あたりの欠品', body: '在庫が基準を下回ると担当者に自動で通知。発注の遅れを防ぎます。' },
      { head: 'すぐ使い始められる', from: '5日', to: '2日', label: '初期設定の日数', body: '今のデータをそのまま取り込めます。社員向けの説明会は半日で済みます。' },
    ],
    note: '※ 入力時間・欠品は、倉庫2か所での2か月の試験運用の平均。初期設定の日数は、現行システムの導入時との比較。',
  },
};
// 英語版を作るときは DICT に en を足す（今は日本語だけ）
const T = DICT[lang as keyof typeof DICT] ?? DICT.ja;
---

<SlideFrame size={size} label={T.name} page={4} lang={lang}>
  <div class="tp" data-demo="three-points">
    <p class="sf-kicker" data-sf-in style="--i: 0">{T.kicker}</p>
    <p class="sf-title" data-sf-in style="--i: 0">{T.title}</p>
    <div class="tp-cards">
      {T.points.map((p, i) => (
        <div class="tp-card" data-sf-in style={`--i: ${i + 1}`}>
          <span class="tp-num">{i + 1}</span>
          <span class="tp-head">{p.head}</span>
          <span class="tp-stat">
            <span class="tp-from">{p.from}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
            <b class="tp-to">{p.to}</b>
          </span>
          <span class="tp-label">{p.label}</span>
          <span class="tp-body">{p.body}</span>
        </div>
      ))}
    </div>
    <p class="sf-note" data-sf-in style="--i: 4">{T.note}</p>
  </div>
</SlideFrame>

<style>
  .tp { display: flex; flex-direction: column; height: 100%; }
  .tp-cards { flex: 1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: calc(var(--t-gap) * var(--u)); margin: calc(20 * var(--u)) 0 calc(12 * var(--u)); min-height: 0; }
  .tp-card { display: flex; flex-direction: column; padding: calc(20 * var(--u)) calc(22 * var(--u)); border: calc(2 * var(--u)) solid var(--sf-line); border-radius: calc(12 * var(--u)); background: #fff; }
  .tp-num { display: grid; place-items: center; width: calc(40 * var(--u)); height: calc(40 * var(--u)); border-radius: 50%; background: var(--sf-soft); color: var(--sf-ink-2); font-size: calc(20 * var(--u)); font-weight: 800; font-variant-numeric: tabular-nums; }
  .tp-head { margin-top: calc(12 * var(--u)); font-size: calc(24 * var(--u)); font-weight: 800; line-height: 1.3; }
  .tp-stat { display: flex; align-items: center; gap: calc(8 * var(--u)); margin-top: calc(14 * var(--u)); font-variant-numeric: tabular-nums; line-height: 1.1; }
  .tp-from { font-size: calc(22 * var(--u)); font-weight: 700; color: var(--sf-ink-3); }
  .tp-stat svg { width: calc(20 * var(--u)); height: calc(20 * var(--u)); color: var(--sf-ink-3); flex: none; }
  .tp-to { font-size: calc(40 * var(--u)); font-weight: 800; }
  .tp-label { margin-top: calc(4 * var(--u)); font-size: calc(15 * var(--u)); color: var(--sf-ink-2); }
  .tp-body { margin-top: auto; padding-top: calc(12 * var(--u)); border-top: calc(1 * var(--u)) solid var(--sf-line); font-size: calc(16 * var(--u)); line-height: 1.5; color: var(--sf-ink-2); }

  /* 強調のしかた（つまみ: 強調） */
  :global([data-t-focus='all']) .tp-num { background: var(--t-accent); color: #fff; }
  :global([data-t-focus='1']) .tp-card:nth-child(1),
  :global([data-t-focus='2']) .tp-card:nth-child(2),
  :global([data-t-focus='3']) .tp-card:nth-child(3) { border-color: var(--t-accent); border-width: calc(3 * var(--u)); background: color-mix(in srgb, var(--t-accent) 6%, #fff); }
  :global([data-t-focus='1']) .tp-card:nth-child(1) .tp-num,
  :global([data-t-focus='2']) .tp-card:nth-child(2) .tp-num,
  :global([data-t-focus='3']) .tp-card:nth-child(3) .tp-num { background: var(--t-accent); color: #fff; }
  :global([data-t-focus='1']) .tp-card:nth-child(1) .tp-to,
  :global([data-t-focus='2']) .tp-card:nth-child(2) .tp-to,
  :global([data-t-focus='3']) .tp-card:nth-child(3) .tp-to { color: var(--t-accent); }
</style>
