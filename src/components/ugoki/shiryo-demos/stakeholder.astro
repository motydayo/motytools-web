---
// 資料レイアウトの見本: ステークホルダー型（横軸＝関心の高さ、縦軸＝影響力の大きさ。4つの領域に関係者を丸で置き、右に領域ごとの関わり方を書く）
// つまみ: --t-accent（色）・data-t-focus（強調 key|none）・--t-dot（丸の大きさ。幅960pxのスライドでのpx）
import SlideFrame from '../SlideFrame.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
const DICT = { ja: { name: 'ステークホルダー型' } };
// 英語版を作るときは DICT に en を足す（今は日本語だけ）
const T = DICT[lang as keyof typeof DICT] ?? DICT.ja;
---

<SlideFrame size={size} label={T.name} page={14} lang={lang}>
  <div class="sh" data-demo="stakeholder">
    <p class="sf-kicker" data-sf-in style="--i: 0">社内システム刷新プロジェクトの関係者</p>
    <p class="sf-title" data-sf-in style="--i: 0">最優先は、経理部長と情報システム部</p>
    <div class="sh-body">
      <div class="sh-chart" data-sf-in style="--i: 1">
        <span class="sh-ylab" aria-hidden="true">影響力（上ほど大きい）</span>
        <div class="sh-plot">
          <div class="sh-q sh-q-tl"><span>満足させておく</span></div>
          <div class="sh-q sh-q-tr"><span>重点的に連携</span></div>
          <div class="sh-q sh-q-bl"><span>見守る</span></div>
          <div class="sh-q sh-q-br"><span>情報を届ける</span></div>
          <span class="sh-pt sh-r" style="left: 40%; bottom: 92%"><i></i><b>社長</b></span>
          <span class="sh-pt sh-r" style="left: 28%; bottom: 58%"><i></i><b>監査法人</b></span>
          <span class="sh-pt sh-r sh-key" style="left: 76%; bottom: 80%"><i></i><b>経理部長</b></span>
          <span class="sh-pt sh-l sh-key" style="left: 88%; bottom: 62%"><i></i><b>情報システム部</b></span>
          <span class="sh-pt sh-l" style="left: 84%; bottom: 28%"><i></i><b>営業部の現場</b></span>
          <span class="sh-pt sh-r" style="left: 22%; bottom: 18%"><i></i><b>取引先の担当者</b></span>
        </div>
        <span class="sh-xlab" aria-hidden="true">関心の高さ（右ほど高い）</span>
      </div>
      <div class="sh-list" data-sf-in style="--i: 2">
        <div class="sh-item sh-key"><b>重点的に連携</b><span>経理部長・情報システム部</span><em>計画づくりから一緒に進める</em></div>
        <div class="sh-item"><b>満足させておく</b><span>社長・監査法人</span><em>要所で報告し、判断を仰ぐ</em></div>
        <div class="sh-item"><b>情報を届ける</b><span>営業部の現場</span><em>変更点を早めに知らせる</em></div>
        <div class="sh-item"><b>見守る</b><span>取引先の担当者</span><em>必要なときだけ連絡する</em></div>
      </div>
    </div>
    <p class="sf-note">※ 位置は、プロジェクトメンバーの話し合いで決めた目安（それぞれ0〜100）。</p>
  </div>
</SlideFrame>

<style>
  .sh { display: flex; flex-direction: column; height: 100%; }
  .sh-body { flex: 1; min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) calc(270 * var(--u)); gap: calc(24 * var(--u)); margin: calc(14 * var(--u)) 0 calc(8 * var(--u)); }
  .sh-chart { display: grid; grid-template-columns: calc(26 * var(--u)) minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) calc(26 * var(--u)); }
  .sh-ylab { writing-mode: vertical-rl; text-align: center; align-self: center; font-size: calc(15 * var(--u)); font-weight: 800; color: var(--sf-ink-3); }
  .sh-xlab { grid-column: 2; padding-top: calc(4 * var(--u)); text-align: right; font-size: calc(15 * var(--u)); font-weight: 800; color: var(--sf-ink-3); }
  .sh-plot { --d: calc(var(--t-dot) * var(--u)); position: relative; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; border: calc(1.5 * var(--u)) solid var(--sf-mute); border-radius: calc(10 * var(--u)); }
  .sh-q { padding: calc(8 * var(--u)) calc(12 * var(--u)); border: 0 solid var(--sf-line); font-size: calc(15 * var(--u)); font-weight: 800; color: var(--sf-ink-3); }
  .sh-q-tl { border-width: 0 calc(1.5 * var(--u)) calc(1.5 * var(--u)) 0; border-radius: calc(9 * var(--u)) 0 0 0; }
  .sh-q-tr { border-width: 0 0 calc(1.5 * var(--u)) 0; border-radius: 0 calc(9 * var(--u)) 0 0; text-align: right; }
  .sh-q-bl { border-width: 0 calc(1.5 * var(--u)) 0 0; border-radius: 0 0 0 calc(9 * var(--u)); display: flex; align-items: flex-end; }
  .sh-q-br { border-radius: 0 0 calc(9 * var(--u)) 0; display: flex; align-items: flex-end; justify-content: flex-end; }
  .sh-pt { position: absolute; display: flex; align-items: center; gap: calc(6 * var(--u)); white-space: nowrap; }
  .sh-pt i { flex: none; width: var(--d); height: var(--d); border-radius: 50%; background: var(--sf-ink-2); }
  .sh-pt b { font-size: calc(16 * var(--u)); font-weight: 700; }
  .sh-r { transform: translate(calc(var(--d) / -2), 50%); }
  .sh-l { flex-direction: row-reverse; transform: translate(calc(-100% + var(--d) / 2), 50%); }
  .sh-list { display: flex; flex-direction: column; justify-content: space-between; }
  .sh-item { display: grid; gap: calc(1 * var(--u)); padding: calc(4 * var(--u)) 0 calc(4 * var(--u)) calc(14 * var(--u)); border-left: calc(4 * var(--u)) solid var(--sf-line); line-height: 1.35; }
  .sh-item b { font-size: calc(17 * var(--u)); font-weight: 800; }
  .sh-item span { font-size: calc(16 * var(--u)); color: var(--sf-ink-2); }
  .sh-item em { font-size: calc(16 * var(--u)); font-style: normal; color: var(--sf-ink); }

  /* 重点の領域を強調（data-focus="key"） */
  :global([data-t-focus='key']) .sh-q-tr { background: color-mix(in srgb, var(--t-accent) 9%, #fff); color: var(--t-accent); }
  :global([data-t-focus='key']) .sh-pt.sh-key i { background: var(--t-accent); }
  :global([data-t-focus='key']) .sh-pt.sh-key b { font-weight: 800; }
  :global([data-t-focus='key']) .sh-item.sh-key { border-left-color: var(--t-accent); }
  :global([data-t-focus='key']) .sh-item.sh-key b { color: var(--t-accent); }
</style>
