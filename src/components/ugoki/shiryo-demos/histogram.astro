---
// 資料レイアウトの見本: ヒストグラム型（電話対応120件の対応時間を10分ごとの区切りで数え、棒をくっつけて並べる）
// 棒の高さ = 件数 ÷ 40 × 240（目盛りは0〜40件）。区切りの幅はすべて同じ（784 ÷ 10）。
// つまみ: --t-accent（色）・data-t-focus（色を付ける棒 range|mode|none）・--t-gap（棒の間の白い線の太さ）
import SlideFrame from '../SlideFrame.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
const PFX = 'hg-';
const PAGE = 10;
const ATTRS = ['focus'];
// 電話対応120件の対応時間（分）を、10分ごとの区切りに分けた件数。区切りの幅はすべて同じ。
const BINS = [4, 12, 26, 31, 21, 12, 7, 4, 2, 1];
const TOTAL = BINS.reduce((s, n) => s + n, 0);
if (TOTAL !== 120) throw new Error('histogram: 合計が120件ではありません');
const IN = BINS.slice(2, 5).reduce((s, n) => s + n, 0); // 20〜50分
const OVER = BINS.slice(6).reduce((s, n) => s + n, 0); // 60分より長い
const pct = (n) => Math.round((n / TOTAL) * 100);
const T = {
  name: 'ヒストグラム型',
  kicker: 'お客さま窓口の電話対応にかかった時間（2025年9月・120件）',
  title: `対応時間の${pct(IN)}%は、20〜50分に集まっている`,
  note: '※ 対応時間を10分ごとに区切った件数（20〜30は「20分以上30分未満」）。合計120件。',
};
const fmt = (n) => String(Math.round(n * 100) / 100);
function buildBody(p) {
  const c = (...n) => n.map((x) => p + x).join(' ');
  const L = 48, R = 832, TOP = 50, B = 290, MAX = 40, BW = (R - L) / BINS.length, H = B - TOP;
  const y = (v) => fmt(B - (v / MAX) * H);
  const x = (i) => fmt(L + BW * i);
  let s = `    <svg class="${c('svg')}" viewBox="0 0 848 338" role="img" aria-label="対応時間の分布を表すヒストグラム">\n`;
  for (let k = 0; k <= 4; k++) {
    s += `      <line class="${c(k === 0 ? 'base' : 'grid')}" x1="${L}" x2="${R}" y1="${y(k * 10)}" y2="${y(k * 10)}" />\n`;
    s += `      <text class="${c('tick')}" x="${L - 10}" y="${fmt(B - (k * 10 / MAX) * H + 5)}" text-anchor="end">${k * 10}</text>\n`;
  }
  s += `      <text class="${c('unit')}" x="${L - 10}" y="${TOP - 22}" text-anchor="end">（件）</text>\n`;
  BINS.forEach((n, i) => {
    s += `      <rect class="${c('bar', i >= 2 && i <= 4 ? 'in' : 'out', i === 3 ? 'mode' : 'x')}" x="${x(i)}" y="${y(n)}" width="${fmt(BW)}" height="${fmt((n / MAX) * H)}" />\n`;
    s += `      <text class="${c('val')}" x="${fmt(L + BW * (i + 0.5))}" y="${fmt(B - (n / MAX) * H - 8)}" text-anchor="middle">${n}</text>\n`;
  });
  for (let i = 0; i <= BINS.length; i++) s += `      <text class="${c('xt')}" x="${x(i)}" y="${B + 24}" text-anchor="middle">${i * 10}</text>\n`;
  s += `      <text class="${c('unit')}" x="${R}" y="${B + 48}" text-anchor="end">（分）</text>\n`;
  // 20〜50分のかっこ
  s += `      <g class="${c('rng')}">\n        <path class="${c('brk')}" d="M${x(2)} 86v-9h${fmt(BW * 3)}v9" />\n        <text class="${c('brk-t')}" x="${fmt(L + BW * 3.5)}" y="66" text-anchor="middle">20〜50分に${pct(IN)}%（${IN}件）</text>\n      </g>\n`;
  // 60分より長い
  s += `      <path class="${c('brk', 'gray')}" d="M${x(6)} 216v-9h${fmt(BW * 4)}v9" />\n`;
  s += `      <text class="${c('brk-t', 'gray')}" x="${fmt(L + BW * 8)}" y="192" text-anchor="middle">60分以上は${OVER}件（${pct(OVER)}%）</text>\n`;
  s += `    </svg>`;
  return s;
}
// 英語版を作るときは T を言語ごとに用意する（今は日本語だけ）
const body = buildBody('hg-');
---

<SlideFrame size={size} label={T.name} page={PAGE} lang={lang}>
  <div class="hg" data-demo="histogram">
    <p class="sf-kicker" data-sf-in style="--i: 0">{T.kicker}</p>
    <p class="sf-title" data-sf-in style="--i: 0">{T.title}</p>
    <div class="hg-body" data-sf-in style="--i: 2" set:html={body} />
    <p class="sf-note">{T.note}</p>
  </div>
</SlideFrame>

<style is:global>
  .hg { display: flex; flex-direction: column; height: 100%; }
  .hg-body { flex: 1; min-height: 0; margin: calc(18 * var(--u)) 0 calc(10 * var(--u)); }
  /* 棒の高さは 件数 ÷ 40 × 240。棒の幅（区切り）はすべて同じ。座標は幅848×高さ338の中で数字で決めている */
  
  .hg-svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .hg-grid { stroke: #e3e5ea; stroke-width: 1; }
  .hg-base { stroke: #8a8f9c; stroke-width: 1.5; }
  .hg-tick { font-size: 14px; fill: #8a8f9c; font-variant-numeric: tabular-nums; }
  .hg-xt { font-size: 16px; fill: #5a6070; font-variant-numeric: tabular-nums; }
  .hg-unit { font-size: 14px; fill: #8a8f9c; }
  .hg-bar { fill: #c3c8d2; stroke: #fff; stroke-width: var(--t-gap); }
  .hg-val { font-size: 16px; font-weight: 800; fill: #1f2430; font-variant-numeric: tabular-nums; }
  .hg-brk { fill: none; stroke: var(--t-accent); stroke-width: 2; stroke-linejoin: round; }
  .hg-brk-t { font-size: 18px; font-weight: 800; fill: var(--t-accent); }
  .hg-brk.hg-gray { stroke: #8a8f9c; }
  .hg-brk-t.hg-gray { font-size: 16px; fill: #5a6070; }
  
  /* 色を付ける棒（data-focus: range＝20〜50分、mode＝いちばん多い区切り、none＝すべて灰色） */
  [data-t-focus='range'] .hg-bar.hg-in { fill: var(--t-accent); }
  [data-t-focus='mode'] .hg-bar.hg-mode { fill: var(--t-accent); }
  [data-t-focus='mode'] .hg-rng,
  [data-t-focus='none'] .hg-rng { display: none; }
</style>
