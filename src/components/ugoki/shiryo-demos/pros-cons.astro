---
// 資料レイアウトの見本: メリット・注意点型（1つの案の「よい点」と「気をつける点」を左右に分け、注意点には対策を添える）
// つまみ: --t-accent（色）・data-t-fix（対策を出すか show|hide）・--t-gap（左右の間隔。幅960pxのスライドでのpx）
import SlideFrame from '../SlideFrame.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
const DICT = {
  ja: {
    name: 'メリット・注意点型',
    kicker: '在宅勤務の導入案（週2日）',
    title: '在宅勤務は週2日から。注意点には先に手を打つ',
    pros: {
      head: 'メリット',
      items: [
        ['通勤時間が減る', '往復1.5時間 × 週2日 ＝ 週3時間'],
        ['集中して進められる', '資料づくりなど、静かな環境が要る仕事'],
        ['採用で選ばれやすい', '働き方の選択肢が、求人の強みになる'],
      ],
    },
    cons: {
      head: '注意点と対策',
      items: [
        ['雑談が減る', '同じ部屋にいない日は、気軽な相談が減る', '週1回、全員の朝会を開く'],
        ['出社日がそろわない', '会議や来客の日に、人が足りなくなる', '出社日を火・木に固定する'],
        ['仕事の様子が見えない', '上司が進み具合を把握しにくい', '始業と終業を毎日チャットで報告する'],
      ],
    },
    fix: '対策',
    note: '※ 往復1.5時間は社員の平均。週3時間は1.5時間 × 2日。',
  },
};
// 英語版を作るときは DICT に en を足す（今は日本語だけ）
const T = DICT[lang as keyof typeof DICT] ?? DICT.ja;
---

<SlideFrame size={size} label={T.name} page={15} lang={lang}>
  <div class="pc" data-demo="pros-cons">
    <p class="sf-kicker" data-sf-in style="--i: 0">{T.kicker}</p>
    <p class="sf-title" data-sf-in style="--i: 0">{T.title}</p>
    <div class="pc-cols">
      <div class="pc-col pc-pros" data-sf-in style="--i: 1">
        <p class="pc-head">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor" /><path d="M7 12.5l3.2 3.2L17 8.8" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
          {T.pros.head}
        </p>
        <ul class="pc-list">
          {T.pros.items.map(([h, d]) => (
            <li><b>{h}</b><span>{d}</span></li>
          ))}
        </ul>
      </div>
      <div class="pc-col pc-cons" data-sf-in style="--i: 2">
        <p class="pc-head">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M12 2.5L22.5 21h-21z" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /><path d="M12 9.5v5.5M12 17.6v.4" stroke="#fff" stroke-width="2.4" stroke-linecap="round" /></svg>
          {T.cons.head}
        </p>
        <ul class="pc-list">
          {T.cons.items.map(([h, d, f]) => (
            <li><b>{h}</b><span>{d}</span><span class="pc-fix"><em>{T.fix}</em>{f}</span></li>
          ))}
        </ul>
      </div>
    </div>
    <p class="sf-note" data-sf-in style="--i: 3">{T.note}</p>
  </div>
</SlideFrame>

<style>
  .pc { display: flex; flex-direction: column; height: 100%; }
  .pc-cols { flex: 1; display: grid; grid-template-columns: 1fr 1fr; gap: calc(var(--t-gap) * var(--u)); margin: calc(18 * var(--u)) 0 calc(10 * var(--u)); min-height: 0; }
  .pc-col { display: flex; flex-direction: column; padding: calc(14 * var(--u)) calc(24 * var(--u)) calc(10 * var(--u)); border-radius: calc(12 * var(--u)); border: calc(2 * var(--u)) solid var(--sf-line); min-width: 0; }
  .pc-pros { border-color: var(--t-accent); background: color-mix(in srgb, var(--t-accent) 6%, #fff); }
  .pc-head { display: flex; align-items: center; gap: calc(10 * var(--u)); margin: 0; padding-bottom: calc(8 * var(--u)); font-size: calc(22 * var(--u)); font-weight: 800; }
  .pc-pros .pc-head { color: var(--t-accent); }
  .pc-cons .pc-head { color: var(--sf-ink-2); }
  .pc-head svg { flex: none; }
  .pc-list { flex: 1; list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .pc-list li { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: calc(1 * var(--u)); border-top: calc(1 * var(--u)) solid var(--sf-line); }
  .pc-list b { font-size: calc(20 * var(--u)); font-weight: 800; line-height: 1.3; }
  .pc-list span { font-size: calc(16 * var(--u)); color: var(--sf-ink-2); line-height: 1.4; }
  .pc-fix { color: var(--sf-ink) !important; font-weight: 700; }
  .pc-fix em { margin-right: calc(8 * var(--u)); font-style: normal; font-weight: 800; color: var(--t-accent); }

  /* 対策の表示（つまみ: 対策） */
  :global([data-t-fix='hide']) .pc-fix { display: none; }
</style>
