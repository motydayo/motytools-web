---
// 資料レイアウトの見本: ロードマップ型（年や四半期ごとの大まかな計画を、テーマ別の段に並べて見せる）
// 横は年度（3列）、縦はテーマ（3段）。チップ（角丸の札）は「何列目から何列ぶん」で置く。一番下の行に年度ごとの目標の数字を置く。
// つまみ: --t-accent（色）・data-t-now（いまの年度の目印 show|hide）
import SlideFrame from '../SlideFrame.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
const DICT = {
  ja: {
    name: 'ロードマップ型',
    kicker: '生産管理システム刷新の3か年ロードマップ',
    title: '3年で、受注から出荷までの入力を1回にする',
    note: '※ 目標は入力ミスの件数（月あたり）。現在は月40件。',
  },
};
// 英語版を作るときは DICT に en を足す（今は日本語だけ）
const T = DICT[lang as keyof typeof DICT] ?? DICT.ja;
---

<SlideFrame size={size} label={T.name} page={8} lang={lang}>
  <div class="rm" data-demo="roadmap">
    <p class="sf-kicker" data-sf-in style="--i: 0">{T.kicker}</p>
    <p class="sf-title" data-sf-in style="--i: 0">{T.title}</p>
    <div class="rm-table">
      <span class="rm-now"></span>
      <span class="rm-corner"></span>
      <span class="rm-year" style="grid-column: 2"><b>2026年度</b><i>いま</i></span>
      <span class="rm-year" style="grid-column: 3"><b>2027年度</b></span>
      <span class="rm-year" style="grid-column: 4"><b>2028年度</b></span>
      <span class="rm-sep" style="grid-row: 2"></span>
      <span class="rm-lane" style="grid-row: 2">業務</span>
      <span class="rm-chip" data-sf-in style="--i: 1; grid-row: 2; grid-column: 2 / span 1"><b>受注の電子化</b><em>紙の注文書をなくす</em></span>
      <span class="rm-chip" data-sf-in style="--i: 2; grid-row: 2; grid-column: 3 / span 1"><b>出荷指示の自動化</b><em>倉庫へ自動で送る</em></span>
      <span class="rm-chip" data-sf-in style="--i: 3; grid-row: 2; grid-column: 4 / span 1"><b>全4工場で運用</b><em>手順を同じにそろえる</em></span>
      <span class="rm-sep" style="grid-row: 3"></span>
      <span class="rm-lane" style="grid-row: 3">システム</span>
      <span class="rm-chip" data-sf-in style="--i: 4; grid-row: 3; grid-column: 2 / span 2"><b>新しい生産管理システムの構築</b><em>設計 → 開発 → 試験運用</em></span>
      <span class="rm-chip" data-sf-in style="--i: 5; grid-row: 3; grid-column: 4 / span 1"><b>旧システムの停止</b><em>データを引き継ぐ</em></span>
      <span class="rm-sep" style="grid-row: 4"></span>
      <span class="rm-lane" style="grid-row: 4">体制</span>
      <span class="rm-chip" data-sf-in style="--i: 6; grid-row: 4; grid-column: 2 / span 1"><b>推進チームの発足</b><em>各工場から1名</em></span>
      <span class="rm-chip" data-sf-in style="--i: 7; grid-row: 4; grid-column: 3 / span 2"><b>現場リーダーの研修と定着支援</b><em>年2回・対象者は全員が受講</em></span>
      <span class="rm-sep" style="grid-row: 5"></span>
      <span class="rm-lane rm-goal-lane" style="grid-row: 5">年度末の目標<small>入力ミス（月）</small></span>
      <span class="rm-goal" data-sf-in style="--i: 8; grid-row: 5; grid-column: 2"><b>20件</b></span>
      <span class="rm-goal" data-sf-in style="--i: 9; grid-row: 5; grid-column: 3"><b>10件</b></span>
      <span class="rm-goal" data-sf-in style="--i: 10; grid-row: 5; grid-column: 4"><b>5件以下</b></span>
    </div>
    <p class="sf-note">{T.note}</p>
  </div>
</SlideFrame>

<style>
  .rm { display: flex; flex-direction: column; height: 100%; }
  /* 横は3つの年度、縦はテーマ。札は「何列目から何列ぶん」で置く */
  .rm-table {
    position: relative;
    flex: 1;
    display: grid;
    grid-template-columns: calc(138 * var(--u)) repeat(3, minmax(0, 1fr));
    grid-template-rows: calc(40 * var(--u)) repeat(3, 1fr) calc(80 * var(--u));
    column-gap: calc(12 * var(--u));
    margin: calc(14 * var(--u)) 0 calc(10 * var(--u));
    min-height: 0;
  }
  .rm-now { grid-row: 1 / 6; grid-column: 2; border-radius: calc(10 * var(--u)); background: color-mix(in srgb, var(--t-accent) 8%, #fff); }
  .rm-year { grid-row: 1; align-self: center; display: flex; align-items: center; gap: calc(8 * var(--u)); padding-left: calc(12 * var(--u)); font-size: calc(18 * var(--u)); }
  .rm-year i { padding: calc(1 * var(--u)) calc(10 * var(--u)); border-radius: calc(999 * var(--u)); background: var(--t-accent); color: #fff; font-size: calc(14 * var(--u)); font-style: normal; font-weight: 700; }
  .rm-sep { grid-column: 1 / -1; align-self: start; border-top: calc(1 * var(--u)) solid #e3e5ea; }
  .rm-lane { grid-column: 1; align-self: center; display: flex; flex-direction: column; font-size: calc(18 * var(--u)); font-weight: 800; }
  .rm-lane small { font-size: calc(14 * var(--u)); font-weight: 700; color: #8a8f9c; }
  .rm-chip {
    align-self: center;
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: calc(54 * var(--u));
    padding: 0 calc(14 * var(--u));
    border: calc(2 * var(--u)) solid color-mix(in srgb, var(--t-accent) 38%, #fff);
    border-radius: calc(10 * var(--u));
    background: color-mix(in srgb, var(--t-accent) 12%, #fff);
  }
  .rm-chip b { font-size: calc(17 * var(--u)); font-weight: 800; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rm-chip em { font-size: calc(15 * var(--u)); font-style: normal; color: #5a6070; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .rm-goal { align-self: center; justify-self: start; padding-left: calc(12 * var(--u)); }
  .rm-goal b { font-size: calc(34 * var(--u)); font-weight: 800; color: var(--t-accent); font-variant-numeric: tabular-nums; }
  :global([data-t-now='hide']) .rm-now,
  :global([data-t-now='hide']) .rm-year i { display: none; }
</style>
