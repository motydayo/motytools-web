---
// 資料レイアウトの見本: ドーナツ内訳型（販売費の内訳を輪で見せ、中央に合計を置く）
// 輪は「半径120の円を、太さ50の線で描く」方法で作る。円周を100とみなし（pathLength=100）、割合をそのまま線の長さにする。
// つまみ: --t-accent（色）・data-t-focus（色を付ける内訳 top|tint）・--t-ring（輪の太さ）
import SlideFrame from '../SlideFrame.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
const DICT = {
  ja: {
    name: 'ドーナツ内訳型',
    kicker: '販売費の内訳（2025年度）',
    title: '販売費8,400万円の4割は広告宣伝費',
    // [項目, 金額（万円）]。割合は 金額 ÷ 合計 で計算する（合計8,400）
    data: [
      ['広告宣伝費', 3360],
      ['販促物・イベント', 2100],
      ['営業の人件費', 1680],
      ['物流費', 840],
      ['その他', 420],
    ] as [string, number][],
    total: '8,400',
    totalLabel: '販売費の合計',
    unit: '万円',
    note: '※ 割合は販売費の合計に対する比率。金額の単位は万円。',
  },
};
// 英語版を作るときは DICT に en を足す（今は日本語だけ）
const T = DICT[lang as keyof typeof DICT] ?? DICT.ja;
const SUM = T.data.reduce((a, [, v]) => a + v, 0);
if (SUM !== 8400) throw new Error('donut: 内訳の合計が8,400になっていません');
const GAP = 0.6;
let acc = 0;
const slices = T.data.map(([n, v]) => {
  const pct = (v / SUM) * 100;
  const s = { n, v, pct, dash: `${+(pct - GAP).toFixed(2)} ${+(100 - pct + GAP).toFixed(2)}`, off: -+(acc + GAP / 2).toFixed(2) };
  acc += pct;
  return s;
});
---

<SlideFrame size={size} label={T.name} page={12} lang={lang}>
  <div class="dn" data-demo="donut">
    <p class="sf-kicker" data-sf-in style="--i: 0">{T.kicker}</p>
    <p class="sf-title" data-sf-in style="--i: 0">{T.title}</p>
    <div class="dn-body">
      <div class="dn-ring" data-sf-in style="--i: 1">
        <svg viewBox="0 0 340 340" class="dn-svg" role="img" aria-label={T.title}>
          <g transform="rotate(-90 170 170)">
            {slices.map((s, i) => (
              <circle class={`dn-slice dn-s${i + 1}`} cx="170" cy="170" r="120" pathLength="100" stroke-dasharray={s.dash} stroke-dashoffset={s.off} />
            ))}
          </g>
          <text class="dn-cap" x="170" y="144" text-anchor="middle">{T.totalLabel}</text>
          <text class="dn-total" x="170" y="190" text-anchor="middle">{T.total}</text>
          <text class="dn-unit" x="170" y="216" text-anchor="middle">{T.unit}</text>
        </svg>
      </div>
      <div class="dn-legend">
        {slices.map((s, i) => (
          <div class="dn-item" data-sf-in style={`--i: ${i + 2}`}>
            <i class={`dn-sw dn-s${i + 1}`} />
            <span class="dn-label">{s.n}</span>
            <span class="dn-amt">{s.v.toLocaleString('en-US')}</span>
            <span class="dn-pct">{Math.round(s.pct)}<small>%</small></span>
          </div>
        ))}
      </div>
    </div>
    <p class="sf-note">{T.note}</p>
  </div>
</SlideFrame>

<style>
  .dn { display: flex; flex-direction: column; height: 100%; --c1: var(--t-accent); --c2: #9aa0ac; --c3: #b9bec9; --c4: #d0d4dc; --c5: #e1e4ea; }
  .dn-body { flex: 1; display: flex; align-items: center; gap: calc(52 * var(--u)); margin: calc(12 * var(--u)) 0 calc(6 * var(--u)); min-height: 0; }
  .dn-ring { flex: 0 0 calc(316 * var(--u)); height: calc(316 * var(--u)); margin-left: calc(20 * var(--u)); }
  .dn-svg { display: block; width: 100%; height: auto; font-family: inherit; }
  .dn-slice { fill: none; stroke-width: var(--t-ring); }
  .dn-slice.dn-s1 { stroke: var(--c1); }
  .dn-slice.dn-s2 { stroke: var(--c2); }
  .dn-slice.dn-s3 { stroke: var(--c3); }
  .dn-slice.dn-s4 { stroke: var(--c4); }
  .dn-slice.dn-s5 { stroke: var(--c5); }
  .dn-cap { font-size: 16px; font-weight: 700; fill: var(--sf-ink-2); }
  .dn-total { font-size: 50px; font-weight: 800; fill: var(--sf-ink); font-variant-numeric: tabular-nums; }
  .dn-unit { font-size: 18px; font-weight: 700; fill: var(--sf-ink-2); }
  .dn-legend { flex: 1; display: flex; flex-direction: column; border-top: calc(1 * var(--u)) solid var(--sf-line); }
  .dn-item { display: flex; align-items: center; gap: calc(12 * var(--u)); padding: calc(11 * var(--u)) 0; border-bottom: calc(1 * var(--u)) solid var(--sf-line); }
  .dn-sw { display: block; width: calc(18 * var(--u)); height: calc(18 * var(--u)); border-radius: calc(4 * var(--u)); }
  .dn-sw.dn-s1 { background: var(--c1); }
  .dn-sw.dn-s2 { background: var(--c2); }
  .dn-sw.dn-s3 { background: var(--c3); }
  .dn-sw.dn-s4 { background: var(--c4); }
  .dn-sw.dn-s5 { background: var(--c5); }
  .dn-label { flex: 1; font-size: calc(19 * var(--u)); font-weight: 700; }
  .dn-amt { font-size: calc(18 * var(--u)); color: var(--sf-ink-2); font-variant-numeric: tabular-nums; }
  .dn-pct { width: calc(76 * var(--u)); text-align: right; font-size: calc(28 * var(--u)); font-weight: 800; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .dn-pct small { margin-left: calc(2 * var(--u)); font-size: calc(16 * var(--u)); font-weight: 700; color: var(--sf-ink-2); }
  .dn-item:first-child .dn-pct { color: var(--t-accent); }

  /* 色を付ける内訳（つまみ）: tint なら5つとも同じ色の濃淡 */
  :global([data-t-focus='tint']) .dn { --c2: color-mix(in srgb, var(--t-accent) 62%, #fff); --c3: color-mix(in srgb, var(--t-accent) 42%, #fff); --c4: color-mix(in srgb, var(--t-accent) 26%, #fff); --c5: color-mix(in srgb, var(--t-accent) 14%, #fff); }
</style>
