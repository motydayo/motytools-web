---
// 資料レイアウトの見本: 仮説・検証・学び型（仮説の帯の下に「試したこと」「結果」「分かったこと」を矢印でつなぐ）
// つまみ: --t-accent（色）・data-t-focus（強調する枠 learn|result|none）・--t-radius（角の丸み）
import SlideFrame from '../SlideFrame.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
const DICT = {
  ja: {
    name: '仮説・検証・学び型',
    kicker: 'ネットショップ「ことのは窯」の送料実験',
    title: '送料無料のラインを下げると、売上は増えた',
    hypo: { label: '仮説', text: '送料無料を4,000円以上に下げれば、購入率が上がり売上も増える' },
    test: { key: 'test', label: '試したこと', head: '訪れた人を半分ずつに分けて比べた', points: ['A案：5,000円以上で送料無料（従来）', 'B案：4,000円以上で送料無料', '2026年9月1〜14日・各約1万2,000人'] },
    result: {
      key: 'result',
      label: '結果',
      head: 'B案は購入率が上がった',
      rows: [
        ['購入率', '2.8%', '3.4%'],
        ['客単価', '6,200円', '5,900円'],
        ['訪問1人あたり売上', '174円', '201円'],
      ],
      cols: ['A案', 'B案'],
    },
    learn: { key: 'learn', label: '分かったこと', head: '客単価は下がったが、購入率の伸びが上回った', points: ['訪問1人あたり売上は約16%増', '次は送料無料を3,000円以上にして試す'] },
    note: '※ 訪問1人あたり売上＝購入率×客単価（円未満は四捨五入）。A案・B案とも同じ期間に同時に実施。',
  },
};
// 英語版を作るときは DICT に en を足す（今は日本語だけ）
const T = DICT[lang as keyof typeof DICT] ?? DICT.ja;
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>';
---

<SlideFrame size={size} label={T.name} page={9} lang={lang}>
  <div class="hy" data-demo="hypothesis">
    <p class="sf-kicker" data-sf-in style="--i: 0">{T.kicker}</p>
    <p class="sf-title" data-sf-in style="--i: 0">{T.title}</p>
    <div class="hy-hypo" data-sf-in style="--i: 1">
      <span class="hy-pill">{T.hypo.label}</span>
      <span class="hy-hypo-text">{T.hypo.text}</span>
    </div>
    <div class="hy-flow">
      <div class="hy-card hy-test" data-sf-in style="--i: 2">
        <span class="hy-label">{T.test.label}</span>
        <span class="hy-head">{T.test.head}</span>
        <span class="hy-points">{T.test.points.map((p) => <span>{p}</span>)}</span>
      </div>
      <span class="hy-arrow" data-sf-in style="--i: 3" set:html={arrow} />
      <div class="hy-card hy-result" data-sf-in style="--i: 4">
        <span class="hy-label">{T.result.label}</span>
        <span class="hy-cols"><span /><span>{T.result.cols[0]}</span><span>{T.result.cols[1]}</span></span>
        <span class="hy-rows">
          {T.result.rows.map(([k, a, b], i) => (
            <span class:list={['hy-r', i === 2 && 'is-main']}><span class="hy-k">{k}</span><span class="hy-a">{a}</span><b class="hy-b">{b}</b></span>
          ))}
        </span>
      </div>
      <span class="hy-arrow" data-sf-in style="--i: 5" set:html={arrow} />
      <div class="hy-card hy-learn" data-sf-in style="--i: 6">
        <span class="hy-label">{T.learn.label}</span>
        <span class="hy-head">{T.learn.head}</span>
        <span class="hy-points">{T.learn.points.map((p) => <span>{p}</span>)}</span>
      </div>
    </div>
    <p class="sf-note">{T.note}</p>
  </div>
</SlideFrame>

<style>
  .hy { display: flex; flex-direction: column; height: 100%; }
  .hy-hypo {
    display: flex;
    align-items: center;
    gap: calc(14 * var(--u));
    margin-top: calc(16 * var(--u));
    padding: calc(12 * var(--u)) calc(20 * var(--u));
    border-radius: calc(var(--t-radius) * var(--u));
    background: var(--sf-soft);
  }
  .hy-pill { padding: calc(2 * var(--u)) calc(14 * var(--u)); border-radius: calc(999 * var(--u)); background: var(--sf-ink); color: #fff; font-size: calc(15 * var(--u)); font-weight: 800; white-space: nowrap; }
  .hy-hypo-text { font-size: calc(19 * var(--u)); font-weight: 700; line-height: 1.4; }
  .hy-flow {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) calc(24 * var(--u)) minmax(0, 1.25fr) calc(24 * var(--u)) minmax(0, 1fr);
    margin: calc(14 * var(--u)) 0 calc(10 * var(--u));
    min-height: 0;
  }
  .hy-card {
    display: flex;
    flex-direction: column;
    gap: calc(8 * var(--u));
    padding: calc(12 * var(--u)) calc(16 * var(--u));
    border: calc(2 * var(--u)) solid var(--sf-line);
    border-radius: calc(var(--t-radius) * var(--u));
    background: #fff;
  }
  .hy-label { align-self: flex-start; padding: calc(2 * var(--u)) calc(12 * var(--u)); border-radius: calc(999 * var(--u)); background: var(--sf-soft); color: var(--sf-ink-2); font-size: calc(15 * var(--u)); font-weight: 800; }
  .hy-head { font-size: calc(20 * var(--u)); font-weight: 800; line-height: 1.35; }
  .hy-points { display: grid; gap: calc(4 * var(--u)); margin-top: auto; padding-top: calc(8 * var(--u)); border-top: calc(1 * var(--u)) solid var(--sf-line); }
  .hy-points span { position: relative; padding-left: calc(14 * var(--u)); font-size: calc(15 * var(--u)); color: var(--sf-ink-2); line-height: 1.4; }
  .hy-points span::before { content: ''; position: absolute; left: 0; top: 0.55em; width: calc(6 * var(--u)); height: calc(6 * var(--u)); border-radius: 50%; background: var(--sf-mute); }
  .hy-arrow { display: grid; place-items: center; color: var(--sf-ink-3); }
  .hy-arrow :global(svg) { width: calc(26 * var(--u)); height: calc(26 * var(--u)); }
  /* 結果: A案とB案の数字を同じ物差しで並べる */
  .hy-cols { display: grid; grid-template-columns: minmax(0, 1fr) calc(88 * var(--u)) calc(88 * var(--u)); font-size: calc(14 * var(--u)); font-weight: 800; color: var(--sf-ink-3); text-align: right; }
  .hy-rows { flex: 1; display: grid; grid-template-rows: repeat(3, 1fr); }
  .hy-r { display: grid; grid-template-columns: minmax(0, 1fr) calc(88 * var(--u)) calc(88 * var(--u)); align-items: center; border-top: calc(1 * var(--u)) solid var(--sf-line); }
  .hy-k { font-size: calc(15 * var(--u)); color: var(--sf-ink-2); line-height: 1.3; }
  .hy-a, .hy-b { white-space: nowrap; font-size: calc(19 * var(--u)); font-weight: 800; text-align: right; font-variant-numeric: tabular-nums; }
  .hy-a { color: var(--sf-ink-2); }
  .hy-r.is-main .hy-b { font-size: calc(24 * var(--u)); color: var(--t-accent); }

  /* 強調する枠（つまみ: 強調する枠） */
  :global([data-t-focus='learn']) .hy-learn,
  :global([data-t-focus='result']) .hy-result {
    border-color: var(--t-accent);
    border-width: calc(3 * var(--u));
    background: color-mix(in srgb, var(--t-accent) 6%, #fff);
  }
  :global([data-t-focus='learn']) .hy-learn .hy-label,
  :global([data-t-focus='result']) .hy-result .hy-label { background: var(--t-accent); color: #fff; }
</style>
