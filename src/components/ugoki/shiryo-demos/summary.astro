---
// prefix: sm
// 資料レイアウトの見本: まとめ型（話の要点を3つに絞って振り返り、最後に聞き手へのお願いを1行で添える）
// つまみ: --t-accent（色）・data-t-mark（印 num|check）・data-t-ask（お願いの帯 show|hide）
import SlideFrame from '../SlideFrame.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
const DICT = {
  ja: {
    name: 'まとめ型',
    kicker: '営業部会　まとめ',
    title: 'まとめ：来期は「続けてもらうこと」に力を入れます',
    items: [
      { head: '解約の7割は、使い始めの30日以内に起きている', sub: '解約した212社のうち148社。最初の1か月が勝負です。' },
      { head: '導入後30日の支援担当を、3人置く', sub: '年間の費用は840万円（1人あたり年280万円）。' },
      { head: '1年後に、解約率を1.9%から1.4%へ', sub: '毎月の会議で、進み具合を確認します。' },
    ],
    ask: { label: 'お願い', text: '来週の経営会議で、支援担当3人の増員をご承認ください。' },
  },
};
// 英語版を作るときは DICT に en を足す（今は日本語だけ）
const T = DICT[lang as keyof typeof DICT] ?? DICT.ja;
---

<SlideFrame size={size} label={T.name} page={12} lang={lang}>
  <div class="sm" data-demo="summary">
    <p class="sf-kicker" data-sf-in style="--i: 0">{T.kicker}</p>
    <p class="sf-title" data-sf-in style="--i: 0">{T.title}</p>
    <div class="sm-list">
      {T.items.map((it, i) => (
        <div class="sm-item" data-sf-in style={`--i: ${i + 1}`}>
          <span class="sm-mark">
            <b>{i + 1}</b>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
          </span>
          <span class="sm-text">
            <span class="sm-head">{it.head}</span>
            <span class="sm-sub">{it.sub}</span>
          </span>
        </div>
      ))}
    </div>
    <div class="sm-ask" data-sf-in style="--i: 4">
      <span class="sm-ask-label">{T.ask.label}</span>
      <span class="sm-ask-text">{T.ask.text}</span>
    </div>
  </div>
</SlideFrame>

<style>
  .sm { display: flex; flex-direction: column; height: 100%; }
  .sm-list { flex: 1; display: flex; flex-direction: column; justify-content: center; margin: calc(8 * var(--u)) 0 calc(12 * var(--u)); min-height: 0; }
  .sm-item { display: flex; align-items: center; gap: calc(20 * var(--u)); padding: calc(14 * var(--u)) 0; border-bottom: calc(1 * var(--u)) solid var(--sf-line); }
  .sm-item:last-child { border-bottom: 0; }
  .sm-mark { flex: none; display: grid; place-items: center; width: calc(48 * var(--u)); height: calc(48 * var(--u)); border-radius: 50%; background: var(--sf-soft); color: var(--sf-ink); font-size: calc(22 * var(--u)); font-weight: 800; font-variant-numeric: tabular-nums; }
  .sm-mark svg { display: none; width: calc(24 * var(--u)); height: calc(24 * var(--u)); }
  .sm-text { display: flex; flex-direction: column; gap: calc(2 * var(--u)); min-width: 0; }
  .sm-head { font-size: calc(24 * var(--u)); font-weight: 800; line-height: 1.35; }
  .sm-sub { font-size: calc(16 * var(--u)); color: var(--sf-ink-2); }
  .sm-ask { display: flex; align-items: center; gap: calc(18 * var(--u)); padding: calc(14 * var(--u)) calc(24 * var(--u)); border-radius: calc(10 * var(--u)); background: var(--t-accent); color: #fff; }
  .sm-ask-label { padding: calc(2 * var(--u)) calc(12 * var(--u)); border-radius: calc(999 * var(--u)); background: rgba(255, 255, 255, 0.22); font-size: calc(15 * var(--u)); font-weight: 800; letter-spacing: 0.08em; }
  .sm-ask-text { font-size: calc(22 * var(--u)); font-weight: 800; }

  /* 印のしかた（つまみ: 印） */
  :global([data-t-mark='check']) .sm-mark b { display: none; }
  :global([data-t-mark='check']) .sm-mark svg { display: block; }

  /* お願いの帯（つまみ: お願いの帯）。出さないときは、印をアクセント色にして色の置き場を残す */
  :global([data-t-ask='hide']) .sm-ask { display: none; }
  :global([data-t-ask='hide']) .sm-mark { background: var(--t-accent); color: #fff; }
</style>
