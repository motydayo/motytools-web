---
// 資料レイアウトの見本: リソース配分型（人員の使い道を横の帯で、今期と来期を並べて見せる）
// 帯の各段の幅は「人数 ÷ 全体の人数」で計算する。2つの帯は同じ並び順（保守・改善・新機能）にそろえる。
// つまみ: --t-accent（色）・data-t-focus（色を付ける区分 new|keep|none）・--t-bar（帯の太さ。幅960pxのスライドでのpx）
import SlideFrame from '../SlideFrame.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
const DICT = {
  ja: {
    name: 'リソース配分型',
    kicker: '開発チーム10人の人員配分',
    title: '来期は保守を5人から3人に減らし、新機能に5人を振る',
    total: 10,
    person: '人',
    cats: [
      { key: 'keep', name: '保守' },
      { key: 'fix', name: '改善' },
      { key: 'new', name: '新機能' },
    ],
    periods: [
      { label: '今期', sub: '2026年度', n: { keep: 5, fix: 2, new: 3 } },
      { label: '来期', sub: '2027年度', n: { keep: 3, fix: 2, new: 5 } },
    ],
    deltaTitle: '増減（今期から来期）',
    note: '※ 人数は専任に換算。外部委託は含まない。',
  },
};
// 英語版を作るときは DICT に en を足す（今は日本語だけ）
const T = DICT[lang as keyof typeof DICT] ?? DICT.ja;
for (const p of T.periods) {
  if (Object.values(p.n).reduce((s, v) => s + v, 0) !== T.total) throw new Error('resource: 人数の合計が全体と合っていません');
}
const [a, b] = T.periods;
const cnt = (p: { n: object }, k: string): number => (p.n as Record<string, number>)[k];
const delta = (k: string) => cnt(b, k) - cnt(a, k);
const fmtDelta = (d: number) => (d > 0 ? `+${d}` : d < 0 ? `−${-d}` : '±0');
---

<SlideFrame size={size} label={T.name} page={17} lang={lang}>
  <div class="rs" data-demo="resource">
    <p class="sf-kicker" data-sf-in style="--i: 0">{T.kicker}</p>
    <p class="sf-title" data-sf-in style="--i: 0">{T.title}</p>
    <div class="rs-bars">
      {T.periods.map((p, pi) => (
        <div class="rs-bar-row" data-sf-in style={`--i: ${pi + 1}`}>
          <span class="rs-period"><b>{p.label}</b><small>{p.sub}</small></span>
          <div class="rs-bar">
            {T.cats.map((c) => (
              <span class={`rs-seg rs-${c.key}`} style={`--n: ${cnt(p, c.key)}`}>
                <span class="rs-seg-name">{c.name}</span>
                <span class="rs-seg-n">{cnt(p, c.key)}<small>{T.person}</small></span>
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
    <p class="rs-delta-title" data-sf-in style="--i: 3">{T.deltaTitle}</p>
    <div class="rs-deltas" data-sf-in style="--i: 3">
      {T.cats.map((c) => (
        <div class={`rs-delta rs-d-${c.key}`}>
          <span class="rs-delta-name">{c.name}</span>
          <span class="rs-delta-flow">{cnt(a, c.key)}{T.person}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>{cnt(b, c.key)}{T.person}</span>
          <span class="rs-delta-num">{fmtDelta(delta(c.key))}<small>{T.person}</small></span>
        </div>
      ))}
    </div>
    <p class="sf-note">{T.note}</p>
  </div>
</SlideFrame>

<style>
  .rs { display: flex; flex-direction: column; height: 100%; }
  .rs-bars { display: flex; flex-direction: column; gap: calc(14 * var(--u)); margin: calc(24 * var(--u)) 0 calc(18 * var(--u)); }
  .rs-bar-row { display: flex; align-items: center; gap: calc(16 * var(--u)); }
  .rs-period { flex: 0 0 calc(92 * var(--u)); display: flex; flex-direction: column; }
  .rs-period b { font-size: calc(24 * var(--u)); font-weight: 800; line-height: 1.2; }
  .rs-period small { font-size: calc(14 * var(--u)); color: var(--sf-ink-2); }
  .rs-bar { flex: 1; display: flex; gap: calc(3 * var(--u)); height: calc(var(--t-bar) * var(--u)); min-width: 0; }
  .rs-seg {
    flex: var(--n) 1 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 calc(14 * var(--u));
    min-width: 0;
    overflow: hidden;
  }
  .rs-seg:first-child { border-radius: calc(8 * var(--u)) 0 0 calc(8 * var(--u)); }
  .rs-seg:last-child { border-radius: 0 calc(8 * var(--u)) calc(8 * var(--u)) 0; }
  .rs-seg-name { font-size: calc(16 * var(--u)); font-weight: 700; line-height: 1.2; }
  .rs-seg-n { font-size: calc(26 * var(--u)); font-weight: 800; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .rs-seg-n small, .rs-delta-num small { margin-left: calc(2 * var(--u)); font-size: calc(15 * var(--u)); font-weight: 700; }
  .rs-keep { background: var(--sf-ink-2); color: #fff; }
  .rs-fix { background: var(--sf-mute); color: var(--sf-ink); }
  .rs-new { background: #aeb3c0; color: var(--sf-ink); }

  .rs-delta-title { margin: 0 0 calc(8 * var(--u)); font-size: calc(15 * var(--u)); font-weight: 700; color: var(--sf-ink-2); }
  .rs-deltas { flex: 1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: calc(16 * var(--u)); margin-bottom: calc(10 * var(--u)); min-height: 0; }
  .rs-delta {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto 1fr;
    align-items: end;
    padding: calc(12 * var(--u)) calc(18 * var(--u));
    border: calc(2 * var(--u)) solid var(--sf-line);
    border-radius: calc(10 * var(--u));
  }
  .rs-delta-name { font-size: calc(18 * var(--u)); font-weight: 800; }
  .rs-delta-flow { display: flex; align-items: center; justify-content: flex-end; gap: calc(6 * var(--u)); font-size: calc(16 * var(--u)); color: var(--sf-ink-2); font-variant-numeric: tabular-nums; }
  .rs-delta-flow svg { width: calc(16 * var(--u)); height: calc(16 * var(--u)); }
  .rs-delta-num { grid-column: 1 / 3; font-size: calc(40 * var(--u)); font-weight: 800; line-height: 1.1; font-variant-numeric: tabular-nums; }

  /* 色を付ける区分（つまみ: 色を付ける区分） */
  :global([data-t-focus='new']) .rs-new,
  :global([data-t-focus='keep']) .rs-keep { background: var(--t-accent); color: #fff; }
  :global([data-t-focus='new']) .rs-d-new,
  :global([data-t-focus='keep']) .rs-d-keep { border-color: var(--t-accent); background: color-mix(in srgb, var(--t-accent) 6%, #fff); }
  :global([data-t-focus='new']) .rs-d-new .rs-delta-num,
  :global([data-t-focus='keep']) .rs-d-keep .rs-delta-num { color: var(--t-accent); }
</style>
