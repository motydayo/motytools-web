---
// 資料レイアウトの見本: ガントチャート型（作業を縦に並べ、横の時間軸に期間を棒で引く）
// 時間軸は4月〜9月を半月ずつ12マスに分ける。棒は「何マス目から何マス目まで」で置く（1マス＝半月）。
// つまみ: --t-accent（色）・data-t-today（今日の線 show|hide）・data-t-progress（進み具合の塗り on|off）
import SlideFrame from '../SlideFrame.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
const DICT = {
  ja: {
    name: 'ガントチャート型',
    kicker: '新アプリ「ハレノート」公開までの工程',
    title: '9月30日の公開に向け、予定どおり進行中',
    months: ['4月', '5月', '6月', '7月', '8月', '9月'],
    // [作業名, 始まりのマス, 終わりのマス, 進み具合%]
    tasks: [
      ['要件定義', 1, 3, 100],
      ['デザイン', 3, 5, 100],
      ['開発', 4, 9, 60],
      ['テスト', 9, 11, 0],
      ['公開準備', 11, 12, 0],
    ] as [string, number, number, number][],
    milestone: '公開',
    milestoneDate: '9/30',
    today: '今日 7/1',
    note: '※ 1マスは半月。',
    // 進み具合の塗りを「表示しない」にしたときは消す（塗りが無いのに説明だけ残らないように）
    noteProgress: '濃い部分は終わった作業の割合（7月1日時点）。',
  },
};
// 英語版を作るときは DICT に en を足す（今は日本語だけ）
const T = DICT[lang as keyof typeof DICT] ?? DICT.ja;
// 今日の線は 7月1日 ＝ 6マス目の終わり（12マス中6マス）
const TODAY = 6;
---

<SlideFrame size={size} label={T.name} page={7} lang={lang}>
  <div class="gt" data-demo="gantt">
    <p class="sf-kicker" data-sf-in style="--i: 0">{T.kicker}</p>
    <p class="sf-title" data-sf-in style="--i: 0">{T.title}</p>
    <div class="gt-table" style={`--today: ${TODAY}`}>
      <span class="gt-corner" style="grid-row: 1; grid-column: 1" />
      {T.months.map((m, i) => (
        <span class="gt-month" style={`grid-row: 1; grid-column: ${i * 2 + 2} / span 2`}>{m}</span>
      ))}
      <div class="gt-lines" style={`grid-row: 2 / ${T.tasks.length + 3}; grid-column: 2 / -1`}>
        <span class="gt-today"><b>{T.today}</b></span>
      </div>
      {T.tasks.map(([n, s, e, p], i) => (
        <>
          <span class="gt-name" style={`grid-row: ${i + 2}; grid-column: 1`}>{n}</span>
          <span class="gt-cell" style={`grid-row: ${i + 2}; grid-column: ${s + 1} / ${e + 2}; --p: ${p}`}>
            <span class="gt-bar" data-sf-grow="x" style={`--i: ${i + 1}`}><i class="gt-done" /></span>
            <span class="gt-pct">{p}%</span>
          </span>
        </>
      ))}
      <span class="gt-name gt-ms-name" style={`grid-row: ${T.tasks.length + 2}; grid-column: 1`}>{T.milestone}</span>
      <span class="gt-ms" data-sf-in style={`grid-row: ${T.tasks.length + 2}; grid-column: 13; --i: 7`}>
        <i class="gt-diamond" /><b>{T.milestoneDate}</b>
      </span>
    </div>
    <p class="sf-note gt-note">{T.note}<span class="gt-note-progress">{T.noteProgress}</span></p>
  </div>
</SlideFrame>

<style>
  .gt { display: flex; flex-direction: column; height: 100%; }
  .gt-table {
    flex: 1;
    display: grid;
    grid-template-columns: calc(150 * var(--u)) repeat(12, minmax(0, 1fr));
    grid-template-rows: calc(40 * var(--u));
    grid-auto-rows: 1fr;
    margin: calc(18 * var(--u)) 0 calc(10 * var(--u));
    min-height: 0;
  }
  .gt-month {
    align-self: end;
    padding: 0 0 calc(8 * var(--u)) calc(8 * var(--u));
    font-size: calc(15 * var(--u));
    font-weight: 700;
    color: var(--sf-ink-2);
    border-left: calc(1 * var(--u)) solid var(--sf-line);
  }
  .gt-name {
    align-self: center;
    font-size: calc(18 * var(--u));
    font-weight: 700;
  }
  .gt-ms-name { color: var(--sf-ink-2); }
  /* 月の区切り線と今日の線 */
  .gt-lines {
    position: relative;
    background-image: linear-gradient(to right, var(--sf-line) calc(1 * var(--u)), transparent calc(1 * var(--u)));
    background-size: calc(100% / 6) 100%;
    border-top: calc(1 * var(--u)) solid var(--sf-line);
    box-shadow: inset calc(-1 * var(--u)) 0 var(--sf-line);
  }
  .gt-today {
    position: absolute;
    top: calc(-40 * var(--u));
    bottom: 0;
    left: calc(var(--today) / 12 * 100%);
    border-left: calc(2 * var(--u)) dashed #d0453a;
  }
  .gt-today b {
    position: absolute;
    top: 0;
    right: calc(4 * var(--u));
    padding: 0 calc(8 * var(--u));
    border-radius: calc(4 * var(--u));
    background: #d0453a;
    color: #fff;
    font-size: calc(13 * var(--u));
    font-weight: 700;
    line-height: calc(22 * var(--u));
    white-space: nowrap;
  }
  :global([data-t-today='hide']) .gt-today { display: none; }

  .gt-cell { position: relative; z-index: 1; display: flex; align-items: center; padding: 0 calc(2 * var(--u)); }
  .gt-bar {
    position: relative;
    display: block;
    width: 100%;
    height: calc(24 * var(--u));
    border-radius: calc(5 * var(--u));
    background: var(--t-accent);
    overflow: hidden;
  }
  .gt-done { display: none; position: absolute; inset: 0 auto 0 0; width: calc(var(--p) * 1%); background: var(--t-accent); }
  .gt-pct {
    display: none;
    position: absolute;
    left: calc(100% + 8 * var(--u));
    font-size: calc(14 * var(--u));
    font-weight: 700;
    color: var(--sf-ink-2);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* 進み具合の塗り（つまみ: 進み具合）: 棒は薄く、終わった割合だけ濃く */
  :global([data-t-progress='on']) .gt-bar { background: color-mix(in srgb, var(--t-accent) 22%, #fff); }
  :global([data-t-progress='off']) .gt-note-progress { display: none; }
  :global([data-t-progress='on']) .gt-done,
  :global([data-t-progress='on']) .gt-pct { display: block; }

  .gt-ms { position: relative; z-index: 1; align-self: center; justify-self: end; height: calc(24 * var(--u)); }
  .gt-diamond {
    position: absolute;
    top: 50%;
    right: 0;
    width: calc(18 * var(--u));
    height: calc(18 * var(--u));
    background: var(--sf-ink);
    transform: translate(50%, -50%) rotate(45deg);
  }
  .gt-ms b {
    position: absolute;
    top: 50%;
    right: calc(18 * var(--u));
    transform: translateY(-50%);
    font-size: calc(16 * var(--u));
    font-weight: 800;
    white-space: nowrap;
  }
</style>
