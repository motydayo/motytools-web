---
// 資料レイアウトの見本: 主張・根拠・示唆型（見出しの主張を、3つの事実で裏づけ、下の帯で「だから何か」を示す）
// つまみ: --t-accent（色）・data-t-focus（強調 implication|none）・data-t-source（根拠の出典 show|hide）
import SlideFrame from '../SlideFrame.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
const DICT = {
  ja: {
    name: '主張・根拠・示唆型',
    kicker: '夜間の問い合わせ窓口（18〜21時）の見直し',
    title: '夜間の電話窓口は、チャット中心に切り替えてよい',
    evLabel: '根拠',
    evs: [
      { num: '78', unit: '%', text: '夜間の問い合わせのうち、チャットで届いた割合', src: '問い合わせ管理表（7〜9月・1,240件）' },
      { num: '9', unit: '分', text: 'チャット1件の対応時間（電話は18分）', src: '対応記録（7〜9月）' },
      { num: '4.4', unit: '点', text: 'チャット対応の満足度（電話は4.3点）', src: '対応後アンケート（5点満点）' },
    ],
    impLabel: '示唆',
    imp: '同じ人数のまま、夜間にさばける件数を約2倍にできる',
    impSub: '次の一手：11月から夜間の電話を予約制にする',
    note: '※ 件数・時間・満足度は2026年7〜9月の実績。約2倍＝電話18分÷チャット9分。',
  },
};
// 英語版を作るときは DICT に en を足す（今は日本語だけ）
const T = DICT[lang as keyof typeof DICT] ?? DICT.ja;
---

<SlideFrame size={size} label={T.name} page={10} lang={lang}>
  <div class="ce" data-demo="claim-evidence">
    <p class="sf-kicker" data-sf-in style="--i: 0">{T.kicker}</p>
    <p class="sf-title" data-sf-in style="--i: 0">{T.title}</p>
    <div class="ce-body">
      <div class="ce-evs">
        <span class="ce-pill" data-sf-in style="--i: 1">{T.evLabel}</span>
        <div class="ce-cards">
          {T.evs.map((e, i) => (
            <div class="ce-ev" data-sf-in style={`--i: ${i + 1}`}>
              <span class="ce-num">{e.num}<small>{e.unit}</small></span>
              <span class="ce-text">{e.text}</span>
              <span class="ce-src">{e.src}</span>
            </div>
          ))}
        </div>
      </div>
      <span class="ce-down" data-sf-in style="--i: 4"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 9l7 7 7-7" /></svg></span>
      <div class="ce-imp" data-sf-in style="--i: 5">
        <span class="ce-pill ce-pill-imp">{T.impLabel}</span>
        <span class="ce-imp-text">{T.imp}</span>
        <span class="ce-imp-sub">{T.impSub}</span>
      </div>
    </div>
    <p class="sf-note">{T.note}</p>
  </div>
</SlideFrame>

<style>
  .ce { display: flex; flex-direction: column; height: 100%; }
  .ce-body { flex: 1; display: flex; flex-direction: column; margin: calc(14 * var(--u)) 0 calc(10 * var(--u)); min-height: 0; }
  .ce-evs { flex: 1; display: flex; flex-direction: column; gap: calc(8 * var(--u)); min-height: 0; }
  .ce-pill { align-self: flex-start; padding: calc(2 * var(--u)) calc(14 * var(--u)); border-radius: calc(999 * var(--u)); background: var(--sf-ink); color: #fff; font-size: calc(15 * var(--u)); font-weight: 800; white-space: nowrap; }
  .ce-cards { flex: 1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: calc(14 * var(--u)); min-height: 0; }
  .ce-ev { display: flex; flex-direction: column; padding: calc(10 * var(--u)) calc(18 * var(--u)); border: calc(2 * var(--u)) solid var(--sf-line); border-radius: calc(12 * var(--u)); background: #fff; }
  .ce-num { font-size: calc(46 * var(--u)); font-weight: 800; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .ce-num small { margin-left: calc(2 * var(--u)); font-size: calc(22 * var(--u)); font-weight: 800; color: var(--sf-ink-2); }
  .ce-text { margin-top: calc(2 * var(--u)); font-size: calc(17 * var(--u)); font-weight: 700; line-height: 1.4; }
  .ce-src { margin-top: auto; padding-top: calc(6 * var(--u)); font-size: calc(13 * var(--u)); color: var(--sf-ink-3); }
  .ce-down { display: grid; place-items: center; height: calc(26 * var(--u)); color: var(--sf-ink-3); }
  .ce-down svg { width: calc(24 * var(--u)); height: calc(24 * var(--u)); }
  .ce-imp {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: calc(16 * var(--u));
    padding: calc(10 * var(--u)) calc(22 * var(--u));
    border-radius: calc(12 * var(--u));
    background: var(--sf-soft);
  }
  .ce-pill-imp { grid-row: 1 / 3; }
  .ce-imp-text { font-size: calc(25 * var(--u)); font-weight: 800; line-height: 1.3; }
  .ce-imp-sub { font-size: calc(16 * var(--u)); font-weight: 700; color: var(--sf-ink-2); }

  /* 示唆の強調（つまみ: 強調） */
  :global([data-t-focus='implication']) .ce-imp { background: var(--t-accent); }
  :global([data-t-focus='implication']) .ce-imp-text { color: #fff; }
  :global([data-t-focus='implication']) .ce-imp-sub { color: rgba(255, 255, 255, 0.9); }
  :global([data-t-focus='implication']) .ce-pill-imp { background: #fff; color: var(--t-accent); }
  :global([data-t-focus='none']) .ce-imp-text { color: var(--sf-ink); }

  /* 出典の行（つまみ: 根拠の出典） */
  :global([data-t-source='hide']) .ce-src { display: none; }
</style>
