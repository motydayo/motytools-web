---
// 資料レイアウトの見本: 箱ひげ図型（3つの営業所の月間売上のばらつきを、横向きの箱とひげで比べる）
// 横の位置 = 値 ÷ 500 × 560。箱の両端は「小さい順に並べ、真ん中の値で前半・後半に分け、それぞれの真ん中」で計算する。
// つまみ: --t-accent（色）・data-t-dots（全員の点 on|off）・--t-boxh（箱の高さ）
import SlideFrame from '../SlideFrame.astro';
const { size = 'full', lang = 'ja' } = Astro.props;
const PFX = 'bx-';
const PAGE = 9;
const ATTRS = ['dots'];
// 担当者11人の月間売上（万円）。箱の両端（四分位）は「小さい順に並べ、真ん中の値で前半・後半に分け、それぞれの真ん中」で求める。
const GROUPS = [
  ['東京', [180, 205, 220, 235, 248, 260, 272, 285, 298, 315, 340]],
  ['大阪', [150, 170, 185, 200, 215, 232, 250, 262, 280, 296, 440]],
  ['名古屋', [205, 215, 222, 230, 236, 240, 246, 253, 260, 268, 275]],
];
const med = (a) => { const n = a.length, m = n >> 1; return n % 2 ? a[m] : (a[m - 1] + a[m]) / 2; };
function stats(v) {
  const a = [...v].sort((x, y) => x - y), n = a.length, h = n >> 1;
  const q1 = med(a.slice(0, h)), q3 = med(a.slice(n % 2 ? h + 1 : h)), md = med(a), iqr = q3 - q1;
  const fl = q1 - 1.5 * iqr, fh = q3 + 1.5 * iqr, inside = a.filter((x) => x >= fl && x <= fh);
  return { a, q1, md, q3, iqr, lo: Math.min(...inside), hi: Math.max(...inside), out: a.filter((x) => x < fl || x > fh), mean: a.reduce((s, x) => s + x, 0) / n };
}
const S = GROUPS.map(([name, v]) => ({ name, ...stats(v) }));
const best = S.reduce((m, s) => (s.md > m.md ? s : m));
const widest = S.reduce((m, s) => (s.iqr > m.iqr ? s : m));
const T = {
  name: '箱ひげ図型',
  kicker: '営業所別の、担当者ひとりあたりの月間売上（2025年9月・各11人）',
  title: `中央値は${best.name}が最高、ばらつきは${widest.name}が最大`,
  note: '※ 単位は万円。箱＝真ん中の半数の人が入る範囲、太い線＝中央値、ひげ＝箱の端から箱の幅の1.5倍以内の最小・最大、○＝それより外れた値。箱の両端は、小さい順に並べて真ん中の値で前半・後半に分け、それぞれの真ん中。',
};
const fmt = (n) => String(Math.round(n * 100) / 100);
function buildBody(p) {
  const c = (...n) => n.map((x) => p + x).join(' ');
  const W = 848, HH = 320, X0 = 140, X1 = 700, MAX = 500, AX = 278, PITCH = 78, CY0 = 74;
  const x = (v) => fmt(X0 + (v / MAX) * (X1 - X0));
  let s = `    <svg class="${c('svg')}" viewBox="0 0 ${W} ${HH}" role="img" aria-label="3つの営業所の月間売上の箱ひげ図">\n`;
  for (let k = 0; k <= 5; k++) {
    s += `      <line class="${c(k === 0 ? 'base' : 'grid')}" x1="${x(k * 100)}" x2="${x(k * 100)}" y1="40" y2="${AX}" />\n`;
    s += `      <text class="${c('tick')}" x="${x(k * 100)}" y="${AX + 24}" text-anchor="middle">${k * 100}</text>\n`;
  }
  s += `      <text class="${c('head')}" x="760" y="20" text-anchor="end">中央値</text>\n`;
  s += `      <text class="${c('head')}" x="${W}" y="20" text-anchor="end">箱の幅</text>\n`;
  S.forEach((g, i) => {
    const cy = CY0 + i * PITCH;
    s += `      <text class="${c('name')}" x="0" y="${cy + 6}">${g.name}</text>\n`;
    s += `      <g class="${c('plot')}" style="--cy: ${cy}px">\n`;
    s += `        <line class="${c('whisk')}" x1="${x(g.lo)}" x2="${x(g.hi)}" y1="${cy}" y2="${cy}" />\n`;
    s += `        <line class="${c('whisk')}" x1="${x(g.lo)}" x2="${x(g.lo)}" y1="${cy - 9}" y2="${cy + 9}" />\n`;
    s += `        <line class="${c('whisk')}" x1="${x(g.hi)}" x2="${x(g.hi)}" y1="${cy - 9}" y2="${cy + 9}" />\n`;
    s += `        <rect class="${c('box')}" x="${x(g.q1)}" y="${cy - 20}" width="${fmt(((g.q3 - g.q1) / MAX) * (X1 - X0))}" height="40" rx="3" />\n`;
    s += `        <line class="${c('med')}" x1="${x(g.md)}" x2="${x(g.md)}" y1="${cy - 20}" y2="${cy + 20}" />\n`;
    g.a.forEach((v, k) => {
      if (g.out.includes(v)) return;
      const jy = ((k * 7) % 5 - 2) * 4;
      s += `        <circle class="${c('dot')}" cx="${x(v)}" cy="${cy + jy}" r="3.5" />\n`;
    });
    g.out.forEach((v) => { s += `        <circle class="${c('out')}" cx="${x(v)}" cy="${cy}" r="6" />\n`; });
    s += `      </g>\n`;
    s += `      <text class="${c('mlabel')}" x="${x(g.md)}" y="${cy - 32}" text-anchor="middle">${fmt(g.md)}</text>\n`;
    s += `      <text class="${c('val', g.name === best.name ? 'hl' : 'x')}" x="760" y="${cy + 8}" text-anchor="end">${fmt(g.md)}</text>\n`;
    s += `      <text class="${c('val', g.name === widest.name ? 'hl' : 'x')}" x="${W}" y="${cy + 8}" text-anchor="end">${fmt(g.iqr)}</text>\n`;
  });
  s += `    </svg>`;
  return s;
}
// 英語版を作るときは T を言語ごとに用意する（今は日本語だけ）
const body = buildBody('bx-');
---

<SlideFrame size={size} label={T.name} page={PAGE} lang={lang}>
  <div class="bx" data-demo="boxplot">
    <p class="sf-kicker" data-sf-in style="--i: 0">{T.kicker}</p>
    <p class="sf-title" data-sf-in style="--i: 0">{T.title}</p>
    <div class="bx-body" data-sf-in style="--i: 2" set:html={body} />
    <p class="sf-note">{T.note}</p>
  </div>
</SlideFrame>

<style is:global>
  .bx { display: flex; flex-direction: column; height: 100%; }
  .bx-body { flex: 1; min-height: 0; margin: calc(18 * var(--u)) 0 calc(10 * var(--u)); }
  /* 横の位置は 値 ÷ 500 × 560。箱の両端は小さい順に並べた前半・後半の真ん中の値。座標は幅848×高さ320の中で数字で決めている */
  
  .bx-svg { display: block; width: 100%; height: 100%; overflow: visible; }
  .bx-grid { stroke: #e3e5ea; stroke-width: 1; }
  .bx-base { stroke: #8a8f9c; stroke-width: 1.5; }
  .bx-tick { font-size: 14px; fill: #8a8f9c; font-variant-numeric: tabular-nums; }
  .bx-head { font-size: 16px; font-weight: 700; fill: #5a6070; }
  .bx-name { font-size: 18px; font-weight: 700; fill: #1f2430; }
  .bx-whisk { stroke: #5a6070; stroke-width: 2; }
  .bx-box { fill: color-mix(in srgb, var(--t-accent) 24%, #fff); stroke: var(--t-accent); stroke-width: 2; }
  .bx-med { stroke: #1f2430; stroke-width: 4; }
  .bx-dot { display: none; fill: #5a6070; fill-opacity: 0.6; }
  .bx-out { fill: #fff; stroke: #1f2430; stroke-width: 2.5; }
  .bx-mlabel { font-size: 16px; font-weight: 800; fill: #1f2430; font-variant-numeric: tabular-nums; }
  .bx-val { font-size: 24px; font-weight: 800; fill: #1f2430; font-variant-numeric: tabular-nums; }
  .bx-val.bx-hl { fill: var(--t-accent); }
  /* 箱の太さ（つまみ）: 行の中心を軸に上下へ広げる */
  .bx-box, .bx-med { transform-box: fill-box; }
  .bx-plot .bx-box, .bx-plot .bx-med { transform-origin: center; transform: scaleY(calc(var(--t-boxh) / 40)); }
  
  /* 全員の点（data-dots="on" で、11人ぶんの売上を箱の上に重ねる） */
  [data-t-dots='on'] .bx-dot { display: inline; }
</style>
